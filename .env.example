# ---------------------------------------------------------------------------
# SwissHub Bot WebApp - Beispielkonfiguration
#
# Kopieren nach `.env` und ausfuellen. NIEMALS echte Secrets committen.
# Alle Werte werden beim Start mit Zod validiert (packages/config/src/env.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Datenbank -------------------------------------------------------------
# Passt zur mitgelieferten docker-compose.yml
DATABASE_URL=postgresql://swisshub:swisshub@localhost:5432/swisshub?schema=public

# --- Discord Application ---------------------------------------------------
# https://discord.com/developers/applications -> deine App
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot -> Reset Token. Der Token darf ausschliesslich hier stehen.
DISCORD_BOT_TOKEN=
# ID des SwissHub Discord-Servers (Entwicklermodus -> Server -> ID kopieren)
DISCORD_GUILD_ID=

# --- Optionale Bootstrap-IDs ----------------------------------------------
# Werden beim ersten Start in die Datenbank uebernommen und sind danach
# ueber die Einstellungen der WebApp aenderbar.
DISCORD_ADMIN_ROLE_ID=
DISCORD_JAIL_ROLE_ID=
# Discord User ID des Owners - erhaelt systemkritische Sonderrechte.
SWISSHUB_OWNER_DISCORD_ID=

# --- Sicherheit ------------------------------------------------------------
# Mindestens 32 Zeichen. Erzeugen z.B. mit: openssl rand -base64 48
AUTH_SECRET=

# Oeffentliche Basis-URL der WebApp (ohne abschliessenden Slash).
# In Production zwingend https:// - die OAuth Redirect URI wird daraus gebildet:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/discord
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hinter einem Reverse Proxy (nginx, Traefik, ...) auf true setzen, damit
# X-Forwarded-For fuer Rate Limiting/Audit ausgewertet wird.
TRUST_PROXY=false

# --- Betrieb ---------------------------------------------------------------
LOG_LEVEL=info

# Sessions
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_MINUTES=720

# Wie lange Discord-Rollen aus dem Cache verwendet werden duerfen (Sekunden)
ROLE_CACHE_TTL_SECONDS=300
# Maximales Alter der Rollendaten fuer sicherheitskritische Aktionen (Sekunden)
ROLE_CRITICAL_TTL_SECONDS=30

# Hintergrundjobs des Bots
JAIL_SWEEP_INTERVAL_SECONDS=30
RECONCILE_INTERVAL_MINUTES=15

# --- Entwicklung ------------------------------------------------------------
# Ersetzt saemtliche Discord-Aufrufe durch deterministische Mock-Daten.
# Wird in Production hart abgelehnt (Start bricht ab).
DEV_MOCK_DISCORD=false
