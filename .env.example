# ---------------------------------------------------------------------------
# SwissHub Bot WebApp - Beispielkonfiguration
#
# Kopieren nach `.env` und ausfüllen. NIEMALS echte Secrets committen.
# Alle Werte werden beim Start mit Zod validiert (packages/config/src/env.ts).
#
# In dieser Datei stehen ausschliesslich Bootstrap-Secrets und
# Betriebsparameter. Technische Zugangsdaten - Bot Token, OAuth, AI-Schlüssel,
# Bot-Tokens der Musik-Laufzeit - werden im Dashboard unter
# System -> Integrationen verwaltet und liegen verschlüsselt in der Datenbank.
# Was hier steht, gilt nur noch als Rückfall, solange dort nichts hinterlegt
# ist, und lässt sich von dort per Knopfdruck übernehmen.
#
# Siehe docs/INTEGRATIONS.md und docs/CONFIGURATION.md.
# ---------------------------------------------------------------------------

# NODE_ENV steht bewusst nicht in dieser Datei.
#
# `next build` setzt den Wert selbst auf `production`; stünde hier
# `development`, würde Next mit einem nicht-standardkonformen NODE_ENV bauen
# und beim Vorrendern der Fehlerseiten abbrechen. Ohne Eintrag gilt lokal der
# Standard `development` aus dem Schema, und Docker setzt `production`.

# --- Datenbank -------------------------------------------------------------
# Entwicklung (passt zur mitgelieferten docker-compose.yml):
DATABASE_URL=postgresql://swisshub:swisshub@localhost:5432/swisshub?schema=public
# Production mit docker-compose.prod.yml: der Host heisst dort "postgres", z.B.
# DATABASE_URL=postgresql://swisshub:DEIN_PASSWORT@postgres:5432/swisshub?schema=public

# Nur fuer docker-compose.prod.yml (legt den Datenbankcontainer damit an):
POSTGRES_USER=swisshub
POSTGRES_PASSWORD=
POSTGRES_DB=swisshub

# --- Hauptschlüssel der Zugangsdatenverwaltung -----------------------------
#
# Das EINE Geheimnis, das hier bleiben muss: mit ihm werden alle übrigen in der
# Datenbank ver- und entschlüsselt (AES-256-GCM). Er wird nie im Dashboard
# angezeigt, nie in der Datenbank abgelegt und nie protokolliert.
#
#   openssl rand -base64 32
#
# WICHTIG für Sicherungen: eine Datenbanksicherung allein nützt nichts. Ohne
# diesen Schlüssel sind die gespeicherten Zugangsdaten absichtlich nicht mehr
# lesbar. Beides zusammen sichern - und den Schlüssel getrennt aufbewahren.
#
# Wird er gewechselt, sind alle bestehenden Werte unlesbar und müssen neu
# hinterlegt werden. In Production ist er Pflicht; ohne ihn startet die
# Anwendung nicht.
MASTER_ENCRYPTION_KEY=

# --- Discord Application (Rückfall) ----------------------------------------
# https://discord.com/developers/applications -> deine App
#
# Diese drei werden im Dashboard unter System -> Integrationen -> Discord
# gepflegt. Für eine neue Installation genügt es, sie hier einzutragen und
# dort einmalig zu übernehmen; danach können sie aus dieser Datei entfernt
# werden.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# --- Sicherheit ------------------------------------------------------------
# Mindestens 32 Zeichen. Erzeugen z.B. mit: openssl rand -base64 48
AUTH_SECRET=

# Öffentliche Basis-URL der WebApp (ohne abschliessenden Slash).
# In Production zwingend https:// - die OAuth Redirect URI wird daraus gebildet:
#   <NEXT_PUBLIC_APP_URL>/api/auth/callback/discord
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notzugang: dieses Discord-Konto besitzt immer Vollzugriff, unabhängig von
# den Berechtigungen im Dashboard. Bewusst nur hier setzbar - so sperrt man
# sich nicht aus, und der Zugang lässt sich nicht über die WebApp vergeben.
SWISSHUB_OWNER_DISCORD_ID=

# Hinter einem Reverse Proxy (nginx, Traefik, ...) auf true setzen, damit
# X-Forwarded-For für Rate Limiting/Audit ausgewertet wird.
TRUST_PROXY=false

# Verzeichnis für hochgeladene Dateien (WebApp-Logo). Muss persistent sein -
# in Docker liegt hier ein Volume, siehe docker-compose.prod.yml.
SWISSHUB_UPLOAD_DIR=/var/lib/swisshub/uploads

# --- Betrieb ---------------------------------------------------------------
LOG_LEVEL=info
# json = strukturierte Logzeilen (empfohlen in Production), pretty = lesbar
LOG_FORMAT=json

# Sessions
SESSION_ABSOLUTE_TTL_HOURS=168
SESSION_IDLE_TTL_MINUTES=720

# Wie lange Discord-Rollen aus dem Cache verwendet werden dürfen (Sekunden)
ROLE_CACHE_TTL_SECONDS=300
# Maximales Alter der Rollendaten für sicherheitskritische Aktionen (Sekunden)
ROLE_CRITICAL_TTL_SECONDS=30

# Hintergrundjobs des Bots
JAIL_SWEEP_INTERVAL_SECONDS=30
RECONCILE_INTERVAL_MINUTES=15

# --- Entwicklung ------------------------------------------------------------
# Ersetzt sämtliche Discord-Aufrufe durch deterministische Mock-Daten.
# Wird in Production hart abgelehnt (Start bricht ab).
DEV_MOCK_DISCORD=false

# --- Abgelöst (optional, nur für bestehende Installationen) ----------------
# Diese Variablen werden beim ersten Start einmalig in die Datenbank
# übernommen und können danach entfernt werden. Neue Installationen brauchen
# sie nicht - der Server wird unter /setup verbunden.
# DISCORD_GUILD_ID=
# DISCORD_ADMIN_ROLE_ID=
# DISCORD_JAIL_ROLE_ID=

# --- SwissHub Premium (Zahlungsanbieter) -----------------------------------
# Discord-Rollen, Kategorie und Schonfrist werden NICHT hier gesetzt, sondern
# im Dashboard unter Module -> Premium. Hier stehen nur die Zugangsdaten des
# Zahlungsanbieters, die nicht in die Datenbank gehoeren.
#
# mock  = nur fuer die Entwicklung, in Production zurueckgewiesen
# stripe = Production (TWINT laeuft ueber Stripe, siehe README)
PAYMENT_PROVIDER=mock
# Geheimer API-Schluessel des Anbieters (Stripe: sk_live_... bzw. sk_test_...)
# ---------------------------------------------------------------------------
# AI (optional, Rueckfall)
#
# Anbieter, Schluessel, Modell, Adresse und Zeitlimit werden im Dashboard unter
# System -> Integrationen -> AI gepflegt. Diese beiden Variablen werden nur
# gelesen, solange dort nichts hinterlegt ist, und lassen sich von dort
# uebernehmen. Welche gilt, haengt am eingestellten Anbieter.
#
# Ohne Schluessel bleibt die AI-Pruefung aus; die Verifikation laeuft dann
# vollstaendig ueber die Moderation.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PAYMENT_API_KEY=
# Signaturgeheimnis des Webhooks (Stripe: whsec_...)
PAYMENT_WEBHOOK_SECRET=

# --- SwissHub Music (Rueckfall) -------------------------------------------
# Die Bot-Tokens der Voice-Laufzeit werden im Dashboard unter
# System -> Integrationen -> Discord-Bots gepflegt und liegen dort
# verschluesselt in der Datenbank. Was hier steht, gilt nur noch, solange dort
# kein Bot mit Token hinterlegt ist.
#
# WICHTIG: Jeder WORKER braucht eine EIGENE Discord-Anwendung. Ein Bot ist je
# Server immer nur in einem Sprachkanal - zwei Kanaele gleichzeitig brauchen
# zwei Anwendungen.
# Wird nicht mehr gebraucht: der Musik-Controller ist der Systembot und
# benutzt DISCORD_BOT_TOKEN. Diese Variable wird nur noch gelesen, falls
# DISCORD_BOT_TOKEN fehlt - eine bestehende Installation faellt dadurch nicht
# aus. Nach der Umstellung kann sie entfernt werden.
MUSIC_CONTROLLER_TOKEN=
# Kommagetrennt, beliebig viele. Leer lassen = nur der Controller spielt.
MUSIC_WORKER_TOKENS=
# Gemeinsamer Schluessel zwischen WebApp und Laufzeit fuer die interne Suche.
# Beliebige lange Zufallszeichenkette, z.B. `openssl rand -hex 32`.
# Sonderzeichen und Umlaute sind erlaubt: uebertragen wird nur der SHA-256
# des Schluessels, nie er selbst.
MUSIC_RUNTIME_KEY=
# Adresse der Laufzeit im Docker-Netz. Nach aussen ist sie nicht offen.
MUSIC_RUNTIME_URL=http://music-runtime:7700

