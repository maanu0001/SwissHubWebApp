# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Environment - NIEMALS echte Secrets committen
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
# Nur das Laufzeitverzeichnis im Projektstamm. Ohne den fuehrenden Schraegstrich
# traf die Regel jedes Verzeichnis namens "logs" - auch Quelltext wie
# packages/modules/src/logs, der dadurch stillschweigend nicht committet wurde.
/logs/

# Tests
coverage/
.vitest/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Prisma
packages/database/prisma/*.db
packages/database/prisma/*.db-journal

# Docker volumes
.docker-data/

# Python-Bytecode. Er entsteht bei jedem Lauf neu und gehoert nicht in
# das Repository - eine Aenderung daran ist keine Aenderung am Programm.
__pycache__/
*.pyc
