{
  "name": "swisshub-bot-webapp",
  "private": true,
  "version": "1.0.0",
  "description": "SwissHub Discord Bot WebApp - Administrations- und Moderationsoberflaeche",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @swisshub/web",
    "dev:bot": "npm run dev --workspace @swisshub/bot",
    "build": "npm run db:generate && npm run build --workspace @swisshub/web && npm run build --workspace @swisshub/bot",
    "start": "npm run start --workspace @swisshub/web",
    "start:bot": "npm run start --workspace @swisshub/bot",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "npm run db:generate && tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate --workspace @swisshub/database",
    "db:migrate": "npm run migrate --workspace @swisshub/database",
    "db:deploy": "npm run deploy --workspace @swisshub/database",
    "db:studio": "npm run studio --workspace @swisshub/database",
    "db:seed": "npm run seed --workspace @swisshub/database",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
