// SwissHub Bot WebApp - Datenbankschema
//
// Grundsätze:
//  * Die Datenbank ist Source of Truth für alles, was einen Neustart von Bot
//    oder WebApp überleben muss (Jails, Audit Logs, Einstellungen).
//  * Datensparsamkeit: Discord-Mitgliederdaten werden nur zwischengespeichert,
//    wo sie für Sicherheitsentscheide oder Nachvollziehbarkeit nötig sind.
//  * Alle Zeitstempel werden in UTC gespeichert und erst im UI in Europe/Zurich
//    dargestellt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Grobe Anwendungsgruppe. Sie ist bewusst NICHT die Quelle der Wahrheit für
/// Berechtigungen - massgebend sind Discord-Rollen + Permission Engine.
enum AppRole {
  USER
  TEAM
  MODERATOR
  ADMIN
  OWNER
}

/// Zustand einer Aktion, die Discord und Datenbank umfasst.
enum ActionStatus {
  PENDING
  EXECUTING
  COMPLETED
  PARTIAL
  FAILED
}

/// Zeitlich begrenzt oder unbefristet. Unbefristete Jails haben kein `endsAt`
/// und werden vom automatischen Release-Worker bewusst nicht angefasst.
enum JailType {
  TEMPORARY
  PERMANENT
}

enum VoteJailStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Woher ein Jail stammt. Dashboard und Slash Command nutzen denselben
/// Service - die Quelle ist reine Herkunftsinformation, kein zweiter Weg.
enum JailSource {
  DASHBOARD
  SLASH_COMMAND
  VOTE_JAIL
  IMPORT
  AUTO_RESTORE
}

/// Fachlicher Zustand eines Jails.
///
/// Bewusst getrennt von `ActionStatus`: dort steht, ob die *Discord-Aktion*
/// durchgelaufen ist, hier steht, in welchem Zustand die *Strafe* ist.
/// PENDING_REJOIN bedeutet: Mitglied hat den Server verlassen, die Strafe
/// laeuft weiter und wird beim erneuten Beitritt wieder angewendet.
enum JailLifecycle {
  PENDING
  ACTIVE
  RELEASED
  EXPIRED
  RESTORE_FAILED
  PENDING_REJOIN
  FAILED
}

enum JailImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Entscheidung des Import-Assistenten pro Legacy-Zeile.
enum JailImportRowAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_RELEASED
  SKIP_INVALID
  CONFLICT
}

/// Zustand einer Spielersuche.
enum SpielersucheStatus {
  OPEN
  COMPLETE
  CLOSED
  EXPIRED
}

/// Woher eine Suche stammt. Dashboard und Slash Command durchlaufen denselben
/// Service - die Quelle ist reine Herkunftsinformation.
enum SpielersucheSource {
  DASHBOARD
  SLASH_COMMAND
  LEGACY_IMPORT
}

enum SpielersucheImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Datenart einer Zeile aus der alten Spielersuche-Datenbank.
enum SpielersucheImportKind {
  SETTINGS
  GAME
  MATCH
  PARTICIPANT
  USAGE
  VOICE_SESSION
  ROLE_PING
}

enum SpielersucheImportAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_INVALID
  SKIP_OTHER_GUILD
  CONFLICT
}

enum CommunicationType {
  NEWS
  EVENT
  POLL
}

/// Wo eine Kommunikation entstanden ist.
enum CommunicationSource {
  WEBAPP
  /// Slash Command `/post` - der Nachfolger des alten Kommunikationsbots.
  SLASH_COMMAND
}

enum CommunicationStatus {
  /// Vorbereitet, noch nicht gesendet.
  DRAFT
  SENT
  /// Discord hat den Versand abgelehnt oder nicht geantwortet.
  FAILED
  /// Auf Discord geloescht - der Eintrag bleibt fuer die Nachvollziehbarkeit.
  DELETED
}

/// Wie man sich zu einem Event anmeldet (frueher das Freitextfeld "Ahmaeldig via").
enum CommunicationRegistrationType {
  NONE
  TEXT
  /// Der in den Einstellungen hinterlegte Ticket-Channel.
  TICKET
  /// Ein frei gewaehlter Discord-Channel.
  CHANNEL
  URL
}

/// Wen eine Nachricht erwaehnt.
enum CommunicationMentionType {
  NONE
  EVERYONE
  HERE
  ROLE
  USER
}

enum JailReleaseType {
  AUTOMATIC
  MANUAL
  RECONCILED
}

enum ModerationActionType {
  JAIL_CREATE
  JAIL_RELEASE
  JAIL_EXTEND
  /// Discord-eigene Massnahmen, ausgeloest ueber das Moderation Center.
  BAN
  UNBAN
  KICK
  TIMEOUT
  /// Ein laufender Timeout wurde verlaengert oder verkuerzt.
  ///
  /// Entsteht nur bei direkt auf Discord gesetzten Timeouts: das Moderation
  /// Center kennt nur Setzen und Aufheben, Discord dagegen laesst die Frist
  /// eines laufenden Timeouts aendern. Ohne eigenen Typ waere aus «30 Minuten
  /// auf 24 Stunden» ein zweiter Timeout geworden.
  TIMEOUT_UPDATE
  TIMEOUT_REMOVE
  /// Interne Notiz zu einem Mitglied - keine Massnahme, aber Teil der Akte.
  NOTE
}

/// Wo eine Massnahme ausgeloest wurde.
///
/// `DISCORD` heisst: sie geschah ausserhalb von SwissHub - jemand hat direkt
/// in Discord gehandelt - und wurde hier nachtraeglich erkannt. Der
/// Unterschied zaehlt beim Lesen der Akte: bei `WEBAPP` ist der Grund eine
/// Pflichtangabe, bei `DISCORD` steht dort, was Discord hergab, und manchmal
/// nichts.
enum ModerationSource {
  WEBAPP
  BOT
  DISCORD
  SYSTEM
}

/// Was der Handelnde ist.
///
/// Nicht jede Massnahme kommt von einem Menschen: auch andere Bots auf dem
/// Server bannen und kicken. `UNKNOWN` ist kein Platzhalter, sondern eine
/// Aussage - Discord hat den Handelnden nicht preisgegeben.
enum ModerationActorType {
  HUMAN
  BOT
  SYSTEM
  UNKNOWN
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReconciliationMode {
  AUTOMATIC
  MANUAL
}

/// Anwendungskonto, das an eine Discord-Identität gebunden ist.
model User {
  id           String   @id @default(cuid())
  discordId    String   @unique
  username     String
  globalName   String?
  avatarHash   String?
  appRole      AppRole  @default(USER)
  /// Anwendungsseitige Sperre (unabhängig von Discord).
  isBlocked    Boolean  @default(false)
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  identityCache        DiscordIdentityCache?
  /// Premium-Abonnements. Bewusst am bestehenden Benutzer statt an einem
  /// zweiten Konto - Premium ist ein Modul, kein eigenes Produkt.
  premiumSubscriptions PremiumSubscription[]

  @@index([username])
}

/// Serverseitige Session. Im Browser liegt ausschliesslich ein zufälliges
/// Token; gespeichert wird nur dessen SHA-256 Hash.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  rotatedAt     DateTime  @default(now())
  /// Absolutes Ablaufdatum - unabhängig von Aktivität.
  expiresAt     DateTime
  /// Ablauf bei Inaktivität; wird bei jedem Request verlängert.
  idleExpiresAt DateTime
  revokedAt     DateTime?
  revokedReason String?
  ipHash        String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

/// Zwischenspeicher für Guild-Mitgliedschaft und Discord-Rollen.
/// Wird nach Ablauf der TTL und vor sicherheitskritischen Aktionen erneuert.
model DiscordIdentityCache {
  discordId     String    @id
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMember      Boolean   @default(false)
  roleIds       String[]  @default([])
  nickname      String?
  joinedGuildAt DateTime?
  fetchedAt     DateTime  @default(now())

  @@index([fetchedAt])
}

/// Discord-Rolle, die von SwissHub verwaltet/bewertet wird.
model ManagedRole {
  id              String   @id @default(cuid())
  discordRoleId   String   @unique
  label           String
  /// Geschützte Rollen können nicht moderiert werden.
  isProtected     Boolean  @default(false)
  /// Rollen, die beim Jail erhalten bleiben (z.B. Booster).
  keepOnJail      Boolean  @default(false)
  /// Interne Moderationsstufe für die Hierarchieprüfung (höher = stärker).
  moderationLevel Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permissions RolePermission[]
}

/// Zuordnung Discord-Rolle -> Permission der Permission Engine.
model RolePermission {
  id            String      @id @default(cuid())
  discordRoleId String
  permission    String
  createdAt     DateTime    @default(now())
  createdBy     String?
  role          ManagedRole @relation(fields: [discordRoleId], references: [discordRoleId], onDelete: Cascade)

  @@unique([discordRoleId, permission])
  @@index([permission])
}

/// Generischer, typisiert gelesener Konfigurationsspeicher.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Konfiguration des SwissHub Discord-Servers.
/// Nach dem Setup ist dies - nicht mehr die .env - die Quelle der Wahrheit.
model GuildConfig {
  id               String    @id @default("singleton")
  guildId          String    @unique
  name             String?
  iconHash         String?
  ownerId          String?
  memberCount      Int?
  presenceCount    Int?
  /// Zeitpunkt der letzten erfolgreichen Discord-Synchronisation.
  lastSyncedAt     DateTime?
  /// Gesetzt, sobald der Setup-Assistent abgeschlossen wurde.
  setupCompletedAt DateTime?
  setupCompletedBy String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Zwischenspeicher der Discord-Rollen (fuer Auswahllisten, Hierarchie und
/// Anzeige bei Discord-Ausfall). Wird vom Sync-Service gepflegt.
model DiscordRoleCache {
  roleId      String    @id
  name        String
  color       Int       @default(0)
  position    Int       @default(0)
  managed     Boolean   @default(false)
  hoist       Boolean   @default(false)
  /// Discord Permission Bits als String (BigInt-sicher).
  permissions String    @default("0")
  syncedAt    DateTime  @default(now())
  /// Gesetzt, wenn die Rolle auf Discord nicht mehr existiert.
  deletedAt   DateTime?

  @@index([position])
  @@index([deletedAt])
}

/// Zwischenspeicher der Discord-Channels.
model DiscordChannelCache {
  channelId String    @id
  name      String
  /// Discord Channel Type (0 = Text, 2 = Voice, 4 = Kategorie, 15 = Forum, ...).
  type      Int
  parentId  String?
  position  Int       @default(0)
  nsfw      Boolean   @default(false)
  syncedAt  DateTime  @default(now())
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
}

/// Zaehler, der bei jeder Konfigurationsaenderung erhoeht wird.
/// Bot und WebApp erkennen daran, dass ihre Caches veraltet sind - dadurch
/// wirken Aenderungen ohne Neustart.
model ConfigRevision {
  id        String   @id @default("singleton")
  revision  BigInt   @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
  reason    String?
}

/// Protokoll der Discord-Synchronisationen.
model SyncRun {
  id              String    @id @default(cuid())
  trigger         String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  roles           Int       @default(0)
  channels        Int       @default(0)
  removedRoles    Int       @default(0)
  removedChannels Int       @default(0)
  success         Boolean   @default(true)
  error           String?
  triggeredBy     String?

  @@index([startedAt])
}

/// Aktivierungszustand und Einstellungen eines Moduls.
model ModuleState {
  moduleId      String   @id
  enabled       Boolean  @default(true)
  settings      Json     @default("{}")
  /// Schema-Version der gespeicherten Einstellungen (fuer Migrationen).
  configVersion Int      @default(1)
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Jail-Vorgang. Die Datenbank ist Source of Truth - der Bot leitet daraus
/// automatische Freilassungen und Reconciliation ab.
model JailEntry {
  id                  String           @id @default(cuid())
  targetDiscordId     String
  targetUsername      String
  targetDisplayName   String?
  /// Avatar-Hashes zum Zeitpunkt der Aktion - halten die Historie lesbar,
  /// auch wenn ein Mitglied den Server spaeter verlaesst.
  targetAvatarHash    String?
  moderatorAvatarHash String?
  moderatorDiscordId  String
  moderatorUsername   String
  reason              String
  /// Art des Jails. Bestehende Einträge wurden bei der Migration als
  /// TEMPORARY übernommen.
  type                JailType         @default(TEMPORARY)
  /// Geplante Dauer. NULL bei einem permanenten Jail.
  durationSeconds     Int?
  startedAt           DateTime         @default(now())
  /// Geplantes Ende. NULL bei einem permanenten Jail - bewusst kein
  /// künstliches Datum wie 31.12.9999, damit Abfragen ehrlich bleiben.
  endsAt              DateTime?
  releasedAt          DateTime?
  releaseType         JailReleaseType?
  releasedByDiscordId String?
  releasedByUsername  String?
  /// Rollen vor dem Jail als flache ID-Liste.
  ///
  /// Bleibt als schneller Lesepfad erhalten (Rollen setzen braucht nur IDs);
  /// die sprechende Fassung mit Name und Position steht in `roleSnapshotEntries`.
  roleSnapshot        String[]         @default([])
  /// Rollen, die während des Jails erhalten blieben.
  keptRoleIds         String[]         @default([])
  /// Beim Release erfolgreich wiederhergestellte Rollen.
  restoredRoleIds     String[]         @default([])
  /// Rollen, die nicht wiederhergestellt werden konnten (gelöscht, zu hoch, ...).
  failedRoleIds       String[]         @default([])
  status              ActionStatus     @default(PENDING)
  releaseStatus       ActionStatus?
  errorCode           String?
  errorMessage        String?
  /// Gesetzt solange der Jail aktiv ist (= targetDiscordId). NULL nach dem
  /// Release. Der Unique-Index verhindert dadurch zwei gleichzeitig aktive
  /// Jails für dasselbe Mitglied (Race Condition Schutz).
  activeKey           String?          @unique
  /// Verhindert doppelte Ausführung bei Doppelklick/Retry.
  idempotencyKey      String?          @unique
  /// Herkunft des Jails - Dashboard, Slash Command, Abstimmung oder Import.
  source              JailSource       @default(DASHBOARD)
  /// Fachlicher Zustand (siehe `JailLifecycle`).
  lifecycle           JailLifecycle    @default(PENDING)
  /// Stille Strafe: keine öffentliche Ankündigung, kein Ping.
  silent              Boolean          @default(false)
  /// Mitglied wurde beim Jail aus dem Sprachkanal getrennt.
  voiceDisconnected   Boolean          @default(false)
  /// Zeitpunkt, an dem das Mitglied den Server während des Jails verlassen hat.
  leftGuildAt         DateTime?
  /// Anzahl erneuter Anwendungen nach einem Rejoin.
  reappliedCount      Int              @default(0)
  /// Legacy-Schlüssel aus dem alten Bot (`userId:startEpoch`) - macht den
  /// Import wiederholbar, ohne Duplikate anzulegen.
  legacyKey           String?          @unique
  importId            String?
  import              JailImport?      @relation(fields: [importId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  /// Vote Jail, aus dem dieser Jail entstanden ist (falls zutreffend).
  voteJail            VoteJail?
  /// Rollen-Snapshot mit Name und Position zum Zeitpunkt des Jails.
  roleSnapshotEntries JailRoleSnapshot[]

  @@index([targetDiscordId, startedAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
  @@index([moderatorDiscordId])
  @@index([lifecycle])
  @@index([source])
  @@index([importId])
}

/// Eine Rolle im Rollen-Snapshot eines Jails.
///
/// Der alte Bot speicherte die Rollen als kommaseparierten Text. Hier steht
/// jede Rolle als eigene Zeile - inklusive Name und Position zum Zeitpunkt des
/// Jails. Dadurch bleibt die Historie auch dann lesbar, wenn eine Rolle
/// zwischenzeitlich umbenannt oder gelöscht wurde.
model JailRoleSnapshot {
  id                 String    @id @default(cuid())
  jailId             String
  jail               JailEntry @relation(fields: [jailId], references: [id], onDelete: Cascade)
  roleId             String
  /// Name zum Zeitpunkt des Jails. NULL, wenn die Rolle damals nicht
  /// aufgelöst werden konnte (z.B. beim Import einer Altdatenbank).
  roleNameAtTime     String?
  rolePositionAtTime Int?
  /// Von Discord verwaltete Rolle (Booster, Integration).
  managedAtTime      Boolean   @default(false)
  /// Rolle blieb während des Jails bewusst erhalten.
  kept               Boolean   @default(false)
  /// Beim Release erfolgreich zurückgegeben.
  restoredAt         DateTime?
  /// Grund, weshalb die Rolle nicht zurückgegeben werden konnte.
  restoreFailedCode  String?
  createdAt          DateTime  @default(now())

  @@unique([jailId, roleId])
  @@index([jailId])
  @@index([roleId])
}

/// Sperrfrist für Initiatoren einer erfolgreichen Abstimmung.
///
/// Eigene Tabelle statt eines Feldes am Mitglied: die Sperre überlebt einen
/// Neustart und lässt sich unabhängig von Discord-Daten aufräumen.
model VoteJailCooldown {
  id             String   @id @default(cuid())
  discordId      String   @unique
  username       String?
  lastVoteJailId String?
  startedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Ein Durchlauf des Legacy-Imports.
///
/// Die hochgeladene SQLite-Datei wird ausschliesslich gelesen und nach der
/// Analyse gelöscht; hier bleibt nur das Ergebnis stehen.
model JailImport {
  id                   String           @id @default(cuid())
  /// Ursprünglicher Dateiname - nur zur Anzeige, nie als Pfad verwendet.
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               JailImportStatus @default(ANALYSED)
  /// Gefundene Tabellen und Spalten der Legacy-Datei.
  schemaInfo           Json?
  totalRows            Int              @default(0)
  importableRows       Int              @default(0)
  duplicateRows        Int              @default(0)
  releasedRows         Int              @default(0)
  invalidRows          Int              @default(0)
  conflictRows         Int              @default(0)
  importedRows         Int              @default(0)
  failedRows           Int              @default(0)
  /// Bestätigung, dass der alte Bot gestoppt wurde.
  legacyBotStopped     Boolean          @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  finishedAt           DateTime?
  rows                 JailImportRow[]
  jails                JailEntry[]

  @@index([status, createdAt])
}

/// Eine Zeile der Legacy-Datenbank mit der Entscheidung des Assistenten.
model JailImportRow {
  id                 String              @id @default(cuid())
  importId           String
  import             JailImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Stabiler Schlüssel aus der Legacy-Zeile (`userId:startEpoch`).
  legacyKey          String
  targetDiscordId    String
  roleIds            String[]            @default([])
  moderatorDiscordId String?
  reason             String?
  startedAt          DateTime?
  endsAt             DateTime?
  permanent          Boolean             @default(false)
  /// Optionales Geschlechterfeld des alten Bots (nur für die Anrede).
  gender             String?
  legacyStatus       String?
  action             JailImportRowAction
  /// Erklärung für die Auswahl - erscheint in der Vorschau.
  note               String?
  jailId             String?
  imported           Boolean             @default(false)
  createdAt          DateTime            @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, action])
}

/// Community-Abstimmung, die bei Erfolg einen regulären Jail auslöst.
/// Die eigentliche Jail-Ausführung übernimmt der bestehende Jail-Service -
/// hier wird ausschliesslich die Abstimmung verwaltet.
model VoteJail {
  id                   String         @id @default(cuid())
  targetDiscordId      String
  targetUsername       String
  targetDisplayName    String?
  targetAvatarHash     String?
  startedByDiscordId   String
  startedByUsername    String
  startedByAvatarHash  String?
  reason               String?
  status               VoteJailStatus @default(ACTIVE)
  requiredVotes        Int
  /// Zwischenstand, damit Listen ohne Aggregat auskommen. Wird ausschliesslich
  /// innerhalb der Vote-Transaktion fortgeschrieben.
  voteCount            Int            @default(0)
  /// Jail-Dauer in Minuten bei erfolgreicher Abstimmung.
  resultingJailMinutes Int
  discordChannelId     String?
  discordMessageId     String?
  /// Verhindert, dass zwei gleichzeitige Klicks zwei Jails auslösen.
  resultingJailId      String?        @unique
  resultingJail        JailEntry?     @relation(fields: [resultingJailId], references: [id])
  /// Gesetzt solange die Abstimmung läuft (= targetDiscordId). Der
  /// Unique-Index verhindert zwei gleichzeitige Abstimmungen gegen dieselbe
  /// Person.
  activeKey            String?        @unique
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  finishedAt           DateTime?
  votes                VoteJailVote[]

  @@index([status, expiresAt])
  @@index([targetDiscordId, createdAt])
}

/// Einzelne Stimme. Normale Mitglieder haben genau einen Eintrag
/// (Unique-Index), Berechtigte mit `jail.vote.multivote` mehrere - deshalb
/// zählt `voteNumber` mit.
model VoteJailVote {
  id             String   @id @default(cuid())
  voteJailId     String
  voteJail       VoteJail @relation(fields: [voteJailId], references: [id], onDelete: Cascade)
  voterDiscordId String
  voterUsername  String?
  /// Laufende Nummer der Stimme dieses Mitglieds in dieser Abstimmung.
  voteNumber     Int      @default(1)
  isAdminVote    Boolean  @default(false)
  createdAt      DateTime @default(now())

  /// Eine Stimme pro Mitglied und Nummer: normale Mitglieder kommen nie über
  /// Nummer 1 hinaus, Mehrfachstimmen erhalten aufsteigende Nummern.
  @@unique([voteJailId, voterDiscordId, voteNumber])
  @@index([voteJailId])
}

/// Über die WebApp im Namen des Bots gesendete Discord-Nachrichten.
model CommunicationMessage {
  id                 String              @id @default(cuid())
  type               CommunicationType
  status             CommunicationStatus @default(SENT)
  source             CommunicationSource @default(WEBAPP)
  title              String
  content            String
  bannerUrl          String?
  discordChannelId   String
  discordChannelName String?
  discordMessageId   String?
  sentByDiscordId    String
  sentByUsername     String
  sentByAvatarHash   String?
  sentAt             DateTime            @default(now())
  /// Auf Discord gelöscht - der Verlaufseintrag bleibt für die Nachvollziehbarkeit.
  deletedAt          DateTime?
  deletedByDiscordId String?
  editedAt           DateTime?
  editedByDiscordId  String?

  /// Fehlerklasse eines gescheiterten Versands - ohne Zugangsdaten.
  failureCode    String?
  failureMessage String?

  mentionType   CommunicationMentionType @default(NONE)
  /// Rollen- oder Benutzer-ID der Erwaehnung.
  mentionTarget String?

  /// --- Nur bei EVENT ---
  eventLocation      String?
  /// Zeitpunkt des Events. Der Slash Command laesst auch freien Text zu,
  /// dann bleibt dieses Feld leer und `eventDateText` traegt die Angabe.
  eventStartsAt      DateTime?
  eventDateText      String?
  eventResponsibleId String?
  registrationType   CommunicationRegistrationType @default(NONE)
  /// Freitext, Channel-ID oder Adresse - je nach `registrationType`.
  registrationValue  String?

  /// Typspezifische Zusatzdaten, die kein eigenes Feld brauchen.
  metadata       Json    @default("{}")
  /// Verhindert doppeltes Senden bei Doppelklick oder Retry.
  idempotencyKey String? @unique
  /// Verbindet Browser-Anfrage, Server Action, Discord-Aufruf und Audit-Eintrag.
  correlationId  String?

  @@index([sentAt])
  @@index([type, sentAt])
  @@index([status, sentAt])
  @@index([discordChannelId])
  @@index([sentByDiscordId])
}

/// Ein vorbereiteter Beitrag, der noch nicht gesendet wurde.
///
/// Bewusst getrennt von `CommunicationMessage`: ein Entwurf hat weder Channel-
/// noch Discord-Nachricht und wird beliebig oft ueberschrieben, waehrend ein
/// gesendeter Eintrag unveraenderlich protokolliert, was tatsaechlich rausging.
model CommunicationDraft {
  id      String            @id @default(cuid())
  type    CommunicationType
  title   String
  content String

  bannerUrl        String?
  discordChannelId String?

  mentionType   CommunicationMentionType @default(NONE)
  mentionTarget String?

  eventLocation      String?
  eventStartsAt      DateTime?
  eventResponsibleId String?
  registrationType   CommunicationRegistrationType @default(NONE)
  registrationValue  String?

  createdByDiscordId String
  createdByUsername  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdByDiscordId, updatedAt])
  @@index([updatedAt])
}

/// Modulunabhängige Moderationshistorie (Basis für Statistiken).
model ModerationAction {
  id                     String               @id @default(cuid())
  type                   ModerationActionType
  module                 String
  actorDiscordId         String
  actorUsername          String
  targetDiscordId        String
  targetUsername         String
  reason                 String?
  status                 ActionStatus         @default(COMPLETED)
  referenceId            String?
  /// Geplantes Ende einer befristeten Massnahme (heute: Discord-Timeout).
  ///
  /// Eigene Spalte statt eines Werts im Metadaten-JSON, weil danach gefiltert
  /// wird: «welche Timeouts laufen gerade» ist eine Abfrage, keine Auswertung
  /// im Anwendungscode. NULL bei allem, was kein geplantes Ende hat.
  expiresAt              DateTime?
  /// Wo die Massnahme ausgeloest wurde.
  ///
  /// Vorgabe `WEBAPP`, weil bis zur Einfuehrung dieses Feldes jede Zeile hier
  /// ueber das Dashboard entstanden ist. Die Migration setzt die Zeilen der
  /// Zeitsteuerung ausdruecklich auf `SYSTEM` - raten muss hier niemand.
  source                 ModerationSource     @default(WEBAPP)
  /// Mensch, Bot oder Zeitsteuerung.
  actorType              ModerationActorType  @default(HUMAN)
  /// Der Discord-Audit-Eintrag, aus dem diese Zeile entstanden ist.
  ///
  /// Eindeutig, und das ist der ganze Zweck: derselbe Audit-Eintrag darf nie
  /// zwei Massnahmen erzeugen - auch nicht nach einem Neustart des Bots, auch
  /// nicht, wenn Gateway-Ereignis und Abgleichlauf gleichzeitig darauf
  /// stossen. Die Datenbank entscheidet das, nicht der Anwendungscode.
  ///
  /// Auch an einer ueber das Dashboard ausgeloesten Massnahme kann er stehen:
  /// dann belegt er, dass Discord sie tatsaechlich vollzogen hat.
  discordAuditLogEntryId String?              @unique
  /// Wann SwissHub die Massnahme bemerkt hat - nur bei extern erkannten.
  ///
  /// `createdAt` ist der Zeitpunkt der Zeile, `detectedAt` der des Erkennens.
  /// Bei einer verspaetet erkannten Massnahme liegen sie auseinander, und die
  /// Akte soll das nicht verwischen.
  detectedAt             DateTime?
  metadata               Json                 @default("{}")
  createdAt              DateTime             @default(now())

  @@index([targetDiscordId, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([createdAt])
  /// Fuer die Abfrage der laufenden Massnahmen.
  @@index([type, expiresAt])
  /// Fuer den Quellenfilter im Verlauf.
  @@index([source, createdAt])
}

/// Manipulationsgeschütztes Audit Log (Hash-Chain).
model AuditLog {
  id              String   @id @default(cuid())
  sequence        BigInt   @unique @default(autoincrement())
  createdAt       DateTime @default(now())
  action          String
  module          String?
  actorDiscordId  String?
  actorUsername   String?
  targetDiscordId String?
  targetLabel     String?
  success         Boolean  @default(true)
  errorCode       String?
  errorMessage    String?
  metadata        Json     @default("{}")
  ipHash          String?
  userAgent       String?
  /// Hash des vorherigen Eintrags - erlaubt das Erkennen von Manipulationen.
  previousHash    String?
  hash            String

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([targetDiscordId, createdAt])
  @@index([success, createdAt])
}

/// Sicherheitsrelevante Ereignisse (fehlende Berechtigungen, CSRF, ...).
model SecurityEvent {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  type      String
  severity  SecuritySeverity @default(LOW)
  discordId String?
  ipHash    String?
  userAgent String?
  path      String?
  metadata  Json             @default("{}")

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([discordId, createdAt])
}

/// Serverseitiges Rate Limiting (Fixed Window).
model RateLimitCounter {
  bucket      String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

/// Idempotenzschlüssel für kritische Aktionen.
model IdempotencyRecord {
  key            String       @id
  scope          String
  actorDiscordId String
  status         ActionStatus @default(PENDING)
  resultRef      String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([scope, actorDiscordId])
}

/// Laufzeitstatus des Discord-Bots (vom Bot geschrieben, von der WebApp gelesen).
model BotStatus {
  id                String    @id @default("singleton")
  online            Boolean   @default(false)
  wsPingMs          Int?
  guildMemberCount  Int?
  botUserId         String?
  botUsername       String?
  version           String?
  lastHeartbeatAt   DateTime  @default(now())
  lastConnectedAt   DateTime?
  lastError         String?
  /// Kann der Bot Discords Audit Log lesen?
  ///
  /// `null` heisst «noch nicht geprueft», nicht «nein». Ohne dieses Recht
  /// bleiben direkt auf Discord ausgefuehrte Massnahmen unerkannt - der Bot
  /// laeuft weiter, aber die Akte ist dann unvollstaendig, und das soll man
  /// sehen koennen, statt es zu merken, wenn ein Eintrag fehlt.
  auditLogAccess    Boolean?
  auditLogCheckedAt DateTime?
  /// Bis wohin der Abgleichlauf Discords Audit Log gelesen hat.
  ///
  /// Audit-Kennungen sind Snowflakes und damit aufsteigend; hier steht die
  /// zuletzt verarbeitete. Der naechste Lauf macht dort weiter, statt jedes
  /// Mal von vorn zu lesen - kein Vollscan, kein Dauerpolling.
  lastAuditEntryId  String?
  updatedAt         DateTime  @updatedAt
}

/// Abgleich zwischen Datenbank- und Discord-Zustand.
model ReconciliationRun {
  id          String             @id @default(cuid())
  module      String
  mode        ReconciliationMode @default(AUTOMATIC)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  checked     Int                @default(0)
  drift       Int                @default(0)
  repaired    Int                @default(0)
  failed      Int                @default(0)
  triggeredBy String?
  details     Json               @default("{}")

  @@index([module, startedAt])
}

/// Ein im Dashboard gepflegtes Spiel.
///
/// Der alte Bot kannte Spiele nur pro Guild; diese Anwendung ist auf genau
/// einen Server konfiguriert, deshalb genuegt der Name als Schluessel.
model SpielersucheGame {
  id                 String                @id @default(cuid())
  name               String
  /// Kleingeschriebener Name - macht die Eindeutigkeit unabhaengig von
  /// Gross-/Kleinschreibung (der alte Bot nutzte dafuer COLLATE NOCASE).
  nameKey            String                @unique
  /// Rolle, die beim Start einer Suche erwaehnt wird.
  roleId             String
  bannerUrl          String?
  /// Maximale Gruppengroesse. NULL = unbegrenzt.
  maxSquadSize       Int?
  enabled            Boolean               @default(true)
  sortOrder          Int                   @default(0)
  /// `games.id` aus der Altdatenbank - macht den Import wiederholbar.
  legacyId           Int?                  @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdByDiscordId String?
  matches            SpielersucheMatch[]
  rolePing           SpielersucheRolePing?

  /// Turniere, die dieses Spiel verwenden.
  tournaments Tournament[]

  @@index([enabled, name])
}

/// Eine Spielersuche.
model SpielersucheMatch {
  id                 String                     @id @default(cuid())
  creatorDiscordId   String
  creatorUsername    String
  creatorDisplayName String?
  creatorAvatarHash  String?
  gameId             String?
  game               SpielersucheGame?          @relation(fields: [gameId], references: [id])
  /// Name zum Zeitpunkt der Suche - bleibt lesbar, auch wenn das Spiel
  /// spaeter umbenannt oder geloescht wird.
  gameName           String
  pingRoleId         String?
  /// Wurde die Spielrolle bei dieser Suche tatsaechlich erwaehnt?
  rolePinged         Boolean                    @default(false)
  bannerUrl          String?
  /// Zusaetzlich gesuchte Spieler. Der Ersteller zaehlt bereits als Teilnehmer.
  requestedPlayers   Int
  comment            String?
  status             SpielersucheStatus         @default(OPEN)
  source             SpielersucheSource         @default(SLASH_COMMAND)
  channelId          String?
  messageId          String?                    @unique
  voiceChannelId     String?
  voiceChannelName   String?
  /// Squad-Groesse des Spiels zum Zeitpunkt der Suche (NULL = unbegrenzt).
  maxSquadSize       Int?
  createdAt          DateTime                   @default(now())
  expiresAt          DateTime
  closedAt           DateTime?
  closedByDiscordId  String?
  closeReason        String?
  /// Gesetzt, solange die Suche laeuft: `<creatorDiscordId>#<Platznummer>`.
  /// Der Unique-Index begrenzt dadurch die Zahl gleichzeitiger Suchen pro
  /// Person auf Datenbankebene - nicht nur im Anwendungscode.
  activeCreatorKey   String?                    @unique
  idempotencyKey     String?                    @unique
  /// `matches.id` aus der Altdatenbank.
  legacyId           Int?                       @unique
  importId           String?
  import             SpielersucheImport?        @relation(fields: [importId], references: [id])
  participants       SpielersucheParticipant[]
  voiceSessions      SpielersucheVoiceSession[]

  @@index([status, expiresAt])
  @@index([creatorDiscordId, createdAt])
  @@index([gameId])
  @@index([voiceChannelId])
  @@index([createdAt])
}

/// Teilnahme an einer Suche.
///
/// Ein Austritt loescht die Zeile nicht, sondern setzt `leftAt`. Dadurch
/// bleibt die Teilnahmehistorie erhalten und der Unique-Index verhindert
/// trotzdem zuverlaessig doppelte Teilnahmen.
model SpielersucheParticipant {
  id          String            @id @default(cuid())
  matchId     String
  match       SpielersucheMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  discordId   String
  username    String?
  displayName String?
  avatarHash  String?
  isCreator   Boolean           @default(false)
  joinedAt    DateTime          @default(now())
  leftAt      DateTime?

  @@unique([matchId, discordId])
  @@index([discordId, joinedAt])
  @@index([matchId, leftAt])
}

/// Letzter Rollen-Ping je Spiel - Grundlage des Ping-Cooldowns.
model SpielersucheRolePing {
  id       String           @id @default(cuid())
  gameId   String           @unique
  game     SpielersucheGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roleId   String
  pingedAt DateTime

  @@index([pingedAt])
}

/// Nutzung der Spielersuche - Grundlage der Statistik und der Rangliste.
model SpielersucheUsage {
  id        String             @id @default(cuid())
  discordId String
  /// Immer `spielersuche`; das Feld bleibt fuer spaetere Befehle offen.
  command   String             @default("spielersuche")
  source    SpielersucheSource @default(SLASH_COMMAND)
  usedAt    DateTime           @default(now())
  legacyId  Int?               @unique

  @@index([discordId, usedAt])
  @@index([usedAt])
}

/// Zeit in einem von der Spielersuche erstellten Sprachkanal.
model SpielersucheVoiceSession {
  id              String             @id @default(cuid())
  discordId       String
  matchId         String?
  match           SpielersucheMatch? @relation(fields: [matchId], references: [id])
  voiceChannelId  String
  joinedAt        DateTime
  leftAt          DateTime?
  durationSeconds Int                @default(0)
  legacyId        Int?               @unique

  @@index([discordId, joinedAt])
  @@index([voiceChannelId, leftAt])
  @@index([matchId])
}

/// Ein Durchlauf der Uebernahme aus `matchmaking.db`.
model SpielersucheImport {
  id                   String                   @id @default(cuid())
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               SpielersucheImportStatus @default(ANALYSED)
  schemaInfo           Json?
  /// Guild, deren Daten uebernommen werden. Die Altdatenbank kann mehrere
  /// Server enthalten (Test- und Produktivserver).
  sourceGuildId        String?
  totalRows            Int                      @default(0)
  importableRows       Int                      @default(0)
  duplicateRows        Int                      @default(0)
  invalidRows          Int                      @default(0)
  otherGuildRows       Int                      @default(0)
  conflictRows         Int                      @default(0)
  importedRows         Int                      @default(0)
  failedRows           Int                      @default(0)
  legacyBotStopped     Boolean                  @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime                 @default(now())
  finishedAt           DateTime?
  items                SpielersucheImportItem[]
  matches              SpielersucheMatch[]

  @@index([status, createdAt])
}

/// Eine bewertete Zeile aus der Altdatenbank.
model SpielersucheImportItem {
  id        String                   @id @default(cuid())
  importId  String
  import    SpielersucheImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      SpielersucheImportKind
  /// Stabiler Schluessel der Legacy-Zeile, z.B. `game:18`.
  legacyKey String
  label     String
  action    SpielersucheImportAction
  note      String?
  /// Die gelesenen Werte - Grundlage fuer die Uebernahme und die Vorschau.
  payload   Json
  imported  Boolean                  @default(false)
  targetId  String?
  createdAt DateTime                 @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, kind, action])
}

// ---------------------------------------------------------------------------
// Level-System
//
// Der alte Level-Bot fuehrte nur Endstaende (`levels.xp`). Wer wissen wollte,
// woher eine Zahl kommt, musste die Discord-Logs durchsuchen. Hier ist jede
// Aenderung eine Zeile in `XpTransaction`; `LevelProfile.xp` ist die Summe
// daraus und wird in derselben Transaktion fortgeschrieben.
// ---------------------------------------------------------------------------

/// Woher eine XP-Buchung stammt.
enum XpSource {
  MESSAGE
  VOICE
  GAME_WIN
  GAME_LOSS
  /// Einsatz, der beim Start eines Spiels zurueckgelegt wird.
  GAME_STAKE
  /// Rueckgabe des Einsatzes bei Unentschieden, Abbruch oder Zeitablauf.
  GAME_REFUND
  ADMIN
  DECAY
  BOOST
  MIGRATION
  SYSTEM
  /// Einsatz fuer eine XP-Verlosung.
  RAFFLE_ENTRY
  /// Rueckzahlung eines Verlosungs-Einsatzes.
  RAFFLE_REFUND
  /// XP-Gewinn aus einer Verlosung.
  RAFFLE_PRIZE
}

enum XpGameKind {
  XP_BATTLE
  XP_SSP
  XP_TTT
  XP_4GEWINNT
}

enum XpGameStatus {
  /// Herausgefordert, noch nicht angenommen.
  PENDING
  RUNNING
  FINISHED
  DRAW
  DECLINED
  TIMEOUT
  CANCELLED
}

enum LevelImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTED
  FAILED
}

enum LevelImportKind {
  PROFILE
  GAME_STATS
  NO_XP_CHANNEL
  CONFIG
  GUILD_CONFIG
  ENV_SETTING
}

enum LevelImportAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_INVALID
  SKIP_EMPTY
  CONFLICT
}

/// XP-Stand einer Person.
model LevelProfile {
  id               String    @id @default(cuid())
  discordId        String    @unique
  username         String?
  displayName      String?
  avatarHash       String?
  /// Nie negativ - der alte Bot klemmte mit `MAX(0, xp + delta)`.
  xp               Int       @default(0)
  messages         Int       @default(0)
  voiceMinutes     Int       @default(0)
  /// Dateiname einer selbst hochgeladenen Levelkarte.
  ///
  /// Nur der Name, nicht der Pfad: die Datei liegt im Upload-Verzeichnis
  /// ausserhalb des statisch bedienten Bereichs, und ausgeliefert wird sie
  /// ueber eine Route, die die Berechtigung prueft. Ein Pfad in der
  /// Datenbank waere eine Einladung, ihn zu manipulieren.
  ///
  /// Leer bedeutet: es gilt der Hintergrund aus den Moduleinstellungen.
  customCardPath   String?
  /// Setzt die Nachlassfrist zurueck (Nachricht oder Voice).
  lastActivityAt   DateTime?
  /// Bis hierhin wurde Inaktivitaets-Abzug bereits verrechnet.
  lastDecayAt      DateTime?
  lastMessageAt    DateTime?
  lastVoiceAt      DateTime?
  /// SHA-256 der `levels.db`, aus der dieser Stand uebernommen wurde.
  /// Verhindert, dass dieselbe Datei zweimal XP setzt.
  legacyImportSha  String?
  legacyImportedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions XpTransaction[]
  gameStats    LevelGameStats[]

  @@index([xp])
  @@index([lastActivityAt])
  @@index([lastDecayAt])
}

/// Eine einzelne XP-Buchung. Fortlaufendes Journal, wird nie geaendert.
model XpTransaction {
  id             String          @id @default(cuid())
  profileId      String
  profile        LevelProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  discordId      String
  source         XpSource
  /// Tatsaechlich verbuchte Aenderung, nachdem auf >= 0 XP geklemmt wurde.
  delta          Int
  /// Angeforderte Aenderung vor der Klemmung. Weicht nur ab, wenn ein Abzug
  /// groesser war als der Punktestand.
  requestedDelta Int
  xpBefore       Int
  xpAfter        Int
  levelBefore    Int
  levelAfter     Int
  reason         String?
  actorDiscordId String?
  channelId      String?
  gameMatchId    String?
  gameMatch      LevelGameMatch? @relation(fields: [gameMatchId], references: [id])
  importId       String?
  import         LevelImport?    @relation(fields: [importId], references: [id])
  /// Schuetzt Wiederholungen vor Doppelbuchungen.
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())

  @@index([discordId, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@index([gameMatchId])
}

/// Eine Partie eines XP-Spiels.
model LevelGameMatch {
  id                  String       @id @default(cuid())
  kind                XpGameKind
  status              XpGameStatus @default(PENDING)
  challengerDiscordId String
  opponentDiscordId   String
  bet                 Int
  /// Auszahlung an den Gewinner: `floor(bet * 2 * 0.95)` wie beim Vorgaenger.
  payout              Int
  /// Einsaetze beider Seiten liegen bereits im Topf.
  potHeld             Boolean      @default(false)
  winnerDiscordId     String?
  guildId             String?
  channelId           String?
  messageId           String?
  createdAt           DateTime     @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  expiresAt           DateTime?
  /// Solange eine Partie laeuft: die Discord-ID der jeweiligen Seite. Der
  /// Vorgaenger merkte sich das nur im Arbeitsspeicher und vergass es beim
  /// Neustart; hier haelt die Datenbank die Sperre.
  activeChallengerKey String?      @unique
  activeOpponentKey   String?      @unique
  /// Spielstand laufender Partien (Spielfeld, Punkte, wer am Zug ist).
  /// Beim Vorgaenger lag er im Arbeitsspeicher und ging bei jedem Neustart
  /// verloren - mitsamt den bereits eingezogenen Einsaetzen.
  state               Json?

  transactions XpTransaction[]

  @@index([kind, status])
  @@index([status, expiresAt])
  @@index([challengerDiscordId, createdAt])
  @@index([opponentDiscordId, createdAt])
}

/// Bilanz einer Person je Spielart.
model LevelGameStats {
  id        String       @id @default(cuid())
  profileId String
  profile   LevelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  discordId String
  kind      XpGameKind
  wins      Int          @default(0)
  losses    Int          @default(0)
  draws     Int          @default(0)
  xpWon     Int          @default(0)
  xpLost    Int          @default(0)
  updatedAt DateTime     @updatedAt

  @@unique([discordId, kind])
  @@index([kind, wins])
}

/// Rolle, die ab einem bestimmten Level vergeben wird.
///
/// Loeste `MILESTONE_ROLES="5:ROLEID,10:ROLEID"` aus der alten `.env` ab.
model LevelMilestoneRole {
  id        String   @id @default(cuid())
  level     Int      @unique
  roleId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, level])
}

/// Ein Uebernahmelauf aus der alten `levels.db`.
model LevelImport {
  id                   String            @id @default(cuid())
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               LevelImportStatus @default(ANALYSED)
  schemaInfo           Json?
  totalRows            Int               @default(0)
  importableRows       Int               @default(0)
  duplicateRows        Int               @default(0)
  invalidRows          Int               @default(0)
  conflictRows         Int               @default(0)
  importedRows         Int               @default(0)
  failedRows           Int               @default(0)
  /// Bestaetigung, dass der alte Bot abgeschaltet ist. Ohne sie wuerden
  /// beide Bots gleichzeitig XP vergeben.
  legacyBotStopped     Boolean           @default(false)
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime          @default(now())
  finishedAt           DateTime?

  items        LevelImportItem[]
  transactions XpTransaction[]

  @@index([status, createdAt])
  @@index([fileSha256])
}

/// Eine bewertete Zeile aus der Altdatenbank.
model LevelImportItem {
  id        String            @id @default(cuid())
  importId  String
  import    LevelImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      LevelImportKind
  /// Stabiler Schluessel der Legacy-Zeile, z.B. `profile:123456789`.
  legacyKey String
  label     String
  action    LevelImportAction
  note      String?
  payload   Json
  imported  Boolean           @default(false)
  targetId  String?
  createdAt DateTime          @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, kind, action])
}

// ---------------------------------------------------------------------------
// XP-Verlosungen ("XP-Gluecksrad")
//
// Gehoert fachlich zum Level-System: eingesetzt werden dieselben XP, gebucht
// wird ueber dieselbe Engine, das Journal ist dasselbe `XpTransaction`. Es
// gibt bewusst keine zweite Waehrung und keine getrennte Brieftasche.
// ---------------------------------------------------------------------------

enum XpRaffleStatus {
  /// Entwurf. Alle Einstellungen sind noch frei aenderbar.
  DRAFT
  /// Veroeffentlicht, Teilnahme beginnt zum hinterlegten Zeitpunkt.
  SCHEDULED
  ENTRY_OPEN
  ENTRY_CLOSED
  /// Ziehung laeuft. Ab hier kommt niemand mehr dazu.
  DRAWING
  /// Gewinner steht fest, wartet auf Bestaetigung durch die Verwaltung.
  WINNER_PENDING
  COMPLETED
  CANCELLED
}

enum XpRaffleEntryModel {
  /// Alle zahlen denselben Betrag und haben dieselbe Chance.
  FIXED
  /// Anteil der eigenen XP; die Chance folgt dem Einsatz.
  PERCENTAGE
}

enum XpRaffleEntryStatus {
  ACTIVE
  /// Einsatz zurueckgezahlt (Abbruch oder Entfernung durch die Verwaltung).
  REFUNDED
  /// Von der Ziehung ausgeschlossen, Einsatz zurueckgezahlt.
  DISQUALIFIED
  WINNER
}

enum XpRafflePrizeKind {
  /// Sachpreis ausserhalb des Systems - nur Beschreibung und Verwaltung.
  EXTERNAL_PRIZE
  /// XP-Gutschrift an die gewinnende Person.
  XP_PRIZE
  /// Discord-Rolle, die der Bot nach Bestaetigung vergibt.
  ROLE_PRIZE
  /// Reine Ankuendigung ohne hinterlegten Preis.
  TEXT_ONLY
}

enum XpRaffleRefundReason {
  RAFFLE_CANCELLED
  ENTRY_REMOVED
  MINIMUM_NOT_REACHED
}

/// Eine Verlosung.
model XpRaffle {
  id          String  @id @default(cuid())
  title       String
  description String?
  /// Hochgeladenes Banner (Dateiname im Upload-Verzeichnis).
  bannerPath  String?
  /// Banner als Adresse - Alternative zum Hochladen.
  bannerUrl   String?

  prizeKind        XpRafflePrizeKind @default(EXTERNAL_PRIZE)
  prizeDescription String
  /// Nur bei `XP_PRIZE`: Gutschrift an die gewinnende Person.
  prizeXp          Int?
  /// Nur bei `ROLE_PRIZE`.
  prizeRoleId      String?

  status     XpRaffleStatus     @default(DRAFT)
  entryModel XpRaffleEntryModel

  /// Nur bei `FIXED`.
  fixedEntryXp          Int?
  /// Nur bei `PERCENTAGE`: Anteil in Basispunkten (500 = 5,00 %).
  /// Ganzzahlig, damit der Einsatz nicht von Gleitkomma-Rundung abhaengt.
  percentageBasisPoints Int?
  minimumEntryXp        Int?
  maximumEntryXp        Int?

  /// Ohne diese Zahl wird nicht gezogen.
  minimumParticipants Int  @default(2)
  maximumParticipants Int?

  entryStartsAt   DateTime?
  entryEndsAt     DateTime?
  drawScheduledAt DateTime?
  /// Ziehung zum geplanten Zeitpunkt selbst starten.
  autoDraw        Boolean   @default(false)

  /// Teilnehmerliste fuer angemeldete Mitglieder sichtbar machen.
  participantsPublic Boolean @default(true)
  /// Gewinner nach Bestaetigung selbst auf Discord veroeffentlichen.
  autoAnnounceWinner Boolean @default(true)

  discordChannelId      String?
  discordMessageId      String?
  /// Gesetzt, wenn die Ankuendigung auf Discord nicht mehr auffindbar ist.
  discordMessageMissing Boolean @default(false)
  winnerMessageId       String?

  /// Zaehler fuer die Anzeige. Die Wahrheit sind die Zeilen in `entries`;
  /// diese Felder ersparen der Uebersicht nur das Nachzaehlen.
  entryCount Int @default(0)
  potXp      Int @default(0)

  createdByDiscordId String
  publishedAt        DateTime?
  entryOpenedAt      DateTime?
  entryClosedAt      DateTime?
  drawStartedAt      DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  /// Verhindert, dass ein wiederholter Abbruch zweimal auszahlt.
  refundedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries XpRaffleEntry[]
  draws   XpRaffleDraw[]
  refunds XpRaffleRefund[]

  /// Der gueltige Draw, nachdem er bestaetigt wurde.
  confirmedDrawId String?       @unique
  confirmedDraw   XpRaffleDraw? @relation("ConfirmedDraw", fields: [confirmedDrawId], references: [id])

  @@index([status, entryEndsAt])
  @@index([status, drawScheduledAt])
  @@index([createdAt])
}

/// Die Teilnahme einer Person. Wird nach der Abbuchung nie geloescht.
model XpRaffleEntry {
  id        String   @id @default(cuid())
  raffleId  String
  raffle    XpRaffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  discordId String

  /// Namensstand zum Zeitpunkt der Teilnahme - fuer die Nachvollziehbarkeit.
  username    String?
  displayName String?

  /// XP-Stand unmittelbar vor der Abbuchung.
  xpBeforeEntry Int
  /// Tatsaechlich bezahlter Einsatz. Nach der Teilnahme unveraenderlich -
  /// spaetere XP-Gewinne oder -Verluste beruehren ihn nicht.
  entryXp       Int
  /// Gewicht in der Ziehung: bei `FIXED` immer 1, bei `PERCENTAGE` der Einsatz.
  weight        Int

  status        XpRaffleEntryStatus @default(ACTIVE)
  /// Pflichtgrund, wenn die Verwaltung eine Teilnahme entfernt.
  removalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds  XpRaffleRefund[]
  wonDraws XpRaffleDraw[]   @relation("DrawWinner")

  /// Eine Teilnahme pro Person und Verlosung - auf Datenbankebene, nicht nur
  /// im Anwendungscode. Zwei gleichzeitige Anfragen koennen damit nicht
  /// beide durchkommen.
  @@unique([raffleId, discordId])
  @@index([raffleId, status])
  @@index([discordId, createdAt])
}

/// Eine Ziehung. Jeder Versuch - auch eine Neuziehung - ist eine eigene Zeile.
model XpRaffleDraw {
  id       String   @id @default(cuid())
  raffleId String
  raffle   XpRaffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  /// Fortlaufend ab 1. Eine Neuziehung erhoeht die Nummer.
  version Int

  /// Unveraenderlicher Auszug der gueltigen Teilnahmen zum Zeitpunkt der
  /// Ziehung: `[{ entryId, discordId, weight }]`. Ohne ihn liesse sich
  /// spaeter nicht mehr pruefen, worauf die Ziehung beruhte.
  snapshot Json

  participantCount Int
  totalWeight      Int

  winnerEntryId   String
  winnerEntry     XpRaffleEntry @relation("DrawWinner", fields: [winnerEntryId], references: [id])
  winnerDiscordId String

  /// Der gezogene Punkt auf der Gewichtsachse - zusammen mit dem Auszug laesst
  /// sich die Ziehung damit nachrechnen.
  drawnTicket      Int
  /// Zufallswert der Ziehung, hexadezimal. Dient der Nachvollziehbarkeit.
  entropy          String
  /// Damit eine spaetere Aenderung am Verfahren alte Ziehungen nicht
  /// unerklaerbar macht.
  algorithmVersion Int    @default(1)
  /// Steuert die Animation im Browser. Hat keinen Einfluss auf den Gewinner.
  animationSeed    String

  /// Nur gesetzt, wenn diese Ziehung eine fruehere ersetzt.
  redrawReason     String?
  /// Teilnahmen, die in dieser Ziehung nicht mehr antreten durften.
  excludedEntryIds String[]

  startedByDiscordId   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())

  confirmedFor XpRaffle? @relation("ConfirmedDraw")

  @@unique([raffleId, version])
  @@index([raffleId, createdAt])
}

/// Eine Rueckzahlung. Getrennt gefuehrt, damit ein wiederholter Abbruch nicht
/// zweimal auszahlt und jede Zahlung einzeln nachvollziehbar bleibt.
model XpRaffleRefund {
  id       String        @id @default(cuid())
  raffleId String
  raffle   XpRaffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  entryId  String
  entry    XpRaffleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  discordId      String
  amount         Int
  reason         XpRaffleRefundReason
  note           String?
  actorDiscordId String?
  createdAt      DateTime             @default(now())

  /// Eine Teilnahme wird hoechstens einmal zurueckgezahlt.
  @@unique([entryId])
  @@index([raffleId])
}

// ---------------------------------------------------------------------------
// SwissHub Premium
//
// Ein Abonnement hat drei voneinander unabhaengige Zustaende, die bewusst
// getrennt gefuehrt werden:
//
//   status              - was der Zahlungsanbieter sagt
//   discordSyncStatus   - ob Discord den gewuenschten Zustand erreicht hat
//   PremiumDiscordResource.state - was auf Discord tatsaechlich existiert
//
// Diese Trennung ist der Kern: ein Discord-Ausfall darf eine erfolgreiche
// Zahlung niemals rueckgaengig machen. Er hinterlaesst nur einen fehlerhaften
// Sync, den die Reconciliation spaeter nachholt.
// ---------------------------------------------------------------------------

enum PremiumEntitlement {
  PREMIUM_ROLE
  PREMIUM_STUEBLI_ROLE
  PRIVATE_VOICE
}

enum PremiumSubscriptionStatus {
  /// Checkout begonnen, Zahlung noch nicht bestaetigt.
  PENDING
  /// Bezahlt und laufend.
  ACTIVE
  /// Folgezahlung offen, Schonfrist laeuft.
  PAST_DUE
  /// Zahlung endgueltig fehlgeschlagen, Schonfrist laeuft.
  PAYMENT_FAILED
  /// Gekuendigt, laeuft bis zum Ende der bezahlten Periode.
  CANCEL_AT_PERIOD_END
  /// Vom Mitglied oder der Verwaltung beendet.
  CANCELLED
  /// Periode und Schonfrist abgelaufen - keine Anspruecke mehr.
  EXPIRED
}

enum PremiumPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Hat Discord den gewuenschten Zustand erreicht?
enum PremiumSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PremiumResourceType {
  PREMIUM_STUEBLI_VOICE
}

enum PremiumResourceState {
  PENDING
  ACTIVE
  FAILED
  REMOVING
  REMOVED
}

enum PremiumEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Ein buchbares Angebot. Bewusst in der Datenbank statt im Code: Preise und
/// Texte aendern sich, ohne dass dafuer ein Deployment noetig sein soll.
model PremiumProduct {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  description     String
  /// Preis in Rappen. Niemals Gleitkomma - CHF 5.00 sind 500.
  priceMinor      Int
  currency        String               @default("CHF")
  /// Aufzaehlung fuer die Produktkarte.
  features        Json                 @default("[]")
  /// Welche Anspruechen das Angebot gewaehrt.
  entitlements    PremiumEntitlement[]
  active          Boolean              @default(true)
  sortOrder       Int                  @default(0)
  /// Preis-ID beim Zahlungsanbieter (z.B. Stripe Price). Erst nach der
  /// Einrichtung des Anbieters gesetzt.
  providerPriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions PremiumSubscription[]

  @@index([active, sortOrder])
}

/// Das Abonnement eines Mitglieds. Hoechstens eines davon ist gleichzeitig
/// offen - erzwungen durch `activeUserKey`.
model PremiumSubscription {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Redundant zur Relation, aber der Bot arbeitet ausschliesslich mit
  /// Discord-IDs und soll dafuer nicht jedes Mal joinen muessen.
  discordId String

  productId String
  product   PremiumProduct @relation(fields: [productId], references: [id])

  status PremiumSubscriptionStatus @default(PENDING)

  /// Genau ein offenes Abonnement je Mitglied.
  ///
  /// Traegt die Benutzer-ID, solange das Abonnement offen ist, und `null`,
  /// sobald es beendet ist. Ein Teilindex auf eine nullbare Spalte ist der
  /// einzige Weg, "hoechstens eines" in der Datenbank selbst zu erzwingen -
  /// eine Pruefung in der Anwendung verliert gegen zwei gleichzeitige
  /// Anfragen. Dasselbe Muster nutzt bereits die Spielersuche.
  activeUserKey String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// Zeitpunkt der Kuendigung. Die Anspruechen bleiben bis zum Periodenende.
  cancelledAt        DateTime?
  /// Ende der Schonfrist nach einer fehlgeschlagenen Folgezahlung.
  graceUntil         DateTime?
  endedAt            DateTime?

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?

  discordSyncStatus PremiumSyncStatus @default(PENDING)
  lastSyncAt        DateTime?
  lastSyncError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  PremiumPayment[]
  resources PremiumDiscordResource[]

  @@unique([activeUserKey])
  @@unique([providerSubscriptionId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([discordSyncStatus])
}

model PremiumPayment {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  subscription   PremiumSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider          String
  providerPaymentId String?
  amountMinor       Int
  currency          String               @default("CHF")
  status            PremiumPaymentStatus @default(PENDING)

  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  /// Ein Anbieter liefert dieselbe Zahlung mehrfach - einmal je Zustellversuch.
  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status])
}

/// Jede Zustellung des Anbieters, dauerhaft. Grundlage fuer Idempotenz und
/// dafuer, einen fehlgeschlagenen Verarbeitungsversuch spaeter nachzuvollziehen.
model PremiumPaymentEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String

  processingStatus PremiumEventStatus @default(RECEIVED)
  payload          Json               @default("{}")

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  error       String?

  /// Der Kern der Idempotenz: eine zweite Zustellung desselben Ereignisses
  /// laeuft in diesen Schluessel und wird verworfen.
  @@unique([provider, providerEventId])
  @@index([processingStatus, createdAt])
}

/// Was auf Discord fuer ein Mitglied tatsaechlich angelegt wurde.
model PremiumDiscordResource {
  id             String               @id @default(cuid())
  userId         String
  discordId      String
  subscriptionId String?
  subscription   PremiumSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  guildId      String
  resourceType PremiumResourceType

  discordResourceId String?
  discordCategoryId String?
  /// Name des Kanals, damit die Verwaltung ihn auch nach dem Loeschen kennt.
  name              String?

  state PremiumResourceState @default(PENDING)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  removedAt     DateTime?
  lastSyncAt    DateTime?
  lastSyncError String?

  /// Ein Mitglied hat hoechstens ein Stuebli. Doppelklick, Webhook-Wiederholung
  /// und paralleler Sync laufen alle in diesen Schluessel.
  @@unique([userId, resourceType])
  @@index([state])
  @@index([discordResourceId])
}

// ===========================================================================
// SwissHub Music
//
// Der Legacy-Bot hielt seinen gesamten Zustand im Arbeitsspeicher eines
// einzigen Python-Prozesses: `active_session[(guild_id, channel_id)]` als
// Zuordnung, `asyncio.Queue` als Warteschlange. Das funktioniert, solange
// genau ein Prozess existiert und nie neu startet - beides trifft hier nicht
// mehr zu. WebApp und Voice-Runtime sind getrennte Prozesse, und die WebApp
// laeuft potenziell mehrfach.
//
// Deshalb liegt der *steuernde* Zustand in der Datenbank: wer welchem Kanal
// zugewiesen ist, was in der Warteschlange steht, welcher Befehl noch offen
// ist. Der *fluechtige* Zustand - der laufende FFmpeg-Prozess, die
// Voice-Verbindung selbst - bleibt bewusst in der Runtime. Er ueberlebt
// keinen Neustart, und so zu tun, als waere das anders, waere gelogen.
// ===========================================================================

/// Controller oder Worker? Der Unterschied ist reine Zuweisungspolitik:
/// technisch spielt beides identisch ab.
enum MusicBotType {
  CONTROLLER
  WORKER
}

enum MusicBotStatus {
  OFFLINE
  FREE
  BUSY
  CONNECTING
  DEGRADED
  DRAINING
  DISABLED
}

enum MusicSessionStatus {
  STARTING
  ACTIVE
  DEGRADED
  ENDED
}

enum MusicLoopMode {
  OFF
  TRACK
  QUEUE
}

/// Warum eine Session endete - fuer den Verlauf und die Fehlersuche.
enum MusicSessionEndReason {
  MANUAL
  IDLE_TIMEOUT
  ALONE_TIMEOUT
  WORKER_OFFLINE
  ADMIN_FORCED
  MODULE_DISABLED
  STALE_RECONCILED
}

enum MusicCommandKind {
  PLAY
  PAUSE
  RESUME
  SKIP
  /// Innerhalb des laufenden Titels an eine Stelle springen.
  SEEK
  STOP
  LEAVE
  JOIN
  SET_VOLUME
  SET_LOOP
  QUEUE_ADD
  QUEUE_REMOVE
  QUEUE_MOVE
  QUEUE_SHUFFLE
}

enum MusicCommandStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  TIMEOUT
}

/// Ein Bot des Pools.
///
/// Bewusst OHNE Token-Spalte. Die Tokens sind Infrastruktur-Geheimnisse und
/// kommen aus der Umgebung der Voice-Runtime; die Datenbank kennt nur die
/// Identitaet und den Zustand. Ein Klartext-Token in einer normalen Tabelle
/// waere genau der Fehler, den die Legacy-config.json bereits gemacht hat.
model MusicBotInstance {
  id   String       @id @default(cuid())
  type MusicBotType

  /// Stabiler interner Schluessel: CONTROLLER, WORKER_1, WORKER_2 ...
  /// Nicht die Position in einem Array - die verschiebt sich.
  key  String
  /// Anzeigename aus Discord, sobald der Bot sich einmal gemeldet hat.
  name String?

  discordUserId String?
  avatarHash    String?

  /// Vom Betrieb abschaltbar. Ein abgeschalteter Bot bekommt keine neuen
  /// Sessions, behaelt eine laufende aber, bis sie normal endet.
  enabled Boolean        @default(true)
  status  MusicBotStatus @default(OFFLINE)

  lastHeartbeatAt DateTime?
  lastError       String?
  startedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions MusicSession[]

  @@unique([key])
  @@unique([discordUserId])
  @@index([status, enabled])
}

/// Eine Musik-Session in genau einem Voice-Kanal.
model MusicSession {
  id      String @id @default(cuid())
  guildId String

  voiceChannelId   String
  voiceChannelName String?

  botInstanceId String?
  botInstance   MusicBotInstance? @relation(fields: [botInstanceId], references: [id], onDelete: SetNull)

  status MusicSessionStatus @default(STARTING)

  /// Genau eine offene Session je Voice-Kanal.
  ///
  /// Traegt "<guildId>:<voiceChannelId>", solange die Session laeuft, und
  /// `null`, sobald sie beendet ist. Derselbe Teilindex-Trick wie bei
  /// Premium: zwei gleichzeitige /join duerfen nicht zwei Sessions erzeugen,
  /// und das entscheidet die Datenbank, nicht die Anwendung.
  activeChannelKey String?

  /// Genau eine offene Session je Bot.
  ///
  /// Traegt die Bot-ID, solange die Session laeuft. Verhindert, dass zwei
  /// gleichzeitige Zuweisungen denselben Worker in zwei Kanaele schicken -
  /// die Race Condition, gegen die eine In-Memory-Map machtlos ist.
  activeBotKey String?

  loopMode MusicLoopMode @default(OFF)
  /// Lautstaerke in Prozent, 0-150 wie im Legacy-System. Ganzzahlig.
  volume   Int           @default(50)

  /// Der laufende Titel. Zeigt auf das Warteschlangenelement, damit Titel,
  /// Dauer und Besteller nicht doppelt gefuehrt werden.
  currentItemId  String?
  /// Beginn des laufenden Titels - Grundlage der Fortschrittsberechnung im
  /// Browser. Ohne diesen Wert muesste die Oberflaeche sekuendlich fragen.
  trackStartedAt DateTime?
  pausedAt       DateTime?
  /// Aufsummierte Pausendauer in Millisekunden.
  pausedMs       Int       @default(0)

  /// Letzte echte Aktivitaet - Grundlage des Leerlauf-Disconnects.
  lastActivityAt DateTime  @default(now())
  /// Seit wann der Bot allein im Kanal ist; `null`, sobald jemand zuhoert.
  aloneSince     DateTime?
  listenerCount  Int       @default(0)

  startedByDiscordUserId String?

  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  endedAt   DateTime?
  endReason MusicSessionEndReason?

  queue    MusicQueueItem[]
  history  MusicPlaybackHistory[]
  commands MusicCommand[]

  @@unique([activeChannelKey])
  @@unique([activeBotKey])
  @@index([guildId, status])
  @@index([status, lastActivityAt])
}

/// Ein Element der Warteschlange.
model MusicQueueItem {
  id        String       @id @default(cuid())
  sessionId String
  session   MusicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Luecken erlaubt: Verschieben und Entfernen sollen nicht die halbe
  /// Warteschlange neu schreiben muessen.
  position Int

  provider        String
  providerTrackId String?
  title           String
  artist          String?
  /// Die Seiten-URL, NICHT die Stream-URL.
  ///
  /// YouTube-Stream-URLs tragen eine ablaufende Signatur. Der Legacy-Bot holt
  /// deshalb unmittelbar vor dem Abspielen eine frische URL - dieses
  /// Verhalten bleibt, und deshalb wird hier nur die dauerhafte Seiten-URL
  /// gespeichert.
  webpageUrl      String
  durationSeconds Int     @default(0)
  thumbnailUrl    String?

  requestedByDiscordUserId String?
  requestedByUsername      String?

  /// Nicht mehr abspielbar (Video geloescht, gesperrt). Bleibt sichtbar,
  /// damit erklaerbar ist, warum uebersprungen wurde.
  unavailable      Boolean @default(false)
  unavailableError String?

  createdAt DateTime @default(now())

  @@index([sessionId, position])
}

/// Was tatsaechlich gelaufen ist.
///
/// Bewusst sitzungs- und kanalbezogen, nicht personenbezogen: es soll
/// nachvollziehbar sein, was in einem Kanal lief, nicht wer was hoert.
model MusicPlaybackHistory {
  id        String        @id @default(cuid())
  sessionId String?
  session   MusicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  guildId        String
  voiceChannelId String

  title           String
  artist          String?
  webpageUrl      String
  durationSeconds Int     @default(0)
  thumbnailUrl    String?

  requestedByDiscordUserId String?
  requestedByUsername      String?

  playedAt      DateTime @default(now())
  /// Tatsaechlich gehoerte Dauer - kann unter `durationSeconds` liegen.
  playedSeconds Int      @default(0)
  skipped       Boolean  @default(false)

  @@index([guildId, playedAt])
  @@index([sessionId])
}

/// Ein Befehl an die Voice-Runtime.
///
/// Es gibt kein Redis im Projekt und keine offene HTTP-Schnittstelle zu den
/// Workern - beides waere neue Infrastruktur beziehungsweise ein offenes Tor.
/// Der Bus laeuft deshalb ueber die Datenbank, die ohnehin beide Seiten
/// verbindet: die WebApp schreibt, der zustaendige Bot holt ab und meldet
/// zurueck. Dadurch gibt es eine echte Rueckmeldung statt der Annahme, ein
/// Klick sei schon angekommen.
model MusicCommand {
  id        String       @id @default(cuid())
  sessionId String
  session   MusicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Wer ausfuehren soll. Ein Worker holt ausschliesslich seine eigenen.
  botInstanceId String

  kind    MusicCommandKind
  /// Zusatzangaben je Befehl (Lautstaerke, Element-ID, Zielposition).
  payload Json               @default("{}")
  status  MusicCommandStatus @default(PENDING)

  requestedByDiscordUserId String?
  /// Woher der Befehl kam - "web" oder "discord". Nur fuer die Fehlersuche.
  origin                   String  @default("web")

  claimedAt  DateTime?
  finishedAt DateTime?
  error      String?

  createdAt DateTime @default(now())

  @@index([botInstanceId, status, createdAt])
  @@index([sessionId, createdAt])
}

/// Wer sitzt gerade in welchem Sprachkanal?
///
/// Discord liefert Voice-Zustaende ueber das Gateway, nicht ueber REST - nur
/// der Bot kennt sie. Die WebApp braucht sie aber, um den Player auf den
/// Kanal des Aufrufenden zu richten, statt ihn eine Session aus einer Liste
/// waehlen zu lassen. Der Bot schreibt deshalb mit, was er ohnehin sieht.
///
/// Bewusst nur der aktuelle Zustand und keine Historie: es soll den Player
/// steuern, nicht nachvollziehbar machen, wer wann wo war.
model VoicePresence {
  discordId String @id
  guildId   String

  channelId   String
  channelName String?
  /// Anzeigename, wie ihn Discord im Kanal zeigt.
  ///
  /// Denormalisiert wie `channelName`: die WebApp ist ein eigener Prozess und
  /// sieht die Voice-Zustaende nicht. Ohne den Namen muesste sie fuer jede
  /// Mitgliederliste Discord fragen - einen Aufruf je Person je Seitenaufbau.
  displayName String?
  /// Andere Bots zaehlen nicht als Zuhoerer - das entscheidet der Schreiber.
  isBot       Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([guildId, channelId])
}

// ===========================================================================
// SwissHub Tickets
//
// Ein Ticket lebt an zwei Orten gleichzeitig: als Discord-Kanal und als
// Datensatz. Der Kanal ist verletzlich - jemand loescht ihn, Discord ist
// kurz weg, die Kategorie ist voll. Deshalb ist der Datensatz die Wahrheit:
// Verlauf, Nachrichten und Archiv ueberleben es, wenn der Kanal verschwindet.
//
// Umgekehrt gilt: was auf Discord passiert, wird hier mitgeschrieben, statt
// beim Schliessen aus dem Kanal rekonstruiert zu werden. Ein geloeschter
// Kanal duerfte sonst das halbe Archiv mitnehmen.
// ===========================================================================

enum TicketStatus {
  /// Angelegt, aber der Discord-Kanal fehlt noch.
  PENDING
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  WAITING_FOR_STAFF
  RESOLVED
  CLOSED
  ARCHIVED
  /// Die Kanalerstellung ist gescheitert - die Verwaltung kann es erneut
  /// versuchen, statt eine halb angelegte Zeile vorzufinden.
  CREATION_FAILED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Woher die Erstellung kam - fuer die Fehlersuche und die Statistik.
enum TicketSource {
  DISCORD_PANEL
  DISCORD_COMMAND
  WEBAPP
  ADMIN
}

enum TicketMessageSource {
  DISCORD
  WEBAPP
  BOT
  SYSTEM
  /// Interne Notiz - erscheint nie auf Discord und nie im Benutzer-Transcript.
  INTERNAL_NOTE
}

enum TicketEventKind {
  CREATED
  CLAIMED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TAG_ADDED
  TAG_REMOVED
  USER_ADDED
  USER_REMOVED
  CLOSED
  REOPENED
  ARCHIVED
  CHANNEL_RECREATED
  CHANNEL_MISSING
  ESCALATED
}

/// Wer eine Aktion ausgeloest hat.
enum TicketActorSource {
  WEBAPP
  DISCORD
  SYSTEM
}

enum TicketFormFieldKind {
  SHORT_TEXT
  LONG_TEXT
}

/// Was nach dem Schliessen mit dem Discord-Kanal geschieht.
enum TicketCloseBehaviour {
  DELETE_IMMEDIATELY
  KEEP_24H
  KEEP_7D
  KEEP_FOREVER
}

enum TicketTranscriptAudience {
  /// Ohne interne Notizen.
  USER
  /// Vollstaendig.
  STAFF
}

/// Eine Ticket-Kategorie - Support, Moderation, Bewerbung und so weiter.
///
/// Bewusst vollstaendig ueber das Dashboard verwaltbar: fest verdrahtete
/// Kategorien liessen sich nur mit einer Auslieferung aendern.
model TicketCategory {
  id      String @id @default(cuid())
  guildId String

  name        String
  description String?
  emoji       String?
  /// Farbe des Discord-Embeds, als Ganzzahl wie von Discord erwartet.
  color       Int?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Discord-Kategorie, in der die Kanaele entstehen. Fehlt sie, greift die
  /// Vorgabe aus den Moduleinstellungen.
  discordCategoryId  String?
  /// Ausweichkategorie, wenn die erste voll ist - Discord erlaubt 50 Kanaele.
  overflowCategoryId String?

  /// Rollen, die Tickets dieser Kategorie sehen und bearbeiten duerfen.
  supportRoleIds String[] @default([])
  /// Beim Erstellen erwaehnen?
  pingSupport    Boolean  @default(false)

  defaultPriority TicketPriority @default(NORMAL)

  /// Vorlage des Kanalnamens. `{number}`, `{username}` werden ersetzt.
  channelNameTemplate String  @default("ticket-{number}-{username}")
  welcomeMessage      String?
  closeMessage        String?

  /// 0 = keine eigene Grenze, dann gilt die globale.
  maxOpenPerUser Int @default(0)

  /// Darf der Ersteller selbst schliessen?
  userCanClose Boolean @default(true)

  /// Erinnerung und automatisches Schliessen, in Tagen. 0 = aus.
  reminderAfterDays  Int @default(0)
  autoCloseAfterDays Int @default(0)

  /// Antwort- und Loesungsziel in Stunden, rein intern. 0 = kein Ziel.
  responseTargetHours   Int @default(0)
  resolutionTargetHours Int @default(0)

  /// Heikle Kategorie - Meldungen, Moderation. Strengere Sichtbarkeit.
  sensitive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets    Ticket[]
  formFields TicketFormField[]
  panels     TicketPanelCategory[]
  templates  TicketTemplate[]

  @@index([guildId, active, sortOrder])
}

/// Ein Feld im Erstellungsformular einer Kategorie.
model TicketFormField {
  id         String         @id @default(cuid())
  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  kind        TicketFormFieldKind @default(SHORT_TEXT)
  label       String
  placeholder String?
  required    Boolean             @default(false)
  minLength   Int?
  maxLength   Int?
  sortOrder   Int                 @default(0)

  createdAt DateTime @default(now())

  @@index([categoryId, sortOrder])
}

/// Ein Ticket-Erstell-Panel in einem Discord-Kanal.
model TicketPanel {
  id      String @id @default(cuid())
  guildId String

  name         String
  title        String
  description  String
  bannerUrl    String?
  thumbnailUrl String?
  footerText   String?
  color        Int?

  discordChannelId String
  /// Die gesendete Nachricht. `null`, solange nie veroeffentlicht - oder
  /// wenn sie auf Discord geloescht wurde.
  discordMessageId String?

  buttonLabel String  @default("Ticket erstellen")
  buttonEmoji String? @default("🎫")

  active Boolean @default(true)

  /// Wann zuletzt festgestellt wurde, dass die Nachricht fehlt.
  missingSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories TicketPanelCategory[]

  @@unique([discordMessageId])
  @@index([guildId, active])
}

/// Welche Kategorien ein Panel anbietet, in welcher Reihenfolge.
model TicketPanelCategory {
  id         String         @id @default(cuid())
  panelId    String
  panel      TicketPanel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([panelId, categoryId])
  @@index([panelId, sortOrder])
}

/// Ein Ticket.
model Ticket {
  id      String @id @default(cuid())
  guildId String

  /// Fortlaufend je Guild. Die Eindeutigkeit unten ist der einzige
  /// verlaessliche Schutz gegen zwei gleichzeitige Erstellungen - eine
  /// Zaehlung in der Anwendung verliert dieses Rennen.
  ticketNumber Int

  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  subject String

  status   TicketStatus   @default(PENDING)
  priority TicketPriority @default(NORMAL)
  source   TicketSource   @default(DISCORD_PANEL)

  creatorDiscordId String
  creatorUsername  String

  assignedToDiscordId String?
  assignedToUsername  String?
  assignedAt          DateTime?

  /// Der Discord-Kanal. `null`, wenn er nie entstand oder geloescht wurde -
  /// das Ticket bleibt trotzdem vollstaendig erhalten.
  discordChannelId String?
  /// Die angepinnte Startnachricht mit den Knoepfen.
  discordMessageId String?
  /// Der Kanal fehlt auf Discord. Vom Abgleich gesetzt.
  channelMissing   Boolean @default(false)

  /// Antworten aus dem Erstellungsformular, als Feld-ID zu Antwort.
  formAnswers Json @default("{}")

  /// Zeitpunkte fuer die Kennzahlen. Bewusst hier und nicht errechnet:
  /// spaeter geloeschte Nachrichten wuerden die Rechnung sonst verfaelschen.
  firstStaffResponseAt DateTime?
  lastMessageAt        DateTime?
  /// Wer zuletzt geschrieben hat - danach sortiert die Warteschlange.
  lastMessageByStaff   Boolean?

  closedAt          DateTime?
  closedByDiscordId String?
  closeReason       String?

  reopenedAt DateTime?
  archivedAt DateTime?

  /// Wann der Kanal geloescht werden darf. Vom Aufraeumer gelesen.
  channelPurgeAt DateTime?

  /// Wie oft die Loeschung schon versucht wurde.
  ///
  /// Discord kann nein sagen - fehlendes Recht, ein 500er, ein Rate Limit
  /// mitten im Deployment. Frueher galt der Versuch danach als erledigt und
  /// der Kanal blieb fuer immer stehen. Jetzt zaehlt dieser Wert die
  /// Fehlversuche, staffelt den naechsten Anlauf und macht im Systemstatus
  /// sichtbar, wenn einer nicht mehr durchkommt.
  channelPurgeAttempts Int @default(0)

  /// Was Discord beim letzten Loeschversuch gesagt hat.
  ///
  /// Ohne diesen Satz ist ein haengender Kanal nicht zu diagnostizieren: im
  /// Log steht er, aber an das Log kommt im Zweifel niemand, und der
  /// Systemstatus koennte nur «geht nicht» melden. Mit ihm steht dort, ob es
  /// ein fehlendes Recht, ein Rate Limit oder etwas Drittes ist.
  channelPurgeLastError String?

  /// Wann zuletzt an eine Antwort erinnert wurde.
  ///
  /// Ohne diesen Zeitpunkt erinnerte jeder Durchgang erneut, solange das
  /// Ticket wartet - und aus einer Erinnerung wuerde eine stuendliche
  /// Mahnung.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants TicketParticipant[]
  messages     TicketMessage[]
  events       TicketEvent[]
  tags         TicketTagAssignment[]
  transcripts  TicketTranscript[]
  feedback     TicketFeedback?

  @@unique([guildId, ticketNumber])
  @@unique([discordChannelId])
  @@index([guildId, status, priority])
  @@index([guildId, categoryId, status])
  @@index([creatorDiscordId, createdAt])
  @@index([assignedToDiscordId, status])
  @@index([status, lastMessageAt])
  @@index([guildId, closedAt])
  /// Faellige Kanalloeschungen. Der Aufraeumlauf fragt alle paar Sekunden
  /// danach und findet fast immer nichts - ohne diesen Index waere das ein
  /// Seq Scan ueber alle Tickets, mehrmals pro Minute.
  @@index([channelPurgeAt])
}

/// Wer ausser dem Ersteller Zugriff auf ein Ticket hat.
model TicketParticipant {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  discordId String
  username  String

  addedByDiscordId String?
  addedAt          DateTime  @default(now())
  removedAt        DateTime?

  @@unique([ticketId, discordId])
  @@index([discordId])
}

/// Eine Nachricht im Ticket - aus Discord, aus der WebApp oder vom System.
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  source TicketMessageSource

  /// Die Discord-Nachricht, sofern es eine gibt. Interne Notizen haben keine.
  discordMessageId String?

  authorDiscordId  String?
  authorUsername   String?
  authorAvatarHash String?
  /// Hat Support geschrieben? Grundlage der Antwortzeiten und der Sortierung.
  fromStaff        Boolean @default(false)

  content String @db.Text

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  /// Auf Discord geloescht - der Eintrag bleibt, damit der Verlauf stimmt.
  deletedAt DateTime?

  attachments TicketAttachment[]

  @@unique([discordMessageId])
  @@index([ticketId, createdAt])
  @@index([ticketId, source])
}

/// Ein Anhang einer Ticket-Nachricht.
model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName    String
  contentType String?
  sizeBytes   Int     @default(0)
  /// Discord-CDN-Adresse oder der Name im eigenen Speicher.
  url         String  @db.Text
  /// Im eigenen Speicher abgelegt? Discord-Adressen laufen ab.
  stored      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([messageId])
}

/// Ein Schlagwort - reine Ticket-Metadaten, keine Discord-Rolle.
model TicketTag {
  id      String @id @default(cuid())
  guildId String

  name  String
  color String?

  createdAt DateTime @default(now())

  assignments TicketTagAssignment[]

  @@unique([guildId, name])
}

model TicketTagAssignment {
  id       String    @id @default(cuid())
  ticketId String
  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  addedByDiscordId String?
  addedAt          DateTime @default(now())

  @@unique([ticketId, tagId])
  @@index([tagId])
}

/// Was mit einem Ticket geschehen ist.
///
/// Nur den aktuellen Status zu speichern hiesse, den Weg dorthin zu
/// verlieren - und genau der ist es, den Support und Verwaltung brauchen.
model TicketEvent {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  kind           TicketEventKind
  actorDiscordId String?
  actorUsername  String?
  actorSource    TicketActorSource @default(SYSTEM)

  /// Was sich geaendert hat - alter und neuer Wert, Rollenname, und so weiter.
  detail Json @default("{}")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Ein erzeugtes Transcript.
model TicketTranscript {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  audience TicketTranscriptAudience

  /// Dateiname im Speicher - nicht der Pfad. Der Zugriff laeuft immer ueber
  /// eine autorisierte Route, nie ueber eine offene Adresse.
  fileName     String
  sizeBytes    Int    @default(0)
  messageCount Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([ticketId, audience])
  @@index([ticketId])
}

/// Rueckmeldung nach dem Schliessen.
model TicketFeedback {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// 1 bis 5.
  rating  Int
  comment String?

  givenByDiscordId String
  createdAt        DateTime @default(now())

  @@unique([ticketId])
  @@index([createdAt])
}

/// Wer keine Tickets mehr eroeffnen darf.
model TicketBlockEntry {
  id      String @id @default(cuid())
  guildId String

  discordId String
  username  String?
  reason    String

  blockedByDiscordId String
  createdAt          DateTime  @default(now())
  /// `null` = unbefristet.
  expiresAt          DateTime?
  liftedAt           DateTime?

  @@index([guildId, discordId, liftedAt])
}

/// Antwortvorlagen fuer den Support.
model TicketTemplate {
  id      String @id @default(cuid())
  guildId String

  title   String
  content String @db.Text

  /// Nur fuer diese Kategorie, oder fuer alle wenn leer.
  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, categoryId])
}

/// Der Zaehler fuer die Ticketnummern.
///
/// Eine eigene Zeile je Guild statt `MAX(ticketNumber) + 1`: die Rechnung
/// ueber alle Tickets liefert zwei gleichzeitigen Erstellungen dieselbe
/// Nummer. Ein `UPDATE ... RETURNING` auf diese Zeile nicht.
model TicketCounter {
  guildId    String @id
  /// Zuletzt vergebene Nummer.
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Turniere
// ===========================================================================
//
// Ein Turnier lebt an zwei Orten: als Datensatz und als Discord-Server voller
// Kanaele, Rollen und Nachrichten. Der Datensatz ist die Wahrheit. Kanaele
// werden geloescht, Nachrichten verschwinden, ein Server wird umgebaut - das
// Turnier, seine Teilnehmer, sein Bracket und sein Sieger bleiben trotzdem
// nachschlagbar. Deshalb traegt kein Modell hier eine Discord-Kennung als
// Pflichtfeld, und das Archiv kommt ohne Discord aus.

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECKIN_OPEN
  CHECKIN_CLOSED
  READY
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

/// Einzelspieler oder Team - entscheidet den ganzen Anmeldeweg.
enum TournamentMode {
  SOLO
  TEAM
}

/// Wer sich anmelden darf.
enum TournamentAccessMode {
  /// Jeder, sofort bestaetigt.
  OPEN
  /// Jeder, aber die Verwaltung gibt frei.
  APPROVAL
  /// Nur ausdruecklich Eingeladene.
  INVITE_ONLY
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
  GROUPS_THEN_ELIMINATION
}

enum TournamentSeeding {
  RANDOM
  MANUAL
  REGISTRATION_ORDER
  RATING
}

enum TournamentStaffRole {
  OWNER
  ADMIN
  REFEREE
  CASTER
  OBSERVER
}

enum TournamentRegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  CANCELLED
}

enum TournamentCheckinStatus {
  NOT_REQUIRED
  PENDING
  CHECKED_IN
  MISSED
  ADMIN_CONFIRMED
}

enum TournamentTeamStatus {
  FORMING
  REGISTERED
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  DISQUALIFIED
}

enum TournamentTeamMemberRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
  COACH
}

enum TournamentInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

/// Abschnitt eines Turniers - Gruppenphase, Hauptrunde, Verliererrunde.
enum TournamentStageKind {
  GROUPS
  SWISS
  ROUND_ROBIN
  WINNERS
  LOSERS
  GRAND_FINAL
}

enum TournamentMatchStatus {
  PENDING
  READY
  SCHEDULED
  LIVE
  AWAITING_RESULT
  DISPUTED
  COMPLETED
  FORFEIT
  CANCELLED
}

/// Warum ein Match so ausging, wie es ausging.
enum TournamentResultReason {
  PLAYED
  FORFEIT
  NO_SHOW
  BYE
  ADMIN_DECISION
}

enum TournamentStreamStatus {
  NOT_STREAMED
  PLANNED
  LIVE
  FINISHED
}

enum TournamentDisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum TournamentPrizeStatus {
  PENDING
  AWARDED
  DELIVERED
}

/// Welche Discord-Ressource das Modul selbst angelegt hat.
enum TournamentResourceKind {
  MATCH_CHANNEL
  ANNOUNCEMENT_MESSAGE
  PARTICIPANT_ROLE
  WINNER_ROLE
}

enum TournamentCustomFieldKind {
  SHORT_TEXT
  LONG_TEXT
  URL
  SELECT
}

/// Was im Turnierverlauf geschehen ist.
enum TournamentEventKind {
  CREATED
  PUBLISHED
  REGISTRATION_OPENED
  REGISTRATION_CLOSED
  CHECKIN_OPENED
  CHECKIN_CLOSED
  /// Jemand hat sich angemeldet. Nicht zu verwechseln mit
  /// REGISTRATION_APPROVED - das ist die Freigabe durch die Leitung.
  REGISTERED
  /// Jemand hat eingecheckt. Nicht zu verwechseln mit CHECKIN_OPENED - das
  /// ist der Phasenwechsel des ganzen Turniers.
  CHECKED_IN
  BRACKET_GENERATED
  BRACKET_RESEEDED
  ROUND_STARTED
  ROUND_COMPLETED
  STARTED
  PAUSED
  RESUMED
  COMPLETED
  CANCELLED
  ARCHIVED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  REGISTRATION_WITHDRAWN
  WAITLIST_PROMOTED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_DISQUALIFIED
  MATCH_SCHEDULED
  MATCH_RESULT_REPORTED
  MATCH_RESULT_CONFIRMED
  MATCH_RESULT_OVERRIDDEN
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  PRIZE_UPDATED
  STAFF_CHANGED
}

model Tournament {
  id      String @id @default(cuid())
  guildId String

  /// Teil der Adresse: /turniere/<slug>. Je Server eindeutig.
  slug String
  name String

  /// Freier Spielname oder Verweis auf die bestehende Spieleliste der
  /// Spielersuche - eine zweite Spieleverwaltung braucht es nicht.
  gameName String
  gameId   String?
  game     SpielersucheGame? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  description  String? @db.Text
  /// Regelwerk als Markdown. Die Web-Fassung ist die verbindliche.
  rules        String? @db.Text
  /// Wird erhoeht, wenn sich die Regeln wesentlich aendern. Teilnehmer, die
  /// eine aeltere Fassung bestaetigt haben, muessen erneut bestaetigen.
  rulesVersion Int     @default(1)
  rulesUrl     String?

  bannerUrl   String?
  logoUrl     String?
  /// Akzentfarbe als Ganzzahl wie von Discord erwartet; sonst SwissHub-Rot.
  accentColor Int?

  status  TournamentStatus     @default(DRAFT)
  mode    TournamentMode       @default(TEAM)
  access  TournamentAccessMode @default(OPEN)
  format  TournamentFormat     @default(SINGLE_ELIMINATION)
  seeding TournamentSeeding    @default(RANDOM)

  /// Teamgroesse. Bei SOLO ohne Bedeutung.
  minTeamSize    Int @default(1)
  maxTeamSize    Int @default(5)
  maxSubstitutes Int @default(0)

  /// 0 = keine Obergrenze. Darueber hinaus geht es auf die Warteliste.
  maxParticipants Int @default(0)
  minParticipants Int @default(2)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  checkinOpensAt       DateTime?
  checkinClosesAt      DateTime?
  /// Ab hier keine Teamaenderung mehr ohne Verwaltung.
  rosterLockAt         DateTime?
  startsAt             DateTime?
  estimatedEndAt       DateTime?

  /// Check-in ueberhaupt verlangen?
  checkinRequired         Boolean @default(true)
  /// Nicht Eingecheckte selbsttaetig entfernen, oder von Hand pruefen?
  autoRemoveMissedCheckin Boolean @default(false)

  // --- Format-Feinheiten -------------------------------------------------
  /// Anzahl Gruppen bei GROUPS_THEN_ELIMINATION.
  groupCount      Int      @default(0)
  /// Wie viele je Gruppe weiterkommen.
  advancePerGroup Int      @default(2)
  /// Runden bei SWISS. 0 = aus der Teilnehmerzahl ableiten.
  swissRounds     Int      @default(0)
  pointsPerWin    Int      @default(3)
  pointsPerDraw   Int      @default(1)
  pointsPerLoss   Int      @default(0)
  /// Reihenfolge der Tiebreaker als Liste von Kennungen.
  tiebreakers     String[] @default([])

  /// Standard-Format der Matches; einzelne Runden duerfen abweichen.
  defaultBestOf Int      @default(1)
  mapPool       String[] @default([])
  serverRegion  String?

  // --- Discord -----------------------------------------------------------
  announcementChannelId      String?
  matchCategoryId            String?
  staffCategoryId            String?
  streamChannelId            String?
  /// Rollen, die bei Ankuendigungen erwaehnt werden duerfen.
  pingRoleIds                String[] @default([])
  /// Temporaere Rolle fuer aktive Teilnehmer.
  participantRoleId          String?
  /// Rolle fuer den Sieger.
  winnerRoleId               String?
  /// Match-Kanaele: sofort, nach Stunden, oder am Turnierende (0).
  matchChannelRetentionHours Int      @default(0)
  /// Match-Kanaele ueberhaupt anlegen?
  createMatchChannels        Boolean  @default(true)

  // --- Livestream --------------------------------------------------------
  twitchUrl  String?
  youtubeUrl String?
  streamUrl  String?

  // --- Eignung -----------------------------------------------------------
  /// Rolle, ohne die niemand teilnehmen darf.
  requiredRoleId  String?
  /// Mindest-Level aus dem Level-System. 0 = keine Bedingung.
  minLevel        Int     @default(0)
  /// Nur mit laufendem Premium-Abo.
  requiresPremium Boolean @default(false)

  publishedAt  DateTime?
  startedAt    DateTime?
  pausedAt     DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  archivedAt   DateTime?

  createdByDiscordId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staff         TournamentStaff[]
  stages        TournamentStage[]
  groups        TournamentGroup[]
  registrations TournamentRegistration[]
  teams         TournamentTeam[]
  invites       TournamentTeamInvite[]
  matches       TournamentMatch[]
  prizes        TournamentPrize[]
  announcements TournamentAnnouncement[]
  resources     TournamentResource[]
  customFields  TournamentCustomField[]
  events        TournamentEvent[]
  disputes      TournamentDispute[]
  participants  TournamentParticipant[]

  @@unique([guildId, slug])
  @@index([guildId, status, startsAt])
  @@index([guildId, gameId])
  @@index([status, registrationClosesAt])
  @@index([status, checkinClosesAt])
  @@index([status, startsAt])
}

/// Wer dieses eine Turnier betreut.
///
/// Bewusst je Turnier und nicht nur ueber das zentrale Rechtesystem: jemand
/// kann Turnier A leiten und bei Turnier B blosser Teilnehmer sein.
model TournamentStaff {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  discordId String
  username  String
  role      TournamentStaffRole @default(REFEREE)

  addedByDiscordId String?
  createdAt        DateTime @default(now())

  @@unique([tournamentId, discordId])
  @@index([discordId])
}

/// Ein Abschnitt: Gruppenphase, Winner-Bracket, Loser-Bracket, Finale.
model TournamentStage {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  kind       TournamentStageKind
  name       String
  /// Reihenfolge der Abschnitte.
  sortOrder  Int                 @default(0)
  /// Wie viele Runden dieser Abschnitt hat.
  roundCount Int                 @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  groups  TournamentGroup[]
  matches TournamentMatch[]

  @@unique([tournamentId, kind, sortOrder])
  @@index([tournamentId, sortOrder])
}

model TournamentGroup {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stageId      String
  stage        TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())

  members TournamentGroupMember[]
  matches TournamentMatch[]

  @@unique([stageId, name])
  @@index([tournamentId])
}

/// Wer in welcher Gruppe steht. Die Tabelle selbst wird aus den Matches
/// gerechnet - hier steht nur die Zugehoerigkeit.
model TournamentGroupMember {
  id      String          @id @default(cuid())
  groupId String
  group   TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  participantId String
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([groupId, participantId])
  @@index([participantId])
}

/// Wer antritt - eine Person bei SOLO, ein Team bei TEAM.
///
/// Ein gemeinsames Modell, damit Bracket und Match nicht zwei Arten von
/// Gegnern kennen muessen. Ohne diese Zwischenschicht traegt jedes Match zwei
/// Fremdschluessel je Modus, und jede Abfrage muss beide Faelle unterscheiden.
model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// Bei SOLO gesetzt.
  discordId String?
  username  String?

  /// Bei TEAM gesetzt.
  teamId String?         @unique
  team   TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// Setzplatz im Bracket. `null`, solange nicht gesetzt.
  seed Int?

  /// Ausgeschieden, disqualifiziert oder zurueckgezogen.
  eliminatedAt DateTime?
  /// Endplatzierung; erst nach Turnierende gesetzt.
  placement    Int?

  createdAt DateTime @default(now())

  registration TournamentRegistration?
  groupMembers TournamentGroupMember[]
  matchesAsA   TournamentMatch[]       @relation("MatchParticipantA")
  matchesAsB   TournamentMatch[]       @relation("MatchParticipantB")
  matchesWon   TournamentMatch[]       @relation("MatchWinner")
  matchesLost  TournamentMatch[]       @relation("MatchLoser")

  @@unique([tournamentId, discordId])
  @@index([tournamentId, seed])
  @@index([tournamentId, placement])
}

model TournamentRegistration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// Wer angemeldet hat - bei Teams der Captain.
  discordId String
  username  String

  /// Bei SOLO gesetzt; bei TEAM steht die Anmeldung am Team.
  participantId String?                @unique
  participant   TournamentParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  /// Eindeutig, weil ein Team genau eine Anmeldung hat. Mehrere NULL-Werte
  /// bleiben erlaubt - Einzelanmeldungen tragen hier nichts.
  teamId String?         @unique
  team   TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  status           TournamentRegistrationStatus @default(PENDING)
  /// Position in der Warteliste; `null`, wenn nicht auf der Warteliste.
  waitlistPosition Int?

  checkinStatus TournamentCheckinStatus @default(NOT_REQUIRED)
  checkedInAt   DateTime?
  checkedInBy   String?

  rulesAcceptedAt DateTime?
  rulesVersion    Int?

  /// Grund einer Ablehnung oder Absage.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses TournamentCustomFieldResponse[]

  @@unique([tournamentId, discordId])
  @@index([tournamentId, status])
  @@index([tournamentId, status, waitlistPosition])
  @@index([tournamentId, checkinStatus])
  @@index([discordId])
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name    String
  tag     String?
  logoUrl String?

  captainDiscordId String
  captainUsername  String

  status TournamentTeamStatus @default(FORMING)

  /// Nach dem Roster Lock von der Verwaltung ausdruecklich geoeffnet.
  rosterUnlockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      TournamentTeamMember[]
  invites      TournamentTeamInvite[]
  registration TournamentRegistration?
  participant  TournamentParticipant?

  @@unique([tournamentId, name])
  @@index([tournamentId, status])
  @@index([captainDiscordId])
}

model TournamentTeamMember {
  id     String         @id @default(cuid())
  teamId String
  team   TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  discordId String
  username  String
  role      TournamentTeamMemberRole @default(PLAYER)

  joinedAt  DateTime  @default(now())
  /// Entfernt, aber im Verlauf erhalten.
  removedAt DateTime?

  @@unique([teamId, discordId])
  @@index([discordId])
}

model TournamentTeamInvite {
  id           String         @id @default(cuid())
  tournamentId String
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  discordId String
  username  String
  role      TournamentTeamMemberRole @default(PLAYER)

  status TournamentInviteStatus @default(PENDING)

  invitedByDiscordId String
  createdAt          DateTime  @default(now())
  respondedAt        DateTime?
  expiresAt          DateTime?

  @@index([teamId, status])
  @@index([discordId, status])
  @@index([tournamentId, status])
}

model TournamentMatch {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stageId      String
  stage        TournamentStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Fortlaufende Nummer je Turnier - das, was Teilnehmer nennen.
  matchNumber Int
  round       Int
  /// Platz innerhalb der Runde. Zusammen mit `round` eindeutig je Abschnitt.
  position    Int

  participantAId String?
  participantA   TournamentParticipant? @relation("MatchParticipantA", fields: [participantAId], references: [id], onDelete: SetNull)
  participantBId String?
  participantB   TournamentParticipant? @relation("MatchParticipantB", fields: [participantBId], references: [id], onDelete: SetNull)

  /// Wohin der Sieger geht. Ohne diese Verweise muesste das Weiterkommen die
  /// Bracket-Form jedes Mal neu ausrechnen - und zwei Stellen, die dasselbe
  /// ausrechnen, sind irgendwann uneinig.
  winnerToMatchId String?
  /// A oder B im Zielmatch.
  winnerToSlot    String?
  /// Bei Double Elimination: wohin der Verlierer faellt.
  loserToMatchId  String?
  loserToSlot     String?

  status TournamentMatchStatus @default(PENDING)
  bestOf Int                   @default(1)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  scoreA Int @default(0)
  scoreB Int @default(0)

  winnerId String?
  winner   TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loserId  String?
  loser    TournamentParticipant? @relation("MatchLoser", fields: [loserId], references: [id], onDelete: SetNull)

  resultReason TournamentResultReason @default(PLAYED)

  /// Bereitmeldung beider Seiten vor dem Start.
  readyA Boolean @default(false)
  readyB Boolean @default(false)

  discordChannelId String?
  /// Der Kanal fehlt auf Discord. Vom Abgleich gesetzt.
  channelMissing   Boolean @default(false)

  streamStatus TournamentStreamStatus @default(NOT_STREAMED)
  streamUrl    String?
  vodUrl       String?
  highlightUrl String?

  /// Interne Notiz der Verwaltung - fuer Teilnehmer nie sichtbar.
  staffNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games       TournamentMatchGame[]
  submissions TournamentResultSubmission[]
  disputes    TournamentDispute[]
  casters     TournamentMatchCaster[]

  @@unique([tournamentId, matchNumber])
  @@unique([stageId, round, position])
  @@unique([discordChannelId])
  @@index([tournamentId, status])
  @@index([tournamentId, scheduledAt])
  @@index([stageId, round])
  @@index([status, scheduledAt])
}

/// Eine einzelne Map oder Partie innerhalb eines Matches.
model TournamentMatchGame {
  id      String          @id @default(cuid())
  matchId String
  match   TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /// 1-basiert: Map 1, Map 2, ...
  index Int
  map   String?

  scoreA     Int     @default(0)
  scoreB     Int     @default(0)
  /// A, B oder null bei unentschieden.
  winnerSlot String?

  @@unique([matchId, index])
}

/// Eine gemeldete Resultatfassung.
///
/// Bewusst mehrere Meldungen je Match statt eines Feldes: erst wenn zwei
/// Seiten dasselbe sagen, ist ein Resultat gueltig. Ohne die einzelnen
/// Meldungen liesse sich hinterher nicht mehr zeigen, wer was gemeldet hat.
model TournamentResultSubmission {
  id      String          @id @default(cuid())
  matchId String
  match   TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /// A oder B - fuer welche Seite gemeldet wurde.
  slot String

  reportedByDiscordId String
  reportedByUsername  String

  scoreA Int
  scoreB Int
  reason TournamentResultReason @default(PLAYED)
  /// Map-Ergebnisse als Liste von {index, map, scoreA, scoreB}.
  games  Json                   @default("[]")

  comment      String?
  evidenceUrl  String?
  /// Dateiname im Speicher - nie der Pfad.
  evidenceFile String?

  /// Von der Gegenseite bestaetigt.
  confirmedAt          DateTime?
  confirmedByDiscordId String?
  /// Von der Gegenseite bestritten.
  rejectedAt           DateTime?

  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@index([matchId, slot])
}

model TournamentDispute {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String
  match        TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  openedByDiscordId String
  openedByUsername  String
  reason            String @db.Text

  status TournamentDisputeStatus @default(OPEN)

  /// Nur fuer die Verwaltung.
  staffNote String? @db.Text

  resolvedByDiscordId String?
  resolvedAt          DateTime?
  resolution          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId, status])
  @@index([matchId])
}

/// Wer ein Match kommentiert oder beobachtet.
model TournamentMatchCaster {
  id      String          @id @default(cuid())
  matchId String
  match   TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  discordId String
  username  String
  /// CASTER, OBSERVER oder HOST.
  role      String @default("CASTER")

  createdAt DateTime @default(now())

  @@unique([matchId, discordId])
}

model TournamentPrize {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// 1 = Sieger, 2 = Zweiter, ...
  placement      Int
  title          String
  description    String?
  /// Freitext statt Betrag: der Preis kann Geld, Hardware oder eine Rolle sein.
  value          String?
  sponsorName    String?
  sponsorUrl     String?
  sponsorLogoUrl String?

  status TournamentPrizeStatus @default(PENDING)

  /// Wer ihn bekommen hat - erst nach dem Turnier bekannt.
  awardedParticipantId String?
  awardedAt            DateTime?
  deliveredAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, placement])
  @@index([tournamentId])
}

/// Eine gesendete Turnier-Ankuendigung.
///
/// Der Versand selbst laeuft ueber das Kommunikationsmodul; hier steht nur,
/// welche Ankuendigung fuer dieses Turnier bereits hinausging. Sonst schickte
/// ein zweimal laufender Zeitgeber dieselbe Erinnerung zweimal.
model TournamentAnnouncement {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  /// Kennung der Art, z.B. REGISTRATION_OPEN oder ROUND_START:2.
  kind String

  channelId              String?
  discordMessageId       String?
  /// Verweis auf den Eintrag im Kommunikationsverlauf.
  communicationMessageId String?

  sentByDiscordId String?
  sentAt          DateTime @default(now())

  @@unique([tournamentId, kind])
  @@index([tournamentId, sentAt])
}

/// Was das Turniermodul auf Discord selbst angelegt hat.
///
/// Nur was hier steht, wird spaeter auch wieder entfernt. Ohne diese Liste
/// muesste das Aufraeumen raten, welcher Kanal zum Turnier gehoert - und
/// loeschte irgendwann einen, der jemand anderem gehoert.
model TournamentResource {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  kind      TournamentResourceKind
  discordId String
  /// Bei Nachrichten der Kanal, in dem sie steht.
  parentId  String?
  label     String?

  createdAt    DateTime  @default(now())
  removedAt    DateTime?
  /// Auf Discord nicht mehr auffindbar. Vom Abgleich gesetzt.
  missingSince DateTime?

  @@unique([tournamentId, kind, discordId])
  @@index([tournamentId, kind])
}

/// Zusaetzliche Frage im Anmeldeformular.
model TournamentCustomField {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  kind        TournamentCustomFieldKind @default(SHORT_TEXT)
  label       String
  description String?
  placeholder String?
  required    Boolean                   @default(false)
  /// Auswahlmoeglichkeiten bei SELECT.
  options     String[]                  @default([])
  maxLength   Int?
  sortOrder   Int                       @default(0)

  createdAt DateTime @default(now())

  responses TournamentCustomFieldResponse[]

  @@index([tournamentId, sortOrder])
}

model TournamentCustomFieldResponse {
  id      String                @id @default(cuid())
  fieldId String
  field   TournamentCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  registrationId String
  registration   TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  value String @db.Text

  @@unique([fieldId, registrationId])
  @@index([registrationId])
}

model TournamentEvent {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  kind TournamentEventKind

  actorDiscordId String?
  actorUsername  String?
  /// WEBAPP, DISCORD oder SYSTEM.
  actorSource    String  @default("SYSTEM")

  detail Json @default("{}")

  createdAt DateTime @default(now())

  @@index([tournamentId, createdAt])
  @@index([tournamentId, kind])
}

/// Fortlaufende Matchnummern je Turnier.
///
/// Dieselbe Ueberlegung wie beim Ticketzaehler: `MAX+1` verliert das Rennen,
/// sobald zwei Vorgaenge gleichzeitig ein Match anlegen.
model TournamentMatchCounter {
  tournamentId String @id
  lastNumber   Int    @default(0)

  updatedAt DateTime @updatedAt
}

/// Wer von der Teilnahme ausgeschlossen ist.
///
/// Ausdruecklich nicht dasselbe wie ein Discord-Bann: jemand darf im Server
/// bleiben und trotzdem an keinem Turnier mehr teilnehmen.
model TournamentBlockEntry {
  id      String @id @default(cuid())
  guildId String

  discordId String
  username  String?
  reason    String

  blockedByDiscordId String
  createdAt          DateTime  @default(now())
  expiresAt          DateTime?
  liftedAt           DateTime?

  @@index([guildId, discordId, liftedAt])
}

// ---------------------------------------------------------------------------
// Voice Hub
// ---------------------------------------------------------------------------
//
// Ein temporaerer Sprachkanal lebt an zwei Orten: als Discord-Kanal und als
// Zeile hier. Der Discord-Kanal ist verletzlich - jemand loescht ihn von Hand,
// der Bot startet neu, Discord ist kurz weg. Deshalb ist die Zeile die
// Wahrheit, und der Abgleich bringt Discord wieder auf ihren Stand.
//
// Die Zeile wird nicht geloescht, wenn der Kanal verschwindet, sondern mit
// `closedAt` geschlossen. Das kostet wenig und liefert die Statistik ohne
// zweite Tabelle - und ohne Statistik liesse sich nie beantworten, ob das
// Modul ueberhaupt benutzt wird.

/// Welches Modul den Kanal erzeugt hat.
///
/// Die Engine gehoert keinem Modul allein. Ohne diese Angabe wuesste der
/// Abgleich nicht, wessen Kanal er da vor sich hat - und wer ihn aufraeumen
/// darf.
enum TemporaryVoiceSource {
  VOICE_HUB
  PLAYER_SEARCH
  TOURNAMENT
  EVENT
  OTHER
}

/// Persoenliche Ausnahme in einem temporaeren Kanal.
enum VoiceAccessKind {
  ALLOW
  DENY
}

enum VoiceHubEventKind {
  VOICE_CREATED
  VOICE_DELETED
  VOICE_RENAMED
  VOICE_LIMIT_CHANGED
  VOICE_LOCKED
  VOICE_UNLOCKED
  VOICE_HIDDEN
  VOICE_SHOWN
  MEMBER_ALLOWED
  MEMBER_DENIED
  MEMBER_KICKED
  OWNER_TRANSFERRED
  OWNER_AUTO_TRANSFERRED
}

/// Vorlage fuer neue Talks.
///
/// Ein Hub verweist auf genau ein Preset. Mehrere Hubs koennen dasselbe
/// verwenden - «Duo» und «Duo (Premium)» unterscheiden sich sonst nur darin,
/// wer sie betreten darf.
model VoicePreset {
  id      String @id @default(cuid())
  guildId String

  name         String
  /// Vorlage des Kanalnamens, z.B. `🔊 {username} Stübli`.
  nameTemplate String @default("🔊 {username} Stübli")

  /// Teilnehmerlimit neuer Talks; 0 = unbegrenzt (Discord-Semantik).
  userLimit    Int  @default(0)
  /// Hoechstwert, den der Besitzer selbst setzen darf.
  maxUserLimit Int  @default(99)
  /// Bitrate in bit/s; `null` uebernimmt die Voreinstellung des Servers.
  bitrate      Int?

  lockedDefault Boolean @default(false)
  hiddenDefault Boolean @default(false)

  /// Kategorie, in der Talks dieses Presets entstehen.
  /// `null` = die Kategorie des Hubs.
  targetCategoryId String?

  /// Nur diese Rollen duerfen Talks aus diesem Preset erzeugen. Leer = alle.
  allowedRoleIds String[] @default([])
  /// Diese Rollen duerfen es nicht - gewinnt gegen `allowedRoleIds`.
  blockedRoleIds String[] @default([])

  /// Wie lange ein leerer Talk bestehen bleibt, bevor er geloescht wird.
  ///
  /// Nicht null: eine kurze Verbindungsstoerung soll den Talk nicht zerstoeren,
  /// waehrend die Gruppe noch redet.
  deleteGraceSeconds Int @default(30)

  /// Mindestabstand zwischen zwei Umbenennungen.
  ///
  /// Discord begrenzt Kanalumbenennungen sehr eng (zwei je zehn Minuten).
  /// Ohne eigene Bremse liefe die Anwendung in ein Discord-Rate-Limit, das
  /// alle anderen Kanalaenderungen mitblockiert.
  renameCooldownSeconds Int @default(300)

  /// Darf der Besitzer im eigenen Talk stummschalten und verschieben?
  ownerModeration Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hubs     VoiceHub[]
  channels TemporaryVoiceChannel[]

  @@unique([guildId, name])
  @@index([guildId, sortOrder])
}

/// Ein permanenter Sprachkanal, dessen Betreten einen Talk erzeugt.
model VoiceHub {
  id      String @id @default(cuid())
  guildId String

  name             String
  /// Der Discord-Kanal, den man betritt. Je Kanal genau ein Hub.
  discordChannelId String @unique

  /// Kategorie, in der die Talks entstehen.
  targetCategoryId   String
  /// Ausweichkategorie, wenn die erste voll ist (Discord: 50 Kanaele).
  overflowCategoryId String?

  presetId String
  preset   VoicePreset @relation(fields: [presetId], references: [id])

  allowedRoleIds String[] @default([])
  blockedRoleIds String[] @default([])

  enabled   Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels TemporaryVoiceChannel[]

  @@unique([guildId, name])
  @@index([guildId, enabled])
}

/// Ein temporaerer Sprachkanal.
///
/// Eine Zeile ohne `discordChannelId` ist eine Reservierung: sie entsteht,
/// bevor Discord gefragt wird, und haelt den Platz. Ohne sie erzeugten zwei
/// schnell aufeinanderfolgende Beitritte zwei Kanaele - Discord schickt das
/// Ereignis durchaus mehrfach.
model TemporaryVoiceChannel {
  id      String @id @default(cuid())
  guildId String

  /// Erst gesetzt, wenn Discord den Kanal angelegt hat.
  discordChannelId String? @unique

  hubId String?
  hub   VoiceHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)

  presetId String?
  preset   VoicePreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  source      TemporaryVoiceSource @default(VOICE_HUB)
  /// Fremdschluessel des erzeugenden Moduls, z.B. die Kennung einer
  /// Spielersuche. Bewusst nur ein Text: die Engine kennt die Tabellen der
  /// Module nicht und soll es auch nicht.
  externalRef String?

  ownerDiscordId String
  ownerUsername  String
  /// Gesetzt, seit der Besitzer den Kanal verlassen hat - Grundlage der
  /// Schonfrist, bevor jemand anderes uebernimmt.
  ownerLeftAt    DateTime?

  name      String
  userLimit Int     @default(0)
  bitrate   Int?
  locked    Boolean @default(false)
  hidden    Boolean @default(false)
  /// Frei gesetztes Spiel/Thema. Nur Metadatum, keine Discord-Aktivitaet.
  gameName  String?

  /// Nachricht mit dem Bedienfeld im Textchat des Sprachkanals.
  controlMessageId String?

  /// Letzte Umbenennung - Grundlage der Abkuehlzeit.
  lastRenamedAt DateTime?

  /// Faellig zum Loeschen, weil der Kanal leer ist.
  ///
  /// Bewusst ein Zeitpunkt in der Datenbank und kein `setTimeout`: ein
  /// Zeitgeber im Arbeitsspeicher ueberlebt keinen Neustart, und ein leerer
  /// Kanal bliebe fuer immer stehen.
  deleteScheduledAt DateTime?

  /// Groesste gleichzeitige Teilnehmerzahl - fuer die Statistik.
  peakMembers Int @default(1)

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  /// Gesetzt, sobald der Kanal weg ist. Die Zeile bleibt fuer die Statistik.
  closedAt     DateTime?

  /// Gesetzt, solange ein Talk aus einem Hub offen ist - die Discord-Kennung
  /// seines Besitzers. Zusammen mit der Eindeutigkeit unten begrenzt das die
  /// Zahl gleichzeitiger Talks je Person und Hub auf Datenbankebene: zwei
  /// Beitritte im selben Augenblick koennen nicht beide einen Kanal anlegen.
  ///
  /// Nur fuer Talks mit `hubId`. Ein Kanal der Spielersuche laesst den Wert
  /// leer - dort entscheidet die Spielersuche, wie viele Suchen jemand
  /// gleichzeitig laufen lassen darf.
  ///
  /// Der Wert wandert bei einer Uebergabe mit. Bliebe er beim Erzeuger,
  /// widerspraeche die Datenbank dem Beitritt: der prueft, ob jemand hier
  /// schon einen Talk *besitzt*, und ein Erzeuger, der laengst uebergeben
  /// hat, bekaeme beim naechsten Beitritt "Du hast hier bereits einen Talk"
  /// zu lesen, obwohl er keinen besitzt. Der Preis ist die Kehrseite: eine
  /// Uebergabe an jemanden, der im selben Hub schon einen Talk hat, schlaegt
  /// fehl - aber das ist die Wahrheit und keine Falschmeldung.
  ///
  /// Beim Schliessen wird der Wert geleert; mehrere NULL verletzen eine
  /// Eindeutigkeit nicht, geschlossene Zeilen bleiben also liegen.
  ///
  /// Dieselbe Bauart wie `SpielersucheMatch.activeCreatorKey`. Ein Teilindex
  /// waere ausdrucksstaerker, aber Prisma kennt ihn in der Schemasprache
  /// nicht - er waere fuer `prisma db push` unsichtbar und fuer
  /// `migrate dev` eine Abweichung.
  activeOwnerKey String?

  access TemporaryVoiceAccess[]

  @@unique([guildId, hubId, activeOwnerKey])
  @@index([guildId, closedAt])
  @@index([guildId, ownerDiscordId, closedAt])
  @@index([deleteScheduledAt])
  @@index([hubId])
  @@index([source, closedAt])
  @@index([guildId, createdAt])
}

/// Persoenliche Ausnahme fuer einen einzelnen Talk.
model TemporaryVoiceAccess {
  id        String                @id @default(cuid())
  channelId String
  channel   TemporaryVoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  discordId String
  username  String?
  kind      VoiceAccessKind

  createdAt DateTime @default(now())

  @@unique([channelId, discordId])
  @@index([channelId, kind])
}

/// Was jemand fuer seine eigenen Talks bevorzugt.
///
/// Ausdruecklich freiwillig: ohne `applyPreferences` wird nichts uebernommen.
/// Eine Anwendung, die sich merkt, wie jemand seinen Kanal nennt, soll das
/// tun, weil er es will - nicht, weil es geht.
model VoiceUserPreference {
  id      String @id @default(cuid())
  guildId String

  discordId String

  preferredName    String?
  preferredLimit   Int?
  preferredBitrate Int?

  /// Werden die Vorgaben beim naechsten Talk angewendet?
  applyPreferences Boolean @default(false)
  /// Duerfen die Vertrauenspersonen jeden neuen Talk betreten?
  autoAllowTrusted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, discordId])
}

/// Wem jemand dauerhaft Zutritt zu seinen Talks gibt.
model VoiceTrustedMember {
  id      String @id @default(cuid())
  guildId String

  ownerDiscordId String
  discordId      String
  username       String?

  createdAt DateTime @default(now())

  @@unique([guildId, ownerDiscordId, discordId])
  @@index([guildId, ownerDiscordId])
}

/// Was mit einem Talk geschehen ist.
///
/// Bewusst nicht jedes Betreten und Verlassen: das waere eine Bewegungsakte
/// jedes Mitglieds und niemand braeuchte sie. Festgehalten wird, was den Talk
/// selbst veraendert.
model VoiceHubEvent {
  id      String @id @default(cuid())
  guildId String

  /// Kann fehlen: der Kanal ist vielleicht schon weg.
  channelId String?
  hubId     String?

  kind VoiceHubEventKind

  actorDiscordId  String?
  targetDiscordId String?
  detail          Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([channelId, createdAt])
  @@index([guildId, kind, createdAt])
}

/// Interne Notiz zu einem Mitglied.
///
/// Das einzige, was das Member Center selbst speichert. Alles andere - Level,
/// Tickets, Turniere, Premium, Moderation - bleibt beim jeweiligen Modul; das
/// Member Center fuehrt es nur zusammen. Eine Kopie dieser Daten waere eine
/// zweite Wahrheit, die irgendwann von der ersten abweicht.
///
/// Notizen sind ausdruecklich intern: sie sind fuer das betroffene Mitglied
/// nicht sichtbar, auch nicht im eigenen Profil.
model MemberNote {
  id      String @id @default(cuid())
  guildId String

  /// Die Person, um die es geht.
  targetDiscordId String
  /// Wer die Notiz geschrieben hat - immer aus der Sitzung, nie aus der
  /// Eingabe.
  authorDiscordId String
  /// Anzeigename des Autors zum Zeitpunkt des Schreibens.
  ///
  /// Bewusst mitgefuehrt: wer den Server verlaesst, ist bei Discord nicht mehr
  /// abfragbar, und eine Notiz ohne erkennbaren Absender ist wertlos.
  authorUsername  String

  content String

  /// Freie Einordnung, z.B. «Verhalten» oder «Support».
  category String?
  /// Angeheftete Notizen stehen oben.
  pinned   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Gesetzt, sobald jemand den Text geaendert hat - `updatedAt` allein sagt
  /// das nicht, es wandert auch beim Anheften.
  editedAt  DateTime?

  @@index([guildId, targetDiscordId, createdAt])
  @@index([guildId, targetDiscordId, pinned, createdAt])
  @@index([authorDiscordId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Analytics: das Ereignisprotokoll des Discord-Servers
// ---------------------------------------------------------------------------

/// Grobe Einordnung eines Ereignisses. Die Oberflaeche filtert danach; der
/// feine Typ steht als String daneben, damit eine neue Ereignisart keinen
/// Enum-Umbau erzwingt.
enum DiscordEventCategory {
  MESSAGE
  VOICE
  MEMBER
  ROLE
  CHANNEL
  SERVER
}

/// Wie schwer ein Ereignis wiegt. Entscheidet ueber Farbe und Vorauswahl in
/// der Zeitleiste, nicht ueber die Aufbewahrung.
enum DiscordEventSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

/// Woher die Zuordnung des Verursachers stammt.
///
/// Der wichtigste Wert ist `UNKNOWN`: Discord nennt bei einer geloeschten
/// Nachricht nicht, wer sie geloescht hat. Wer das aus dem Audit Log errät,
/// schreibt eine Vermutung in ein Protokoll - und ein Protokoll, das raet,
/// ist schlimmer als keines.
enum DiscordActorSource {
  /// Das Gateway-Ereignis nennt den Verursacher selbst.
  GATEWAY
  /// Aus Discords Audit Log korreliert - Ziel und Zeitpunkt passten eindeutig.
  AUDIT_LOG
  /// Aus einer Aktion dieser Anwendung - wir waren es selbst.
  WEBAPP
  /// Nicht zuzuordnen. Keine Vermutung.
  UNKNOWN
}

model DiscordEvent {
  id       String               @id @default(cuid())
  /// Strikte Trennung nach Server. Jede Abfrage filtert danach.
  guildId  String
  category DiscordEventCategory
  /// Feiner Typ, z.B. `MESSAGE_DELETE`, `VOICE_MOVE`, `MEMBER_ROLE_ADD`.
  type     String
  severity DiscordEventSeverity @default(INFO)

  /// Wer es ausgeloest hat - NULL, wenn nicht sicher zuzuordnen.
  actorDiscordId String?
  actorUsername  String?
  actorSource    DiscordActorSource @default(UNKNOWN)

  /// Wen es betrifft. Bei einer Nachricht ihr Verfasser, bei einem Kick der
  /// Gekickte. Oft, aber nicht immer, verschieden vom Verursacher.
  subjectDiscordId String?
  subjectUsername  String?

  channelId   String?
  /// Kanalname zum Zeitpunkt des Ereignisses - ein umbenannter oder
  /// geloeschter Kanal macht das Protokoll sonst unlesbar.
  channelName String?
  messageId   String?

  /// Inhalt vor und nach der Aenderung.
  ///
  /// Beide nullbar: bei einer geloeschten Nachricht gibt es kein «nachher»,
  /// und ohne Message-Content-Intent gibt es gar keinen Inhalt. Leerer Text
  /// und «wir wissen es nicht» sind verschiedene Dinge.
  contentBefore String?
  contentAfter  String?

  /// Verweis auf eine Massnahme, die diese Anwendung selbst ausgeloest hat.
  ///
  /// Ohne ihn erschiene ein Bann aus dem Dashboard zweimal: einmal als
  /// Moderationsvorgang und einmal als Discord-Ereignis. Die Zeitleiste
  /// erkennt daran, dass es dasselbe Geschehen ist.
  moderationActionId String?

  /// Sammel-Loeschung: alle Zeilen eines Vorgangs teilen sich diese Kennung.
  bulkId String?

  metadata   Json     @default("{}")
  /// Zeitpunkt bei Discord. `createdAt` ist der Zeitpunkt der Aufnahme - bei
  /// einem Rueckstand nach einem Neustart liegen die beiden auseinander.
  occurredAt DateTime
  createdAt  DateTime @default(now())

  medien DiscordEventMedia[]

  @@index([guildId, occurredAt])
  @@index([guildId, category, occurredAt])
  @@index([guildId, type, occurredAt])
  @@index([guildId, actorDiscordId, occurredAt])
  @@index([guildId, subjectDiscordId, occurredAt])
  @@index([guildId, channelId, occurredAt])
  @@index([guildId, messageId])
  @@index([bulkId])
  @@index([moderationActionId])
}

/// Der letzte bekannte Stand einer Nachricht.
///
/// Discord liefert beim Loeschen und oft auch beim Bearbeiten nur die
/// Kennung, nicht den alten Text. Ohne diesen Stand stuende im Protokoll
/// «Nachricht geloescht» ohne zu sagen, welche - eine Zeile, die nichts
/// beantwortet.
model DiscordMessageSnapshot {
  messageId String @id
  guildId   String
  channelId String

  authorDiscordId String
  authorUsername  String

  content          String
  attachmentCount  Int     @default(0)
  /// Antwort auf welche Nachricht - macht einen Verlauf lesbar.
  replyToMessageId String?

  /// Zeitpunkt bei Discord.
  postedAt  DateTime
  updatedAt DateTime @updatedAt

  @@index([guildId, postedAt])
  @@index([guildId, channelId, postedAt])
  @@index([guildId, authorDiscordId, postedAt])
}

/// Eine archivierte Datei zu einem Ereignis.
///
/// Die Datei liegt ausserhalb des oeffentlichen Verzeichnisses und ist nur
/// ueber eine berechtigungsgepruefte Route erreichbar. `storageKey` wird
/// serverseitig erzeugt - der Name von Discord waere erratbar und koennte
/// alles Moegliche enthalten.
model DiscordEventMedia {
  id      String       @id @default(cuid())
  eventId String
  event   DiscordEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  guildId String

  /// Serverseitig erzeugter Dateiname im geschuetzten Verzeichnis.
  storageKey  String @unique
  /// Anzeigename fuer den Download - nur Anzeige, nie ein Pfad.
  displayName String
  mimeType    String
  byteSize    Int
  /// Inhaltsadresse: erkennt dieselbe Datei in mehreren Ereignissen.
  sha256      String

  /// Wann die Datei geloescht wird. Es gibt keine unbegrenzte Aufbewahrung.
  expiresAt DateTime
  /// Gesetzt, sobald die Datei tatsaechlich vom Datentraeger verschwunden ist.
  /// Der Eintrag bleibt: «es gab hier eine Datei» ist eine Auskunft, die
  /// erhalten bleiben soll.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([expiresAt, deletedAt])
  @@index([sha256])
}

// ---------------------------------------------------------------------------
// Analytics: Statistik
// ---------------------------------------------------------------------------
//
// Die Zeitleiste beantwortet «was ist geschehen». Die Statistik beantwortet
// «wie entwickelt sich der Server» - und das ist eine andere Frage an
// dieselben Daten. Sie über die Ereignistabelle zu rechnen hiesse, bei jedem
// Seitenaufruf Millionen Zeilen zu lesen; deshalb entstehen die Zahlen beim
// Aufzeichnen und werden hier fortgeschrieben.
//
// Alle Tagesangaben sind Kalendertage in Europe/Zurich. Gespeichert als
// reines Datum, damit der Sommerzeitwechsel keinen 23- oder 25-Stunden-Tag
// in eine falsche Schublade legt.

/// Text- oder Sprachkanal. Beides zählt anders: Nachrichten bzw. Sekunden.
enum AnalyticsChannelKind {
  TEXT
  VOICE
}

/// Seit wann gezählt wird.
///
/// Das Wichtigste an der ganzen Statistik. Ohne diesen Zeitpunkt sähe eine
/// Null aus wie «es ist nichts passiert», obwohl sie «wir haben damals noch
/// nicht gezählt» heisst. Die Oberfläche schreibt ihn deshalb überall dazu.
///
/// Die drei Zeitpunkte sind absichtlich getrennt: das Ereignisprotokoll gab
/// es vor der Statistik, und Nachrichten wurden von Anfang an nicht gezählt.
/// Ein gemeinsamer Beginn wäre für zwei der drei Zahlen gelogen.
model AnalyticsTracking {
  guildId String @id

  /// Beginn des Ereignisprotokolls.
  startedAt       DateTime  @default(now())
  /// Ab wann Nachrichten gezählt werden.
  messagesSince   DateTime?
  /// Ab wann Sprachzeit gemessen wird.
  voiceSince      DateTime?
  /// Bis wohin der einmalige Backfill aus dem Ereignisprotokoll gelaufen ist.
  backfilledUntil DateTime?

  updatedAt DateTime @updatedAt
}

/// Ein Abschnitt Anwesenheit in genau einem Sprachkanal.
///
/// Bewusst Abschnitte statt einer Sitzung pro Kanal: wer den Kanal wechselt,
/// bleibt auf dem Server im Gespräch - die Sitzung läuft weiter, nur der
/// Kanal ändert sich. `sessionId` klammert die Abschnitte einer
/// durchgehenden Anwesenheit; die Kanalstatistik summiert die Abschnitte,
/// die Sitzungsstatistik gruppiert nach `sessionId`.
///
/// `leftAt = null` heisst: die Person sitzt gerade drin. Solche Abschnitte
/// zählen in laufenden Kennzahlen mit, gehen aber erst beim Verlassen in die
/// Tages- und Stundenwerte ein - sonst wüchse ein abgeschlossener Tag noch
/// nachträglich.
model AnalyticsVoiceSegment {
  id        String @id @default(cuid())
  guildId   String
  sessionId String

  discordId String
  /// Mitgeführt, damit ein späterer Wechsel der Einstellung die Vergangenheit
  /// nicht umschreibt.
  isBot     Boolean @default(false)

  channelId   String
  channelName String?
  /// Übergeordnete Kategorie - fasst die vielen temporären Talks zusammen.
  parentId    String?
  /// Zeit im AFK-Kanal ist Anwesenheit, aber keine Aktivität.
  isAfk       Boolean @default(false)

  joinedAt DateTime
  leftAt   DateTime?
  /// Erst beim Verlassen gesetzt. NULL heisst «läuft noch», nicht «null Sekunden».
  seconds  Int?

  @@index([guildId, discordId, joinedAt])
  @@index([guildId, channelId, joinedAt])
  @@index([guildId, joinedAt])
  @@index([guildId, leftAt])
  @@index([sessionId])
}

/// Stundenwerte des Servers - für Tagesverläufe und die Heatmap.
model AnalyticsHourly {
  guildId   String
  /// Beginn der Stunde in UTC. Zürich liegt auf vollen Stunden zu UTC,
  /// deshalb decken sich die Stundengrenzen.
  hourStart DateTime

  messages      Int @default(0)
  voiceSeconds  Int @default(0)
  voiceSessions Int @default(0)
  joins         Int @default(0)
  leaves        Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([guildId, hourStart])
  @@index([guildId, hourStart])
}

/// Tageswerte des Servers.
model AnalyticsDaily {
  guildId String
  /// Kalendertag in Europe/Zurich.
  day     DateTime @db.Date

  messages      Int @default(0)
  voiceSeconds  Int @default(0)
  voiceSessions Int @default(0)
  joins         Int @default(0)
  leaves        Int @default(0)

  /// Mitgliederzahl am Ende des Tages.
  ///
  /// Eine Momentaufnahme, keine Summe - Mitgliederzahlen addieren sich nicht.
  /// NULL an Tagen, an denen keine Aufnahme gelang.
  memberCount Int?

  updatedAt DateTime @updatedAt

  @@id([guildId, day])
  @@index([guildId, day])
}

/// Tageswerte je Mitglied.
///
/// Grundlage der Ranglisten und - wichtiger - der eindeutigen aktiven
/// Mitglieder: die Zahl für einen Monat ist nicht die Summe der Tageswerte,
/// sondern die Anzahl verschiedener Personen darin. Genau dafür liegt hier
/// eine Zeile je Person und Tag statt einer Zahl je Tag.
model AnalyticsUserDaily {
  guildId   String
  discordId String
  day       DateTime @db.Date

  messages      Int @default(0)
  voiceSeconds  Int @default(0)
  voiceSessions Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([guildId, discordId, day])
  @@index([guildId, day])
  @@index([guildId, discordId, day])
}

/// Tageswerte je Kanal.
model AnalyticsChannelDaily {
  guildId   String
  channelId String
  day       DateTime @db.Date

  kind        AnalyticsChannelKind
  /// Name zum Zeitpunkt der Zählung - ein gelöschter Kanal bliebe sonst namenlos.
  channelName String?
  /// Kategorie, um die vielen temporären Talks zusammenzufassen.
  parentId    String?

  messages     Int @default(0)
  voiceSeconds Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([guildId, channelId, day])
  @@index([guildId, day])
  @@index([guildId, kind, day])
}

/// Was wir über den Weg eines Mitglieds durch den Server wissen.
///
/// Beantwortet drei Fragen, die sich aus Tageswerten nicht beantworten
/// lassen: Wie viele der Neuen werden aktiv? Wie lange dauert es bis zur
/// ersten Äusserung? Wer von den vor 30 Tagen Beigetretenen ist noch da?
model AnalyticsMemberProfile {
  guildId   String
  discordId String

  /// Name und Avatar zum Zeitpunkt der letzten Aeusserung.
  ///
  /// Mitgefuehrt wie ueberall sonst im System: eine Rangliste, die nur
  /// Discord-Kennungen zeigt, ist unlesbar - und fuer jede Zeile Discord zu
  /// fragen waeren zehn Aufrufe je Seitenaufbau. Wer den Server verlaesst,
  /// ist bei Discord ohnehin nicht mehr abfragbar.
  username    String?
  displayName String?
  avatarHash  String?

  /// Beitritt, wie ihn das Ereignisprotokoll gesehen hat. NULL bei allen, die
  /// schon vor Beginn der Aufzeichnung da waren - für sie gibt es keine
  /// Bindungsquote, und eine erfundene wäre schlimmer als keine.
  joinedAt        DateTime?
  leftAt          DateTime?
  /// Erste Nachricht oder erste Sprachsitzung nach dem Beitritt.
  firstActivityAt DateTime?
  lastActivityAt  DateTime?

  isBot Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@id([guildId, discordId])
  @@index([guildId, joinedAt])
  @@index([guildId, leftAt])
  @@index([guildId, firstActivityAt])
}

// ---------------------------------------------------------------------------
// Community-Kalender
//
// Ein Termin ist eine Zeile in `CalendarEvent`; alles andere haengt daran.
// Bewusst kein zweites Ankuendigungs- oder Anmeldesystem: der Kalender folgt
// den Mustern, die Turniere und Verlosungen schon verwenden - Ankuendigung
// mit gemerkter `discordMessageId` zum spaeteren Fortschreiben, Anmeldung
// unter Zeilensperre, Zeitsteuerung als wiederholter Lauf gegen die Datenbank
// statt als Zeitgeber im Arbeitsspeicher.
//
// Zeiten stehen als UTC in der Datenbank. Die Anzeigezone (Vorgabe
// Europe/Zurich) haengt am Termin, damit ein Sommerzeitwechsel zwischen
// Anlage und Durchfuehrung die Ortszeit nicht verschiebt.
// ---------------------------------------------------------------------------

enum CalendarEventStatus {
  /// Nur fuer Berechtigte sichtbar.
  DRAFT
  /// Veroeffentlicht und noch nicht begonnen.
  SCHEDULED
  /// Laeuft gerade.
  ONGOING
  /// Vorbei.
  COMPLETED
  /// Abgesagt. Der Termin bleibt stehen - geloescht wird er nicht.
  CANCELLED
}

/// Wo ein Termin stattfindet.
///
/// Zwei Arten sind die Wahl, die es tatsaechlich zu treffen gibt: auf unserem
/// Discord oder im echten Leben. `ONLINE` und `OFFLINE`/`HYBRID` stammen aus
/// der ersten Fassung und werden nicht mehr vergeben; sie bleiben im Typ,
/// damit alte Zeilen lesbar sind, falls eine je uebersehen wurde.
enum CalendarLocationKind {
  DISCORD
  REAL_LIFE

  /// @deprecated Wird nicht mehr vergeben - siehe Migration `kalender_ort_uebernahme`.
  ONLINE
  /// @deprecated Wird nicht mehr vergeben.
  OFFLINE
  /// @deprecated Wird nicht mehr vergeben.
  HYBRID
}

enum CalendarRegistrationStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

/// Wofuer eine Ankuendigung oder Benachrichtigung stand.
///
/// Zusammen mit der Termin-Kennung eindeutig - genau das verhindert, dass ein
/// wiederholter Lauf zweimal postet.
enum CalendarNoticeKind {
  ANNOUNCEMENT
  REMINDER
  UPDATE
  CANCELLED
}

model CalendarCategory {
  id      String @id @default(cuid())
  guildId String

  /// Teil der Adresse und stabiler Bezug in Filtern.
  slug             String
  name             String
  description      String?
  /// Farbe als Hex (#RRGGBB) - dieselbe Schreibweise wie im Levelmodul.
  color            String  @default("#83060A")
  /// Lucide-Symbolname, wie in der Navigation.
  icon             String?
  /// Vorgabe-Banner der Kategorie. Wiederkehrende Reihen haben ihr eigenes
  /// Bild; ohne diese Spalte war es an jedem einzelnen Termin nachzutragen.
  /// Das Banner am Termin selbst hat weiterhin Vorrang.
  defaultBannerUrl String?
  active           Boolean @default(true)
  /// Anzeigereihenfolge in Auswahllisten.
  position         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CalendarEvent[]

  @@unique([guildId, slug])
  @@index([guildId, active, position])
}

model CalendarEvent {
  id      String @id @default(cuid())
  guildId String

  /// Teil der Adresse: /kalender/<slug>. Je Server eindeutig.
  slug             String
  title            String
  /// Volltext als Markdown - dieselbe Darstellung wie im Turniermodul.
  description      String  @db.Text
  /// Eine Zeile fuer Kachel und Discord-Embed.
  shortDescription String?

  categoryId String?
  category   CalendarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status CalendarEventStatus @default(DRAFT)

  // --- Zeit --------------------------------------------------------------
  /// Beginn in UTC.
  startAt  DateTime
  /// Ende in UTC. Ohne Ende gilt der Termin als punktuell; die Anzeige und
  /// der ICS-Export setzen dann eine Vorgabedauer ein.
  endAt    DateTime?
  /// Anzeigezone. Ohne sie waere eine Zeit ueber die Zeitumstellung hinweg
  /// nicht eindeutig zurueckzurechnen.
  timezone String    @default("Europe/Zurich")
  allDay   Boolean   @default(false)

  // --- Ort ---------------------------------------------------------------
  locationKind      CalendarLocationKind @default(DISCORD)
  /// Textkanal des Geschehens (nicht der Ankuendigungskanal).
  locationChannelId String?
  locationVoiceId   String?
  /// Adresse fuer ONLINE, Einladungslink fuer DISCORD.
  locationUrl       String?
  /// Name des Veranstaltungsorts bei OFFLINE.
  locationName      String?
  locationAddress   String?

  // --- Medien ------------------------------------------------------------
  bannerUrl String?
  iconUrl   String?

  // --- Verantwortliche ---------------------------------------------------
  /// Wer den Termin angelegt hat. Bleibt stehen, auch wenn die Person
  /// spaeter ihre Berechtigung verliert - sonst waere der Verlauf luecken-
  /// haft. Ob sie noch handeln darf, entscheidet die Rechtepruefung, nicht
  /// dieses Feld.
  createdByDiscordId  String
  /// Organisatoren als Discord-Kennungen. Sie duerfen den Termin verwalten,
  /// sofern ihre Rolle es zulaesst.
  organizerDiscordIds String[]
  /// Frei benannter Ansprechpartner, wenn es keine Discord-Person ist.
  contactNote         String?

  // --- Anmeldung ---------------------------------------------------------
  registrationEnabled  Boolean   @default(false)
  /// 0 = keine Obergrenze.
  capacity             Int       @default(0)
  registrationClosesAt DateTime?
  waitlistEnabled      Boolean   @default(true)
  /// Duerfen Angemeldete selbst zuruecktreten?
  allowSelfCancel      Boolean   @default(true)
  cancelDeadlineAt     DateTime?
  /// Teilnehmerliste fuer alle Mitglieder sichtbar, oder nur fuer die
  /// Verwaltung?
  participantsPublic   Boolean   @default(true)

  // --- Discord -----------------------------------------------------------
  announceOnDiscord     Boolean @default(false)
  announcementChannelId String?
  /// Rolle, die bei Ankuendigung und Erinnerung erwaehnt wird. Erlaubt ist
  /// nur, was in den Moduleinstellungen freigegeben wurde - ein freies
  /// Textfeld waere ein Ping-Knopf fuer den ganzen Server.
  mentionRoleId         String?
  discordMessageId      String?
  /// Gesetzt, wenn die Ankuendigung nicht mehr auffindbar ist.
  discordMessageMissing Boolean @default(false)

  // --- Lebenslauf --------------------------------------------------------
  publishedAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations CalendarRegistration[]
  reminders     CalendarReminder[]
  notices       CalendarNotice[]
  questions     CalendarQuestion[]

  @@unique([guildId, slug])
  @@index([guildId, status, startAt])
  @@index([guildId, startAt])
  @@index([guildId, endAt])
  @@index([guildId, categoryId, startAt])
  @@index([status, startAt])
}

/// Zusatzfrage zu einem Termin, z.B. Ingame-Name oder Wunschrolle.
model CalendarQuestion {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label    String
  /// Kurzer Hinweis unter dem Feld.
  hint     String?
  required Boolean  @default(false)
  /// Freitext oder Auswahl. Mehr Feldarten braucht es hier nicht.
  choices  String[]
  position Int      @default(0)

  answers CalendarAnswer[]

  @@index([eventId, position])
}

model CalendarRegistration {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  discordId   String
  /// Namensstand zum Zeitpunkt der Anmeldung - fuer die Nachvollziehbarkeit,
  /// wenn jemand den Server spaeter verlaesst.
  username    String?
  displayName String?

  status           CalendarRegistrationStatus @default(CONFIRMED)
  /// Platz auf der Warteliste, ab 1. NULL bei bestaetigt und abgemeldet.
  waitlistPosition Int?

  registeredAt        DateTime  @default(now())
  cancelledAt         DateTime?
  /// Gesetzt, wenn die Person von der Warteliste nachgerueckt ist.
  promotedAt          DateTime?
  /// Gesetzt, sobald ueber das Nachruecken benachrichtigt wurde. Verhindert,
  /// dass ein wiederholter Lauf zweimal schreibt.
  promotionNotifiedAt DateTime?

  answers CalendarAnswer[]

  /// Eine Anmeldung je Person und Termin - auf Datenbankebene, nicht nur im
  /// Anwendungscode. Zwei gleichzeitige Anfragen kommen damit nicht beide
  /// durch.
  @@unique([eventId, discordId])
  @@index([eventId, status, registeredAt])
  @@index([eventId, status, waitlistPosition])
  @@index([discordId, registeredAt])
}

model CalendarAnswer {
  id             String               @id @default(cuid())
  registrationId String
  registration   CalendarRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  questionId     String
  question       CalendarQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  value String @db.Text

  @@unique([registrationId, questionId])
  @@index([questionId])
}

/// Eine geplante Erinnerung.
///
/// Der faellige Zeitpunkt steht als Zeile in der Datenbank, nicht als
/// `setTimeout`: ein Neustart wuerde jeden so gemerkten Termin verlieren.
/// `sentAt` zusammen mit der Eindeutigkeit je Termin und Vorlauf sorgt
/// dafuer, dass auch mehrere Bot-Instanzen dieselbe Erinnerung nur einmal
/// verschicken.
model CalendarReminder {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Vorlauf in Minuten vor Beginn.
  minutesBefore Int
  /// Errechneter Faelligkeitszeitpunkt. Wird beim Verschieben des Termins
  /// neu gesetzt - deshalb ein eigenes Feld und keine Berechnung im Filter.
  dueAt         DateTime

  /// Zielkanal. Ohne eigenen Kanal geht die Erinnerung in den
  /// Ankuendigungskanal des Termins.
  channelId          String?
  /// Rollen-Erwaehnung, denselben Regeln unterworfen wie die Ankuendigung.
  mentionRoleId      String?
  /// Statt einer Rolle die angemeldeten Teilnehmer erwaehnen.
  mentionRegistrants Boolean @default(false)

  sentAt           DateTime?
  discordMessageId String?
  /// Fehlversuche. Discord kann kurz ausfallen; der naechste Lauf holt es
  /// nach, bis die Geduld aufgebraucht ist.
  attempts         Int       @default(0)
  lastError        String?

  createdAt DateTime @default(now())

  /// Ein Vorlauf je Termin - zweimal «1 Stunde vorher» gibt es nicht.
  @@unique([eventId, minutesBefore])
  /// Der Arbeitslauf sucht genau danach: faellig und noch nicht gesendet.
  @@index([sentAt, dueAt])
  @@index([eventId])
}

/// Was zu einem Termin bereits auf Discord verschickt wurde.
///
/// Dieselbe Rolle wie `TournamentAnnouncement`: die Eindeutigkeit je Termin
/// und Art ist der Grund, weshalb ein wiederholter Lauf nichts doppelt.
model CalendarNotice {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  kind CalendarNoticeKind

  channelId        String?
  discordMessageId String?
  sentByDiscordId  String?
  sentAt           DateTime @default(now())

  @@unique([eventId, kind])
  @@index([eventId, sentAt])
}

// ---------------------------------------------------------------------------
// Verifikation
//
// Neue Mitglieder erhalten eine Rolle, die nur den Verifikationskanal sieht,
// schreiben dort einen Satz auf Schweizerdeutsch und werden anschliessend
// freigeschaltet - von einem Moderator oder, wenn eingeschaltet und sicher
// genug, selbsttaetig.
//
// Der Kern dieses Modells ist die *eine* Entscheidung je Vorgang. Sie faellt
// unter einer Bedingung, die nur einmal zutrifft (siehe `decidedAt`), damit
// weder ein Doppelklick noch ein spaet eintreffendes AI-Ergebnis eine bereits
// getroffene Entscheidung ueberschreiben kann.
//
// Was die AI darf, steht nicht in diesem Modell, sondern im Code: sie setzt
// ausschliesslich VERIFIED oder gibt an die Moderation ab. Es gibt keine
// Spalte und keinen Zustand, ueber den eine Sanktion aus der AI heraus
// entstehen koennte.
// ---------------------------------------------------------------------------

enum VerificationStatus {
  /// Beigetreten, hat noch nichts geschrieben.
  WAITING_FOR_MESSAGE
  /// Nachricht da, AI prueft gerade.
  AI_ANALYZING
  /// Wartet auf einen Menschen.
  WAITING_FOR_REVIEW
  VERIFIED
  /// Abgelehnt und gebannt - ausschliesslich durch einen Menschen.
  REJECTED
  /// Hat den Server waehrend des Vorgangs verlassen.
  LEFT_SERVER
  /// Frist ohne Nachricht verstrichen.
  EXPIRED
  /// Der Vorgang selbst ist gescheitert (Rolle, Rechte, Discord).
  ERROR
}

/// Wer entschieden hat.
enum VerificationDecider {
  HUMAN
  AI
  /// Zeitsteuerung: Ablauf, Serveraustritt.
  SYSTEM
}

/// Wie die AI die Nachricht eingeordnet hat.
enum VerificationAiVerdict {
  LIKELY_SWISS_GERMAN
  UNCLEAR
  /// Ausdruecklich *nicht* «schlecht»: nur «nicht erkennbar». Loest niemals
  /// eine Sanktion aus, sondern immer eine menschliche Pruefung.
  NOT_RECOGNISED
  /// Die AI war nicht erreichbar oder hat Unbrauchbares geliefert.
  FAILED
}

model VerificationRequest {
  id      String @id @default(cuid())
  guildId String

  discordId   String
  username    String?
  displayName String?
  avatarHash  String?

  status VerificationStatus @default(WAITING_FOR_MESSAGE)

  /// Beitritt und Kontoalter zum Zeitpunkt des Beitritts.
  ///
  /// Als Momentaufnahme festgehalten, weil beides spaeter nicht mehr
  /// rekonstruierbar ist - und weil es der Moderation bei der Einschaetzung
  /// hilft. Eine Sanktion loest es nie aus: ein junges Konto ist ein Hinweis,
  /// kein Beweis.
  joinedAt         DateTime
  accountCreatedAt DateTime?

  /// Neueste Nachricht - Grundlage der Anzeige und der AI-Pruefung.
  latestMessage   String?   @db.Text
  latestMessageId String?
  latestMessageAt DateTime?
  /// Wie oft die Person geschrieben hat. Ein neuer Vorgang entsteht dadurch
  /// nicht, und die Moderation wird nicht bei jeder Nachricht erneut geweckt.
  messageCount    Int       @default(0)

  // --- AI ----------------------------------------------------------------
  aiVerdict    VerificationAiVerdict?
  /// 0..1, auf vier Nachkommastellen gerundet.
  aiConfidence Float?
  aiReasonCode String?
  aiModel      String?
  aiCheckedAt  DateTime?
  aiError      String?
  /// Wie oft die AI fuer diesen Vorgang befragt wurde - Kostenbremse.
  aiAttempts   Int                    @default(0)

  // --- Entscheidung ------------------------------------------------------
  /// Gesetzt, sobald der Vorgang entschieden ist. Zugleich die Bedingung, die
  /// den Wettlauf zwischen Moderator und AI entscheidet: wer sie als Erster
  /// von NULL wegsetzt, hat entschieden.
  decidedAt          DateTime?
  decidedBy          VerificationDecider?
  decidedByDiscordId String?
  decidedByUsername  String?
  /// Pflicht bei Ablehnung.
  decisionReason     String?
  /// Wo die Entscheidung gefallen ist: `DISCORD` oder `WEBAPP`.
  ///
  /// Rein zur Darstellung und fuer die Pruefspur - fuer die Entscheidung
  /// selbst ist es ohne Belang, und beide Wege laufen durch denselben Dienst.
  /// Nullbar, weil Vorgaenge aus der Zeit davor es nicht wissen koennen.
  decidedSource      String?

  /// Ankuendigung im Moderationskanal - wird fortgeschrieben statt neu
  /// gepostet.
  modChannelId String?
  modMessageId String?

  /// Interner Vermerk der Moderation. Der Verweis auf die Akte im Member
  /// Center, damit es keine zweite Notizenwelt gibt.
  noteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages VerificationMessage[]

  /// Ein offener Vorgang je Person und Server. Ein frueherer, abgeschlossener
  /// Vorgang bleibt daneben stehen - deshalb kein `@@unique` auf
  /// `(guildId, discordId)`, sondern der Teilindex weiter unten.
  @@index([guildId, status, createdAt])
  @@index([guildId, discordId, createdAt])
  @@index([guildId, decidedAt])
  @@index([status, joinedAt])
}

/// Die einzelnen Nachrichten eines Vorgangs.
///
/// Getrennt gefuehrt, damit die Moderation den Verlauf sieht, ohne dass jede
/// weitere Nachricht einen neuen Vorgang oder eine neue Benachrichtigung
/// erzeugt. Faellt unter dieselbe Aufbewahrungsfrist wie der Vorgang.
model VerificationMessage {
  id        String              @id @default(cuid())
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  discordMessageId String
  content          String   @db.Text
  createdAt        DateTime @default(now())

  /// Dieselbe Discord-Nachricht wird nicht zweimal erfasst.
  @@unique([requestId, discordMessageId])
  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// Integrationen: zentrale Verwaltung technischer Zugangsdaten
// ---------------------------------------------------------------------------

/// Gilt eine Angabe fuer die ganze Installation oder fuer einen Server?
enum IntegrationScope {
  /// Bot-Token, OAuth-Zugangsdaten, AI-Schluessel: eine Installation, ein Wert.
  GLOBAL
  /// Werte, die sich je verbundenem Discord-Server unterscheiden duerfen.
  GUILD
}

/// Zustand einer Integration - dieselbe Skala fuer Discord, AI und Bots.
enum IntegrationHealth {
  CONNECTED
  DEGRADED
  NOT_CONFIGURED
  ERROR
}

/// Wofuer ein hinterlegter Discord-Bot zustaendig ist.
enum IntegrationBotKind {
  /// Der SwissHub-Bot selbst.
  SYSTEM
  /// Musik: der steuernde Bot.
  MUSIC_CONTROLLER
  /// Musik: ein zusaetzlicher Bot, der einen weiteren Kanal bedienen kann.
  MUSIC_WORKER
}

/// Ein verschluesseltes Geheimnis.
///
/// Hier steht ausschliesslich der Umschlag aus `@swisshub/secrets` - niemals
/// ein Klartext. `hint` sind die letzten vier Zeichen und dient allein dazu,
/// zwei Schluessel im Dashboard auseinanderhalten zu koennen.
model IntegrationSecret {
  id         String           @id @default(cuid())
  scope      IntegrationScope @default(GLOBAL)
  /// Nur bei `scope = GUILD` gefuellt, sonst die leere Zeichenkette.
  ///
  /// Bewusst nicht `null`: in PostgreSQL ist NULL nie gleich NULL, ein
  /// eindeutiger Index ueber eine nullbare Spalte liesse also beliebig viele
  /// globale Zeilen fuer dasselbe Feld zu. Genau die soll es nicht geben.
  guildId    String           @default("")
  /// `discord`, `ai`, `bot:<id>`, ... - siehe Katalog in @swisshub/secrets.
  provider   String
  /// Feldname innerhalb des Anbieters, z.B. `botToken`.
  key        String
  /// `v1.<schluesselKennung>.<iv>.<tag>.<geheimtext>`
  ciphertext String
  /// Fassung des Umschlags - Grundlage fuer einen spaeteren Schluesselwechsel.
  envelope   String           @default("v1")
  /// Letzte vier Zeichen des Klartexts. Nie mehr.
  hint       String?
  /// Zaehler statt Verlauf: alte Tokens werden bewusst nicht aufbewahrt.
  version    Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  updatedBy  String?

  @@unique([scope, guildId, provider, key])
  @@index([provider])
}

/// Ein Discord-Bot mit eigenen Zugangsdaten.
///
/// Das Token steht nicht hier, sondern als `IntegrationSecret` unter
/// `provider = "bot:<id>"`. Diese Zeile traegt nur, was sich gefahrlos
/// anzeigen laesst: Name, Anwendungs-ID, Zustand, letzter erfolgreicher Login.
model IntegrationBot {
  id            String             @id @default(cuid())
  kind          IntegrationBotKind
  /// Anzeigename, z.B. «Music Worker 1».
  label         String
  /// Stabiler Schluessel fuer die Laufzeit, z.B. `CONTROLLER`, `WORKER_1`.
  slug          String             @unique
  /// Discord Application ID - keine Geheimnis, hilft beim Zuordnen.
  clientId      String?
  /// Von Discord gemeldeter Benutzername des Bots, nach erfolgreichem Test.
  botUsername   String?
  botUserId     String?
  status        IntegrationHealth  @default(NOT_CONFIGURED)
  /// Zuletzt gemeldeter Fehler - bereinigt, ohne Anbieter-Rohtext.
  lastError     String?
  lastCheckedAt DateTime?
  lastLoginAt   DateTime?
  /// Reihenfolge in der Uebersicht und beim Zuteilen von Sprachkanaelen.
  position      Int                @default(0)
  enabled       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  updatedBy     String?

  @@index([kind, position])
}

/// Zustand einer Integration, wie ihn die Uebersicht anzeigt.
///
/// Bewusst eine eigene, schmale Zeile statt eines Feldes an
/// `IntegrationSecret`: der Zustand gehoert zur Integration als Ganzes und
/// nicht zu einem einzelnen Feld, und er wird deutlich haeufiger geschrieben
/// als die Zugangsdaten.
model IntegrationStatus {
  provider      String            @id
  status        IntegrationHealth @default(NOT_CONFIGURED)
  /// Kurze, bereinigte Auskunft - nie eine Anbieter-Rohantwort.
  detail        String?
  lastCheckedAt DateTime?
  lastOkAt      DateTime?
  updatedAt     DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// Automation Engine
// ---------------------------------------------------------------------------

/// Wem gehoert eine Automation?
enum AutomationKind {
  /// Von der Verwaltung angelegt. Frei aenderbar und loeschbar.
  USER
  /// Von SwissHub gebraucht. Konfigurierbar und abschaltbar, nicht loeschbar.
  SYSTEM
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  /// Wartet auf einen persistierten Zeitpunkt (Wait-Schritt).
  WAITING
  /// Wartet auf eine menschliche Freigabe.
  AWAITING_APPROVAL
  SUCCESS
  /// Bedingungen trafen nicht zu - kein Fehler.
  SKIPPED
  FAILED
  /// Endgueltig gescheitert; liegt im Fehler-Posteingang.
  DEAD_LETTER
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  SUCCESS
  /// Nichts zu tun - die Wirkung bestand bereits (Idempotenz).
  NO_OP
  SKIPPED
  FAILED
}

enum AutomationJobKind {
  /// Ein zeitgesteuerter Trigger ist faellig.
  SCHEDULE
  /// Ein wartender Lauf wird fortgesetzt.
  RESUME
  /// Ein gescheiterter Schritt wird erneut versucht.
  RETRY
}

enum AutomationJobStatus {
  PENDING
  CLAIMED
  DONE
  /// Endgueltig gescheitert - wird nicht mehr aufgenommen.
  DEAD
}

/// Was geschieht, wenn eine Automation laeuft und erneut ausgeloest wird?
enum AutomationConcurrency {
  ALLOW
  SKIP_IF_RUNNING
  QUEUE
}

enum AutomationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Ein Ereignis im System - die Ausgangslage jeder ereignisgesteuerten
/// Automation.
///
/// Bewusst eine Tabelle und kein Bus im Arbeitsspeicher: die WebApp erzeugt
/// Ereignisse, verarbeitet werden sie im Bot. Ein Bus im Speicher erreichte
/// den anderen Prozess nie und verloere bei jedem Neustart, was noch offen
/// ist.
model AutomationEvent {
  id            String    @id @default(cuid())
  /// Stabiler, versionierter Name: `verification.completed`.
  type          String
  /// Fassung des Nutzdatenschemas. Aeltere Laeufe bleiben lesbar.
  schemaVersion Int       @default(1)
  guildId       String
  sourceModule  String
  actorId       String?
  subjectId     String?
  entityId      String?
  /// Klammert eine ganze Ursachenkette. Grundlage der Schleifenerkennung.
  correlationId String
  /// Das Ereignis, aus dem dieses hervorging.
  causationId   String?
  /// Tiefe in der Kette. Harte Obergrenze im Executor.
  depth         Int       @default(0)
  payload       Json
  occurredAt    DateTime  @default(now())
  /// Gesetzt, sobald der Verteiler es angesehen hat.
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([processedAt, occurredAt])
  @@index([type, occurredAt])
  @@index([correlationId])
  @@index([occurredAt])
}

model Automation {
  id               String                @id @default(cuid())
  guildId          String
  name             String
  description      String?
  kind             AutomationKind        @default(USER)
  /// Nur bei Systemautomationen: der Schluessel, unter dem SwissHub sie kennt.
  systemKey        String?               @unique
  enabled          Boolean               @default(false)
  /// Zaehlt bei jeder Aenderung hoch. Laufende Laeufe behalten ihre Fassung.
  version          Int                   @default(1)
  /// Kennung aus der Trigger-Registry, z.B. `event` oder `schedule`.
  triggerType      String
  triggerConfig    Json
  /// Bedingungsbaum (UND/ODER/NICHT). `null` heisst: keine Bedingung.
  conditions       Json?
  /// Die Schrittfolge.
  steps            Json
  concurrency      AutomationConcurrency @default(ALLOW)
  /// Vorlage fuer den Schluessel, unter dem gleichzeitige Laeufe zaehlen.
  concurrencyKey   String?
  /// Obergrenze der Laeufe je Minute. Schutz vor Ereignisstuermen.
  maxRunsPerMinute Int                   @default(60)
  /// Soft Delete: Verlauf und Pruefspur bleiben lesbar.
  archivedAt       DateTime?
  lastRunAt        DateTime?
  lastStatus       AutomationRunStatus?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  versions AutomationVersion[]
  runs     AutomationRun[]
  jobs     AutomationJob[]

  @@index([guildId, enabled, triggerType])
  @@index([enabled, triggerType, archivedAt])
  @@index([guildId, archivedAt])
}

/// Die Fassung einer Automation zum Zeitpunkt eines Laufs.
///
/// Wer eine aktive Automation bearbeitet, aendert nichts an einem Lauf, der
/// gerade wartet: der arbeitet die Fassung ab, mit der er begonnen hat.
model AutomationVersion {
  id           String          @id @default(cuid())
  automationId String
  version      Int
  snapshot     Json
  /// Was diese Fassung ausmacht - «Angelegt», «Bearbeitet». Fuer die Liste.
  note         String?
  createdBy    String?
  createdAt    DateTime        @default(now())
  automation   Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@unique([automationId, version])
}

model AutomationRun {
  id             String              @id @default(cuid())
  automationId   String
  versionId      String?
  version        Int
  guildId        String
  status         AutomationRunStatus @default(PENDING)
  /// Wodurch der Lauf entstand: `event`, `schedule`, `manual`, `retry`.
  trigger        String
  eventId        String?
  eventType      String?
  correlationId  String
  depth          Int                 @default(0)
  /// Verhindert, dass dasselbe Ereignis dieselbe Automation zweimal ausloest.
  idempotencyKey String              @unique
  /// Probelauf: Bedingungen werden geprueft, Aktionen nicht ausgefuehrt.
  dryRun         Boolean             @default(false)
  /// Der aufgeloeste Gleichzeitigkeitsschluessel. `null` = die ganze Automation.
  concurrencyKey String?
  /// Naechster auszufuehrender Schritt. Traegt die Fortsetzung nach Wait.
  cursor         Int                 @default(0)
  /// Der aufgeloeste Kontext, gekuerzt und bereinigt.
  context        Json
  error          String?
  errorCode      String?
  /// Wann ueber diesen Lauf gemeldet wurde. Verhindert eine zweite Meldung.
  notifiedAt     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime            @default(now())

  automation Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  versionRef AutomationVersion?   @relation(fields: [versionId], references: [id], onDelete: SetNull)
  steps      AutomationStepRun[]
  approvals  AutomationApproval[]

  @@index([automationId, createdAt])
  @@index([guildId, status, createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
  @@index([automationId, status, concurrencyKey])
  @@index([status, notifiedAt])
}

model AutomationStepRun {
  id         String               @id @default(cuid())
  runId      String
  /// Stellung in der Schrittfolge.
  index      Int
  /// Kennung aus der Action-Registry, oder `wait` / `branch`.
  stepType   String
  label      String?
  status     AutomationStepStatus @default(PENDING)
  attempts   Int                  @default(0)
  /// Kurze, bereinigte Auskunft ueber das Ergebnis. Nie ein Geheimnis.
  detail     String?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, index])
  @@index([runId])
}

/// Der persistente Zeitplaner.
///
/// Zeitgesteuerte Trigger, wartende Laeufe und Wiederholungen laufen alle
/// ueber diese eine Tabelle. Ein Neustart verliert dadurch nichts, und
/// mehrere Instanzen holen sich einen Job unter einer Bedingung, die nur
/// einmal zutrifft.
model AutomationJob {
  id           String              @id @default(cuid())
  kind         AutomationJobKind
  status       AutomationJobStatus @default(PENDING)
  automationId String?
  runId        String?
  guildId      String
  runAt        DateTime
  claimedAt    DateTime?
  /// Wer den Job hat. Erlaubt das Zurueckholen nach einem Absturz.
  claimedBy    String?
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(5)
  lastError    String?
  payload      Json?
  /// Verhindert, dass derselbe Vorgang zweimal geplant wird.
  dedupeKey    String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  automation Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([automationId, status])
}

/// Eine Aktion, die auf eine menschliche Entscheidung wartet.
///
/// Der Lauf bleibt so lange stehen. Ohne Freigabe geschieht nichts - das ist
/// der Punkt: eine Automation soll heikle Wirkungen vorschlagen koennen, ohne
/// sie selbst auszuloesen.
model AutomationApproval {
  id               String                   @id @default(cuid())
  runId            String
  stepIndex        Int
  guildId          String
  status           AutomationApprovalStatus @default(PENDING)
  title            String
  summary          String
  requestedAt      DateTime                 @default(now())
  expiresAt        DateTime?
  decidedAt        DateTime?
  decidedBy        String?
  decidedByName    String?
  reason           String?
  discordChannelId String?
  discordMessageId String?

  run AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepIndex])
  @@index([status, requestedAt])
  @@index([guildId, status])
}

// ===========================================================================
// Entbannungsantraege
// ===========================================================================
//
// Ein Antrag auf erneute Pruefung einer Sanktion. Zwei Eigenheiten
// unterscheiden dieses Modul von allen anderen:
//
// 1. **Der Antragsteller ist kein Mitglied.** Wer gebannt ist, steht nicht
//    mehr auf dem Server. Die Zugehoerigkeit als Zugangsvoraussetzung waere
//    hier genau die Mauer, die den Antrag unmoeglich macht. Identifiziert
//    wird deshalb ueber die Discord-Kennung aus der Anmeldung - sie ist
//    stabil, faelschungssicher und unabhaengig von der Mitgliedschaft.
//
// 2. **Was der Antragsteller sieht, ist eine Teilmenge.** Interne Kommentare,
//    interne Begruendungen und interne Zeitleisteneintraege verlassen den
//    Server nie in seine Richtung. Das ist keine Anzeigefrage: die Trennung
//    steht in der Datenbank, nicht in der Oberflaeche.
//
// Der Antrag traegt eine unveraenderliche Momentaufnahme der Sanktion, auf
// die er sich bezieht. Ohne sie liesse sich in einem Jahr nicht mehr sagen,
// worueber ueberhaupt entschieden wurde.

enum AppealStatus {
  /// Angefangen, aber nicht eingereicht. Zaehlt fuer keine Frist.
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  /// Das Team hat eine Rueckfrage gestellt.
  WAITING_FOR_APPLICANT
  /// Der Antragsteller hat geantwortet.
  WAITING_FOR_STAFF
  ESCALATED
  /// Eine Entscheidung liegt vor und wartet auf die zweite Person (Vier-Augen).
  DECISION_PENDING
  APPROVED
  REJECTED
  /// Vom Antragsteller zurueckgezogen.
  WITHDRAWN
  /// Ohne Antwort des Antragstellers abgelaufen.
  EXPIRED
  /// Die Sanktion wurde ausserhalb des Antrags aufgehoben.
  RESOLVED_EXTERNALLY
  CLOSED
}

enum AppealPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AppealDecisionKind {
  APPROVE
  REJECT
}

/// Wer eine Nachricht geschrieben hat.
enum AppealMessageAuthor {
  APPLICANT
  STAFF
  SYSTEM
}

/// Wer einen Zeitleisteneintrag sehen darf.
enum AppealVisibility {
  /// Auch der Antragsteller.
  PUBLIC
  /// Ausschliesslich das Team.
  INTERNAL
}

enum AppealEventKind {
  CREATED
  SUBMITTED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  STAFF_MESSAGE
  APPLICANT_MESSAGE
  INTERNAL_COMMENT
  ESCALATED
  DECISION_PROPOSED
  DECISION_CONFIRMED
  APPROVED
  REJECTED
  UNBAN_ATTEMPTED
  UNBAN_SUCCEEDED
  UNBAN_FAILED
  WITHDRAWN
  EXPIRED
  SANCTION_LIFTED_EXTERNALLY
  CLOSED
  REOPENED
}

model Appeal {
  id      String @id @default(cuid())
  guildId String

  /// Menschenlesbare Fallnummer, z.B. 42 -> «A-2026-0042».
  ///
  /// Eigene Spalte und eigener Zaehler statt `MAX(number) + 1`: die Rechnung
  /// ueber alle Antraege liefert zwei gleichzeitigen Einreichungen dieselbe
  /// Zahl. Dasselbe Verfahren wie bei den Tickets.
  caseNumber Int
  /// Jahr der Einreichung - Teil der Fallnummer, damit sie ohne Rechnung lesbar bleibt.
  caseYear   Int

  /// **Die Identitaet.** Discord-Kennung, nie der Benutzername.
  ///
  /// Ein Benutzername aendert sich; die Kennung nicht. Wer sie als
  /// Primaerschluessel verwendet, hat in einem Jahr noch denselben Menschen.
  applicantDiscordId  String
  /// Anzeigename zum Zeitpunkt der Einreichung - reine Anzeige.
  applicantUsername   String
  applicantAvatarHash String?

  status   AppealStatus   @default(DRAFT)
  priority AppealPriority @default(NORMAL)

  /// Die Antworten auf die Formularfragen. Nach der Einreichung unveraenderlich.
  answers Json @default("{}")

  /// Momentaufnahme der Sanktion beim Einreichen (§8).
  ///
  /// Bewusst eine Kopie und keine Verknuepfung: die Moderationsakte darf sich
  /// aendern, ohne dass sich rueckwirkend aendert, worueber entschieden wurde.
  /// Enthaelt ausschliesslich Angaben, die auch der Entscheidung zugrunde
  /// liegen duerfen - keine internen Notizen.
  banSnapshot      Json    @default("{}")
  /// Verweis auf den Moderationseintrag, sofern SwissHub den Bann gesetzt hat.
  sanctionActionId String?

  assignedToDiscordId String?
  assignedToUsername  String?
  assignedAt          DateTime?

  /// Was der Antragsteller als Begruendung zu sehen bekommt.
  publicDecision     String?             @db.Text
  /// Was ausschliesslich das Team liest.
  internalDecision   String?             @db.Text
  decisionKind       AppealDecisionKind?
  decidedAt          DateTime?
  decidedByDiscordId String?
  decidedByUsername  String?

  /// Vier-Augen-Prinzip: wer die Entscheidung vorgeschlagen hat (§24).
  proposedByDiscordId String?
  proposedByUsername  String?
  proposedAt          DateTime?

  /// Zustand der Discord-Entbannung. Trennt «entschieden» von «ausgefuehrt» (§26).
  unbanStatus    ActionStatus?
  unbanAttemptAt DateTime?
  unbanError     String?

  /// Ab wann ein erneuter Antrag moeglich ist. NULL = keine Sperre.
  nextEligibleAt DateTime?
  /// Endgueltig abgelehnt - ein erneuter Antrag ist nie moeglich.
  finalRejection Boolean   @default(false)

  submittedAt  DateTime?
  /// Frist fuer die Antwort des Antragstellers (§44).
  waitingUntil DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// Optimistische Sperre gegen widerspruechliche Entscheidungen (§57, §58).
  version Int @default(0)

  messages    AppealMessage[]
  comments    AppealInternalComment[]
  attachments AppealAttachment[]
  events      AppealEvent[]

  @@unique([guildId, caseYear, caseNumber])
  @@index([guildId, status, createdAt])
  @@index([applicantDiscordId, createdAt])
  @@index([guildId, assignedToDiscordId, status])
  @@index([status, waitingUntil])
  @@index([guildId, status, priority])
}

/// Zaehler der Fallnummern - je Gilde und Jahr eine Zeile.
model AppealCounter {
  guildId    String
  year       Int
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt

  @@id([guildId, year])
}

/// Eine Nachricht zwischen Antragsteller und Team.
///
/// Beide Richtungen in derselben Tabelle: der Verlauf ist ein Gespraech, und
/// zwei Tabellen dafuer muessten beim Anzeigen wieder zusammengefuegt werden.
model AppealMessage {
  id       String @id @default(cuid())
  appealId String
  appeal   Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  author AppealMessageAuthor

  /// Wer geschrieben hat. Beim Team fuer die Pruefspur - angezeigt wird
  /// dem Antragsteller «SwissHub Team» (§22).
  authorDiscordId String?
  authorUsername  String?

  content String @db.Text

  createdAt DateTime  @default(now())
  /// Wann der Antragsteller die Nachricht gesehen hat.
  readAt    DateTime?

  attachments AppealAttachment[]

  @@index([appealId, createdAt])
}

/// Eine interne Notiz des Teams.
///
/// Eigene Tabelle und nicht ein Feld an der Nachricht: was intern ist, soll
/// nicht versehentlich in derselben Abfrage landen wie das, was hinausgeht.
model AppealInternalComment {
  id       String @id @default(cuid())
  appealId String
  appeal   Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  authorDiscordId String
  authorUsername  String

  content String @db.Text

  createdAt DateTime  @default(now())
  editedAt  DateTime?

  @@index([appealId, createdAt])
}

/// Ein Anhang - am Antrag selbst oder an einer Nachricht.
model AppealAttachment {
  id       String @id @default(cuid())
  appealId String
  appeal   Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  /// Gesetzt, wenn der Anhang zu einer Nachricht gehoert.
  messageId String?
  message   AppealMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  uploadedByDiscordId String

  fileName    String
  contentType String
  sizeBytes   Int
  /// Name im geschuetzten Speicher - nie der Name, unter dem hochgeladen wurde.
  storageName String

  createdAt DateTime  @default(now())
  /// Bytes entfernt, Eintrag bleibt - «hier gab es eine Datei» ist eine Auskunft.
  deletedAt DateTime?

  @@index([appealId, createdAt])
  @@index([messageId])
}

/// Ein Eintrag in der Zeitleiste.
model AppealEvent {
  id       String @id @default(cuid())
  appealId String
  appeal   Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  kind       AppealEventKind
  visibility AppealVisibility @default(INTERNAL)

  actorDiscordId String?
  actorUsername  String?

  /// Was der Antragsteller liest, sofern der Eintrag oeffentlich ist.
  publicLabel String?
  /// Zusatzangaben fuer das Team - alter und neuer Wert und dergleichen.
  detail      Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([appealId, createdAt])
  @@index([appealId, visibility, createdAt])
}

/// Kategorien der Discord-Log-Ausgabe.
///
/// Bewusst die Taxonomie, die SwissHub schon fuehrt, und nicht mehr: jede
/// Kategorie hier hat eine tatsaechliche Quelle im System. Eine Kategorie
/// ohne Quelle waere ein Auswahlfeld, das nie etwas sendet.
enum DiscordLogCategory {
  /// Aus `ModerationAction` - Bann, Kick, Timeout, Aufhebung, Jail.
  MODERATION
  /// Aus `DiscordEvent` der Kategorie MESSAGE.
  MESSAGES
  /// Aus `DiscordEvent` der Kategorie VOICE.
  VOICE
  /// Aus `DiscordEvent` der Kategorie MEMBER - Beitritt, Austritt, Rollen, Spitzname.
  MEMBERS
  /// Aus `DiscordEvent` der Kategorien ROLE, CHANNEL und SERVER.
  ADMIN
}

/// Zustand eines konfigurierten Log-Ziels.
enum DiscordLogHealth {
  /// Kanal da, Rechte da.
  HEALTHY
  /// Erreichbar, aber etwas fehlt - zuletzt ist eine Zustellung gescheitert.
  DEGRADED
  /// Kanal geloescht, falscher Typ oder keine Sendeberechtigung.
  INVALID
  /// Vom Team abgeschaltet.
  DISABLED
}

/// Zustand einer einzelnen Zustellung.
enum DiscordLogDeliveryStatus {
  PENDING
  SENT
  FAILED
  /// Bewusst nicht gesendet - Kategorie aus, kein Ziel, oder nichts zu sagen.
  SKIPPED
}

/// Wohin eine Log-Kategorie ausgegeben wird.
///
/// Eine Zeile je Kategorie. Der Kanal darf mehrfach vorkommen - wer alles in
/// einen `#server-logs` schreiben will, soll das koennen; ein eindeutiger
/// Index auf die Kanalkennung waere eine kuenstliche Grenze.
model DiscordLogChannel {
  category      DiscordLogCategory @id
  guildId       String
  channelId     String
  /// Name zum Zeitpunkt der Einrichtung - fuer die Anzeige, wenn Discord
  /// gerade nicht erreichbar ist.
  channelName   String?
  enabled       Boolean            @default(true)
  health        DiscordLogHealth   @default(HEALTHY)
  /// Warum der Zustand nicht HEALTHY ist - Klartext fuer die Oberflaeche.
  healthNote    String?
  checkedAt     DateTime?
  /// Der letzte Fehler beim Senden, fuer die Fehleranzeige im Dashboard.
  lastErrorAt   DateTime?
  lastErrorCode String?
  updatedBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([guildId])
  @@index([channelId])
}

/// Eine Zustellung an einen Discord-Kanal.
///
/// Der eigentliche Schutz gegen Doppelnachrichten: `dedupeKey` ist eindeutig
/// und besteht aus Quelle, Kennung des Logeintrags und Zielkanal. Ein
/// Neustart mitten in der Zustellung kann dadurch keine zweite Nachricht
/// erzeugen - das entscheidet die Datenbank, nicht der Anwendungscode.
model DiscordLogDelivery {
  id               String                   @id @default(cuid())
  /// `moderation:<id>:<channelId>` oder `event:<id>:<channelId>`.
  dedupeKey        String                   @unique
  guildId          String
  category         DiscordLogCategory
  channelId        String
  status           DiscordLogDeliveryStatus @default(PENDING)
  /// Nach welchem Zeitpunkt der naechste Versuch fruehestens laeuft.
  runAt            DateTime                 @default(now())
  attempts         Int                      @default(0)
  /// Wer den Vorgang gerade hat - erlaubt das Zurueckholen nach einem Absturz.
  claimedAt        DateTime?
  claimedBy        String?
  lastAttemptAt    DateTime?
  lastErrorCode    String?
  sentAt           DateTime?
  discordMessageId String?
  /// Der fertige Embed. Gespeichert, weil die Quelle sich aendern kann,
  /// bevor der zweite Versuch laeuft - gesendet wird, was zum Zeitpunkt des
  /// Ereignisses galt.
  payload          Json
  createdAt        DateTime                 @default(now())

  /// Der Arbeitsvorrat des Zustellers.
  @@index([status, runAt])
  @@index([channelId, createdAt])
}
