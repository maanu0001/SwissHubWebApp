// SwissHub Bot WebApp - Datenbankschema
//
// Grundsätze:
//  * Die Datenbank ist Source of Truth für alles, was einen Neustart von Bot
//    oder WebApp überleben muss (Jails, Audit Logs, Einstellungen).
//  * Datensparsamkeit: Discord-Mitgliederdaten werden nur zwischengespeichert,
//    wo sie für Sicherheitsentscheide oder Nachvollziehbarkeit nötig sind.
//  * Alle Zeitstempel werden in UTC gespeichert und erst im UI in Europe/Zurich
//    dargestellt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Grobe Anwendungsgruppe. Sie ist bewusst NICHT die Quelle der Wahrheit für
/// Berechtigungen - massgebend sind Discord-Rollen + Permission Engine.
enum AppRole {
  USER
  TEAM
  MODERATOR
  ADMIN
  OWNER
}

/// Zustand einer Aktion, die Discord und Datenbank umfasst.
enum ActionStatus {
  PENDING
  EXECUTING
  COMPLETED
  PARTIAL
  FAILED
}

/// Zeitlich begrenzt oder unbefristet. Unbefristete Jails haben kein `endsAt`
/// und werden vom automatischen Release-Worker bewusst nicht angefasst.
enum JailType {
  TEMPORARY
  PERMANENT
}

enum VoteJailStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Woher ein Jail stammt. Dashboard und Slash Command nutzen denselben
/// Service - die Quelle ist reine Herkunftsinformation, kein zweiter Weg.
enum JailSource {
  DASHBOARD
  SLASH_COMMAND
  VOTE_JAIL
  IMPORT
  AUTO_RESTORE
}

/// Fachlicher Zustand eines Jails.
///
/// Bewusst getrennt von `ActionStatus`: dort steht, ob die *Discord-Aktion*
/// durchgelaufen ist, hier steht, in welchem Zustand die *Strafe* ist.
/// PENDING_REJOIN bedeutet: Mitglied hat den Server verlassen, die Strafe
/// laeuft weiter und wird beim erneuten Beitritt wieder angewendet.
enum JailLifecycle {
  PENDING
  ACTIVE
  RELEASED
  EXPIRED
  RESTORE_FAILED
  PENDING_REJOIN
  FAILED
}

enum JailImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Entscheidung des Import-Assistenten pro Legacy-Zeile.
enum JailImportRowAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_RELEASED
  SKIP_INVALID
  CONFLICT
}

/// Zustand einer Spielersuche.
enum SpielersucheStatus {
  OPEN
  COMPLETE
  CLOSED
  EXPIRED
}

/// Woher eine Suche stammt. Dashboard und Slash Command durchlaufen denselben
/// Service - die Quelle ist reine Herkunftsinformation.
enum SpielersucheSource {
  DASHBOARD
  SLASH_COMMAND
  LEGACY_IMPORT
}

enum SpielersucheImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Datenart einer Zeile aus der alten Spielersuche-Datenbank.
enum SpielersucheImportKind {
  SETTINGS
  GAME
  MATCH
  PARTICIPANT
  USAGE
  VOICE_SESSION
  ROLE_PING
}

enum SpielersucheImportAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_INVALID
  SKIP_OTHER_GUILD
  CONFLICT
}

enum CommunicationType {
  NEWS
  EVENT
  POLL
}

/// Wo eine Kommunikation entstanden ist.
enum CommunicationSource {
  WEBAPP
  /// Slash Command `/post` - der Nachfolger des alten Kommunikationsbots.
  SLASH_COMMAND
}

enum CommunicationStatus {
  /// Vorbereitet, noch nicht gesendet.
  DRAFT
  SENT
  /// Discord hat den Versand abgelehnt oder nicht geantwortet.
  FAILED
  /// Auf Discord geloescht - der Eintrag bleibt fuer die Nachvollziehbarkeit.
  DELETED
}

/// Wie man sich zu einem Event anmeldet (frueher das Freitextfeld "Ahmaeldig via").
enum CommunicationRegistrationType {
  NONE
  TEXT
  /// Der in den Einstellungen hinterlegte Ticket-Channel.
  TICKET
  /// Ein frei gewaehlter Discord-Channel.
  CHANNEL
  URL
}

/// Wen eine Nachricht erwaehnt.
enum CommunicationMentionType {
  NONE
  EVERYONE
  HERE
  ROLE
  USER
}

enum JailReleaseType {
  AUTOMATIC
  MANUAL
  RECONCILED
}

enum ModerationActionType {
  JAIL_CREATE
  JAIL_RELEASE
  JAIL_EXTEND
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReconciliationMode {
  AUTOMATIC
  MANUAL
}

/// Anwendungskonto, das an eine Discord-Identität gebunden ist.
model User {
  id           String   @id @default(cuid())
  discordId    String   @unique
  username     String
  globalName   String?
  avatarHash   String?
  appRole      AppRole  @default(USER)
  /// Anwendungsseitige Sperre (unabhängig von Discord).
  isBlocked    Boolean  @default(false)
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  identityCache        DiscordIdentityCache?
  /// Premium-Abonnements. Bewusst am bestehenden Benutzer statt an einem
  /// zweiten Konto - Premium ist ein Modul, kein eigenes Produkt.
  premiumSubscriptions PremiumSubscription[]

  @@index([username])
}

/// Serverseitige Session. Im Browser liegt ausschliesslich ein zufälliges
/// Token; gespeichert wird nur dessen SHA-256 Hash.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  rotatedAt     DateTime  @default(now())
  /// Absolutes Ablaufdatum - unabhängig von Aktivität.
  expiresAt     DateTime
  /// Ablauf bei Inaktivität; wird bei jedem Request verlängert.
  idleExpiresAt DateTime
  revokedAt     DateTime?
  revokedReason String?
  ipHash        String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

/// Zwischenspeicher für Guild-Mitgliedschaft und Discord-Rollen.
/// Wird nach Ablauf der TTL und vor sicherheitskritischen Aktionen erneuert.
model DiscordIdentityCache {
  discordId     String    @id
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMember      Boolean   @default(false)
  roleIds       String[]  @default([])
  nickname      String?
  joinedGuildAt DateTime?
  fetchedAt     DateTime  @default(now())

  @@index([fetchedAt])
}

/// Discord-Rolle, die von SwissHub verwaltet/bewertet wird.
model ManagedRole {
  id              String   @id @default(cuid())
  discordRoleId   String   @unique
  label           String
  /// Geschützte Rollen können nicht moderiert werden.
  isProtected     Boolean  @default(false)
  /// Rollen, die beim Jail erhalten bleiben (z.B. Booster).
  keepOnJail      Boolean  @default(false)
  /// Interne Moderationsstufe für die Hierarchieprüfung (höher = stärker).
  moderationLevel Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permissions RolePermission[]
}

/// Zuordnung Discord-Rolle -> Permission der Permission Engine.
model RolePermission {
  id            String      @id @default(cuid())
  discordRoleId String
  permission    String
  createdAt     DateTime    @default(now())
  createdBy     String?
  role          ManagedRole @relation(fields: [discordRoleId], references: [discordRoleId], onDelete: Cascade)

  @@unique([discordRoleId, permission])
  @@index([permission])
}

/// Generischer, typisiert gelesener Konfigurationsspeicher.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Konfiguration des SwissHub Discord-Servers.
/// Nach dem Setup ist dies - nicht mehr die .env - die Quelle der Wahrheit.
model GuildConfig {
  id               String    @id @default("singleton")
  guildId          String    @unique
  name             String?
  iconHash         String?
  ownerId          String?
  memberCount      Int?
  presenceCount    Int?
  /// Zeitpunkt der letzten erfolgreichen Discord-Synchronisation.
  lastSyncedAt     DateTime?
  /// Gesetzt, sobald der Setup-Assistent abgeschlossen wurde.
  setupCompletedAt DateTime?
  setupCompletedBy String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Zwischenspeicher der Discord-Rollen (fuer Auswahllisten, Hierarchie und
/// Anzeige bei Discord-Ausfall). Wird vom Sync-Service gepflegt.
model DiscordRoleCache {
  roleId      String    @id
  name        String
  color       Int       @default(0)
  position    Int       @default(0)
  managed     Boolean   @default(false)
  hoist       Boolean   @default(false)
  /// Discord Permission Bits als String (BigInt-sicher).
  permissions String    @default("0")
  syncedAt    DateTime  @default(now())
  /// Gesetzt, wenn die Rolle auf Discord nicht mehr existiert.
  deletedAt   DateTime?

  @@index([position])
  @@index([deletedAt])
}

/// Zwischenspeicher der Discord-Channels.
model DiscordChannelCache {
  channelId String    @id
  name      String
  /// Discord Channel Type (0 = Text, 2 = Voice, 4 = Kategorie, 15 = Forum, ...).
  type      Int
  parentId  String?
  position  Int       @default(0)
  nsfw      Boolean   @default(false)
  syncedAt  DateTime  @default(now())
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
}

/// Zaehler, der bei jeder Konfigurationsaenderung erhoeht wird.
/// Bot und WebApp erkennen daran, dass ihre Caches veraltet sind - dadurch
/// wirken Aenderungen ohne Neustart.
model ConfigRevision {
  id        String   @id @default("singleton")
  revision  BigInt   @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
  reason    String?
}

/// Protokoll der Discord-Synchronisationen.
model SyncRun {
  id              String    @id @default(cuid())
  trigger         String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  roles           Int       @default(0)
  channels        Int       @default(0)
  removedRoles    Int       @default(0)
  removedChannels Int       @default(0)
  success         Boolean   @default(true)
  error           String?
  triggeredBy     String?

  @@index([startedAt])
}

/// Aktivierungszustand und Einstellungen eines Moduls.
model ModuleState {
  moduleId      String   @id
  enabled       Boolean  @default(true)
  settings      Json     @default("{}")
  /// Schema-Version der gespeicherten Einstellungen (fuer Migrationen).
  configVersion Int      @default(1)
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Jail-Vorgang. Die Datenbank ist Source of Truth - der Bot leitet daraus
/// automatische Freilassungen und Reconciliation ab.
model JailEntry {
  id                  String           @id @default(cuid())
  targetDiscordId     String
  targetUsername      String
  targetDisplayName   String?
  /// Avatar-Hashes zum Zeitpunkt der Aktion - halten die Historie lesbar,
  /// auch wenn ein Mitglied den Server spaeter verlaesst.
  targetAvatarHash    String?
  moderatorAvatarHash String?
  moderatorDiscordId  String
  moderatorUsername   String
  reason              String
  /// Art des Jails. Bestehende Einträge wurden bei der Migration als
  /// TEMPORARY übernommen.
  type                JailType         @default(TEMPORARY)
  /// Geplante Dauer. NULL bei einem permanenten Jail.
  durationSeconds     Int?
  startedAt           DateTime         @default(now())
  /// Geplantes Ende. NULL bei einem permanenten Jail - bewusst kein
  /// künstliches Datum wie 31.12.9999, damit Abfragen ehrlich bleiben.
  endsAt              DateTime?
  releasedAt          DateTime?
  releaseType         JailReleaseType?
  releasedByDiscordId String?
  releasedByUsername  String?
  /// Rollen vor dem Jail als flache ID-Liste.
  ///
  /// Bleibt als schneller Lesepfad erhalten (Rollen setzen braucht nur IDs);
  /// die sprechende Fassung mit Name und Position steht in `roleSnapshotEntries`.
  roleSnapshot        String[]         @default([])
  /// Rollen, die während des Jails erhalten blieben.
  keptRoleIds         String[]         @default([])
  /// Beim Release erfolgreich wiederhergestellte Rollen.
  restoredRoleIds     String[]         @default([])
  /// Rollen, die nicht wiederhergestellt werden konnten (gelöscht, zu hoch, ...).
  failedRoleIds       String[]         @default([])
  status              ActionStatus     @default(PENDING)
  releaseStatus       ActionStatus?
  errorCode           String?
  errorMessage        String?
  /// Gesetzt solange der Jail aktiv ist (= targetDiscordId). NULL nach dem
  /// Release. Der Unique-Index verhindert dadurch zwei gleichzeitig aktive
  /// Jails für dasselbe Mitglied (Race Condition Schutz).
  activeKey           String?          @unique
  /// Verhindert doppelte Ausführung bei Doppelklick/Retry.
  idempotencyKey      String?          @unique
  /// Herkunft des Jails - Dashboard, Slash Command, Abstimmung oder Import.
  source              JailSource       @default(DASHBOARD)
  /// Fachlicher Zustand (siehe `JailLifecycle`).
  lifecycle           JailLifecycle    @default(PENDING)
  /// Stille Strafe: keine öffentliche Ankündigung, kein Ping.
  silent              Boolean          @default(false)
  /// Mitglied wurde beim Jail aus dem Sprachkanal getrennt.
  voiceDisconnected   Boolean          @default(false)
  /// Zeitpunkt, an dem das Mitglied den Server während des Jails verlassen hat.
  leftGuildAt         DateTime?
  /// Anzahl erneuter Anwendungen nach einem Rejoin.
  reappliedCount      Int              @default(0)
  /// Legacy-Schlüssel aus dem alten Bot (`userId:startEpoch`) - macht den
  /// Import wiederholbar, ohne Duplikate anzulegen.
  legacyKey           String?          @unique
  importId            String?
  import              JailImport?      @relation(fields: [importId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  /// Vote Jail, aus dem dieser Jail entstanden ist (falls zutreffend).
  voteJail            VoteJail?
  /// Rollen-Snapshot mit Name und Position zum Zeitpunkt des Jails.
  roleSnapshotEntries JailRoleSnapshot[]

  @@index([targetDiscordId, startedAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
  @@index([moderatorDiscordId])
  @@index([lifecycle])
  @@index([source])
  @@index([importId])
}

/// Eine Rolle im Rollen-Snapshot eines Jails.
///
/// Der alte Bot speicherte die Rollen als kommaseparierten Text. Hier steht
/// jede Rolle als eigene Zeile - inklusive Name und Position zum Zeitpunkt des
/// Jails. Dadurch bleibt die Historie auch dann lesbar, wenn eine Rolle
/// zwischenzeitlich umbenannt oder gelöscht wurde.
model JailRoleSnapshot {
  id                 String    @id @default(cuid())
  jailId             String
  jail               JailEntry @relation(fields: [jailId], references: [id], onDelete: Cascade)
  roleId             String
  /// Name zum Zeitpunkt des Jails. NULL, wenn die Rolle damals nicht
  /// aufgelöst werden konnte (z.B. beim Import einer Altdatenbank).
  roleNameAtTime     String?
  rolePositionAtTime Int?
  /// Von Discord verwaltete Rolle (Booster, Integration).
  managedAtTime      Boolean   @default(false)
  /// Rolle blieb während des Jails bewusst erhalten.
  kept               Boolean   @default(false)
  /// Beim Release erfolgreich zurückgegeben.
  restoredAt         DateTime?
  /// Grund, weshalb die Rolle nicht zurückgegeben werden konnte.
  restoreFailedCode  String?
  createdAt          DateTime  @default(now())

  @@unique([jailId, roleId])
  @@index([jailId])
  @@index([roleId])
}

/// Sperrfrist für Initiatoren einer erfolgreichen Abstimmung.
///
/// Eigene Tabelle statt eines Feldes am Mitglied: die Sperre überlebt einen
/// Neustart und lässt sich unabhängig von Discord-Daten aufräumen.
model VoteJailCooldown {
  id             String   @id @default(cuid())
  discordId      String   @unique
  username       String?
  lastVoteJailId String?
  startedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Ein Durchlauf des Legacy-Imports.
///
/// Die hochgeladene SQLite-Datei wird ausschliesslich gelesen und nach der
/// Analyse gelöscht; hier bleibt nur das Ergebnis stehen.
model JailImport {
  id                   String           @id @default(cuid())
  /// Ursprünglicher Dateiname - nur zur Anzeige, nie als Pfad verwendet.
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               JailImportStatus @default(ANALYSED)
  /// Gefundene Tabellen und Spalten der Legacy-Datei.
  schemaInfo           Json?
  totalRows            Int              @default(0)
  importableRows       Int              @default(0)
  duplicateRows        Int              @default(0)
  releasedRows         Int              @default(0)
  invalidRows          Int              @default(0)
  conflictRows         Int              @default(0)
  importedRows         Int              @default(0)
  failedRows           Int              @default(0)
  /// Bestätigung, dass der alte Bot gestoppt wurde.
  legacyBotStopped     Boolean          @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  finishedAt           DateTime?
  rows                 JailImportRow[]
  jails                JailEntry[]

  @@index([status, createdAt])
}

/// Eine Zeile der Legacy-Datenbank mit der Entscheidung des Assistenten.
model JailImportRow {
  id                 String              @id @default(cuid())
  importId           String
  import             JailImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Stabiler Schlüssel aus der Legacy-Zeile (`userId:startEpoch`).
  legacyKey          String
  targetDiscordId    String
  roleIds            String[]            @default([])
  moderatorDiscordId String?
  reason             String?
  startedAt          DateTime?
  endsAt             DateTime?
  permanent          Boolean             @default(false)
  /// Optionales Geschlechterfeld des alten Bots (nur für die Anrede).
  gender             String?
  legacyStatus       String?
  action             JailImportRowAction
  /// Erklärung für die Auswahl - erscheint in der Vorschau.
  note               String?
  jailId             String?
  imported           Boolean             @default(false)
  createdAt          DateTime            @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, action])
}

/// Community-Abstimmung, die bei Erfolg einen regulären Jail auslöst.
/// Die eigentliche Jail-Ausführung übernimmt der bestehende Jail-Service -
/// hier wird ausschliesslich die Abstimmung verwaltet.
model VoteJail {
  id                   String         @id @default(cuid())
  targetDiscordId      String
  targetUsername       String
  targetDisplayName    String?
  targetAvatarHash     String?
  startedByDiscordId   String
  startedByUsername    String
  startedByAvatarHash  String?
  reason               String?
  status               VoteJailStatus @default(ACTIVE)
  requiredVotes        Int
  /// Zwischenstand, damit Listen ohne Aggregat auskommen. Wird ausschliesslich
  /// innerhalb der Vote-Transaktion fortgeschrieben.
  voteCount            Int            @default(0)
  /// Jail-Dauer in Minuten bei erfolgreicher Abstimmung.
  resultingJailMinutes Int
  discordChannelId     String?
  discordMessageId     String?
  /// Verhindert, dass zwei gleichzeitige Klicks zwei Jails auslösen.
  resultingJailId      String?        @unique
  resultingJail        JailEntry?     @relation(fields: [resultingJailId], references: [id])
  /// Gesetzt solange die Abstimmung läuft (= targetDiscordId). Der
  /// Unique-Index verhindert zwei gleichzeitige Abstimmungen gegen dieselbe
  /// Person.
  activeKey            String?        @unique
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  finishedAt           DateTime?
  votes                VoteJailVote[]

  @@index([status, expiresAt])
  @@index([targetDiscordId, createdAt])
}

/// Einzelne Stimme. Normale Mitglieder haben genau einen Eintrag
/// (Unique-Index), Berechtigte mit `jail.vote.multivote` mehrere - deshalb
/// zählt `voteNumber` mit.
model VoteJailVote {
  id             String   @id @default(cuid())
  voteJailId     String
  voteJail       VoteJail @relation(fields: [voteJailId], references: [id], onDelete: Cascade)
  voterDiscordId String
  voterUsername  String?
  /// Laufende Nummer der Stimme dieses Mitglieds in dieser Abstimmung.
  voteNumber     Int      @default(1)
  isAdminVote    Boolean  @default(false)
  createdAt      DateTime @default(now())

  /// Eine Stimme pro Mitglied und Nummer: normale Mitglieder kommen nie über
  /// Nummer 1 hinaus, Mehrfachstimmen erhalten aufsteigende Nummern.
  @@unique([voteJailId, voterDiscordId, voteNumber])
  @@index([voteJailId])
}

/// Über die WebApp im Namen des Bots gesendete Discord-Nachrichten.
model CommunicationMessage {
  id                 String              @id @default(cuid())
  type               CommunicationType
  status             CommunicationStatus @default(SENT)
  source             CommunicationSource @default(WEBAPP)
  title              String
  content            String
  bannerUrl          String?
  discordChannelId   String
  discordChannelName String?
  discordMessageId   String?
  sentByDiscordId    String
  sentByUsername     String
  sentByAvatarHash   String?
  sentAt             DateTime            @default(now())
  /// Auf Discord gelöscht - der Verlaufseintrag bleibt für die Nachvollziehbarkeit.
  deletedAt          DateTime?
  deletedByDiscordId String?
  editedAt           DateTime?
  editedByDiscordId  String?

  /// Fehlerklasse eines gescheiterten Versands - ohne Zugangsdaten.
  failureCode    String?
  failureMessage String?

  mentionType   CommunicationMentionType @default(NONE)
  /// Rollen- oder Benutzer-ID der Erwaehnung.
  mentionTarget String?

  /// --- Nur bei EVENT ---
  eventLocation      String?
  /// Zeitpunkt des Events. Der Slash Command laesst auch freien Text zu,
  /// dann bleibt dieses Feld leer und `eventDateText` traegt die Angabe.
  eventStartsAt      DateTime?
  eventDateText      String?
  eventResponsibleId String?
  registrationType   CommunicationRegistrationType @default(NONE)
  /// Freitext, Channel-ID oder Adresse - je nach `registrationType`.
  registrationValue  String?

  /// Typspezifische Zusatzdaten, die kein eigenes Feld brauchen.
  metadata       Json    @default("{}")
  /// Verhindert doppeltes Senden bei Doppelklick oder Retry.
  idempotencyKey String? @unique
  /// Verbindet Browser-Anfrage, Server Action, Discord-Aufruf und Audit-Eintrag.
  correlationId  String?

  @@index([sentAt])
  @@index([type, sentAt])
  @@index([status, sentAt])
  @@index([discordChannelId])
  @@index([sentByDiscordId])
}

/// Ein vorbereiteter Beitrag, der noch nicht gesendet wurde.
///
/// Bewusst getrennt von `CommunicationMessage`: ein Entwurf hat weder Channel-
/// noch Discord-Nachricht und wird beliebig oft ueberschrieben, waehrend ein
/// gesendeter Eintrag unveraenderlich protokolliert, was tatsaechlich rausging.
model CommunicationDraft {
  id      String            @id @default(cuid())
  type    CommunicationType
  title   String
  content String

  bannerUrl        String?
  discordChannelId String?

  mentionType   CommunicationMentionType @default(NONE)
  mentionTarget String?

  eventLocation      String?
  eventStartsAt      DateTime?
  eventResponsibleId String?
  registrationType   CommunicationRegistrationType @default(NONE)
  registrationValue  String?

  createdByDiscordId String
  createdByUsername  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdByDiscordId, updatedAt])
  @@index([updatedAt])
}

/// Modulunabhängige Moderationshistorie (Basis für Statistiken).
model ModerationAction {
  id              String               @id @default(cuid())
  type            ModerationActionType
  module          String
  actorDiscordId  String
  actorUsername   String
  targetDiscordId String
  targetUsername  String
  reason          String?
  status          ActionStatus         @default(COMPLETED)
  referenceId     String?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())

  @@index([targetDiscordId, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([createdAt])
}

/// Manipulationsgeschütztes Audit Log (Hash-Chain).
model AuditLog {
  id              String   @id @default(cuid())
  sequence        BigInt   @unique @default(autoincrement())
  createdAt       DateTime @default(now())
  action          String
  module          String?
  actorDiscordId  String?
  actorUsername   String?
  targetDiscordId String?
  targetLabel     String?
  success         Boolean  @default(true)
  errorCode       String?
  errorMessage    String?
  metadata        Json     @default("{}")
  ipHash          String?
  userAgent       String?
  /// Hash des vorherigen Eintrags - erlaubt das Erkennen von Manipulationen.
  previousHash    String?
  hash            String

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([targetDiscordId, createdAt])
  @@index([success, createdAt])
}

/// Sicherheitsrelevante Ereignisse (fehlende Berechtigungen, CSRF, ...).
model SecurityEvent {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  type      String
  severity  SecuritySeverity @default(LOW)
  discordId String?
  ipHash    String?
  userAgent String?
  path      String?
  metadata  Json             @default("{}")

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([discordId, createdAt])
}

/// Serverseitiges Rate Limiting (Fixed Window).
model RateLimitCounter {
  bucket      String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

/// Idempotenzschlüssel für kritische Aktionen.
model IdempotencyRecord {
  key            String       @id
  scope          String
  actorDiscordId String
  status         ActionStatus @default(PENDING)
  resultRef      String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([scope, actorDiscordId])
}

/// Laufzeitstatus des Discord-Bots (vom Bot geschrieben, von der WebApp gelesen).
model BotStatus {
  id               String    @id @default("singleton")
  online           Boolean   @default(false)
  wsPingMs         Int?
  guildMemberCount Int?
  botUserId        String?
  botUsername      String?
  version          String?
  lastHeartbeatAt  DateTime  @default(now())
  lastConnectedAt  DateTime?
  lastError        String?
  updatedAt        DateTime  @updatedAt
}

/// Abgleich zwischen Datenbank- und Discord-Zustand.
model ReconciliationRun {
  id          String             @id @default(cuid())
  module      String
  mode        ReconciliationMode @default(AUTOMATIC)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  checked     Int                @default(0)
  drift       Int                @default(0)
  repaired    Int                @default(0)
  failed      Int                @default(0)
  triggeredBy String?
  details     Json               @default("{}")

  @@index([module, startedAt])
}

/// Ein im Dashboard gepflegtes Spiel.
///
/// Der alte Bot kannte Spiele nur pro Guild; diese Anwendung ist auf genau
/// einen Server konfiguriert, deshalb genuegt der Name als Schluessel.
model SpielersucheGame {
  id                 String                @id @default(cuid())
  name               String
  /// Kleingeschriebener Name - macht die Eindeutigkeit unabhaengig von
  /// Gross-/Kleinschreibung (der alte Bot nutzte dafuer COLLATE NOCASE).
  nameKey            String                @unique
  /// Rolle, die beim Start einer Suche erwaehnt wird.
  roleId             String
  bannerUrl          String?
  /// Maximale Gruppengroesse. NULL = unbegrenzt.
  maxSquadSize       Int?
  enabled            Boolean               @default(true)
  sortOrder          Int                   @default(0)
  /// `games.id` aus der Altdatenbank - macht den Import wiederholbar.
  legacyId           Int?                  @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdByDiscordId String?
  matches            SpielersucheMatch[]
  rolePing           SpielersucheRolePing?

  @@index([enabled, name])
}

/// Eine Spielersuche.
model SpielersucheMatch {
  id                 String                     @id @default(cuid())
  creatorDiscordId   String
  creatorUsername    String
  creatorDisplayName String?
  creatorAvatarHash  String?
  gameId             String?
  game               SpielersucheGame?          @relation(fields: [gameId], references: [id])
  /// Name zum Zeitpunkt der Suche - bleibt lesbar, auch wenn das Spiel
  /// spaeter umbenannt oder geloescht wird.
  gameName           String
  pingRoleId         String?
  /// Wurde die Spielrolle bei dieser Suche tatsaechlich erwaehnt?
  rolePinged         Boolean                    @default(false)
  bannerUrl          String?
  /// Zusaetzlich gesuchte Spieler. Der Ersteller zaehlt bereits als Teilnehmer.
  requestedPlayers   Int
  comment            String?
  status             SpielersucheStatus         @default(OPEN)
  source             SpielersucheSource         @default(SLASH_COMMAND)
  channelId          String?
  messageId          String?                    @unique
  voiceChannelId     String?
  voiceChannelName   String?
  /// Squad-Groesse des Spiels zum Zeitpunkt der Suche (NULL = unbegrenzt).
  maxSquadSize       Int?
  createdAt          DateTime                   @default(now())
  expiresAt          DateTime
  closedAt           DateTime?
  closedByDiscordId  String?
  closeReason        String?
  /// Gesetzt, solange die Suche laeuft: `<creatorDiscordId>#<Platznummer>`.
  /// Der Unique-Index begrenzt dadurch die Zahl gleichzeitiger Suchen pro
  /// Person auf Datenbankebene - nicht nur im Anwendungscode.
  activeCreatorKey   String?                    @unique
  idempotencyKey     String?                    @unique
  /// `matches.id` aus der Altdatenbank.
  legacyId           Int?                       @unique
  importId           String?
  import             SpielersucheImport?        @relation(fields: [importId], references: [id])
  participants       SpielersucheParticipant[]
  voiceSessions      SpielersucheVoiceSession[]

  @@index([status, expiresAt])
  @@index([creatorDiscordId, createdAt])
  @@index([gameId])
  @@index([voiceChannelId])
  @@index([createdAt])
}

/// Teilnahme an einer Suche.
///
/// Ein Austritt loescht die Zeile nicht, sondern setzt `leftAt`. Dadurch
/// bleibt die Teilnahmehistorie erhalten und der Unique-Index verhindert
/// trotzdem zuverlaessig doppelte Teilnahmen.
model SpielersucheParticipant {
  id          String            @id @default(cuid())
  matchId     String
  match       SpielersucheMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  discordId   String
  username    String?
  displayName String?
  avatarHash  String?
  isCreator   Boolean           @default(false)
  joinedAt    DateTime          @default(now())
  leftAt      DateTime?

  @@unique([matchId, discordId])
  @@index([discordId, joinedAt])
  @@index([matchId, leftAt])
}

/// Letzter Rollen-Ping je Spiel - Grundlage des Ping-Cooldowns.
model SpielersucheRolePing {
  id       String           @id @default(cuid())
  gameId   String           @unique
  game     SpielersucheGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roleId   String
  pingedAt DateTime

  @@index([pingedAt])
}

/// Nutzung der Spielersuche - Grundlage der Statistik und der Rangliste.
model SpielersucheUsage {
  id        String             @id @default(cuid())
  discordId String
  /// Immer `spielersuche`; das Feld bleibt fuer spaetere Befehle offen.
  command   String             @default("spielersuche")
  source    SpielersucheSource @default(SLASH_COMMAND)
  usedAt    DateTime           @default(now())
  legacyId  Int?               @unique

  @@index([discordId, usedAt])
  @@index([usedAt])
}

/// Zeit in einem von der Spielersuche erstellten Sprachkanal.
model SpielersucheVoiceSession {
  id              String             @id @default(cuid())
  discordId       String
  matchId         String?
  match           SpielersucheMatch? @relation(fields: [matchId], references: [id])
  voiceChannelId  String
  joinedAt        DateTime
  leftAt          DateTime?
  durationSeconds Int                @default(0)
  legacyId        Int?               @unique

  @@index([discordId, joinedAt])
  @@index([voiceChannelId, leftAt])
  @@index([matchId])
}

/// Ein Durchlauf der Uebernahme aus `matchmaking.db`.
model SpielersucheImport {
  id                   String                   @id @default(cuid())
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               SpielersucheImportStatus @default(ANALYSED)
  schemaInfo           Json?
  /// Guild, deren Daten uebernommen werden. Die Altdatenbank kann mehrere
  /// Server enthalten (Test- und Produktivserver).
  sourceGuildId        String?
  totalRows            Int                      @default(0)
  importableRows       Int                      @default(0)
  duplicateRows        Int                      @default(0)
  invalidRows          Int                      @default(0)
  otherGuildRows       Int                      @default(0)
  conflictRows         Int                      @default(0)
  importedRows         Int                      @default(0)
  failedRows           Int                      @default(0)
  legacyBotStopped     Boolean                  @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime                 @default(now())
  finishedAt           DateTime?
  items                SpielersucheImportItem[]
  matches              SpielersucheMatch[]

  @@index([status, createdAt])
}

/// Eine bewertete Zeile aus der Altdatenbank.
model SpielersucheImportItem {
  id        String                   @id @default(cuid())
  importId  String
  import    SpielersucheImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      SpielersucheImportKind
  /// Stabiler Schluessel der Legacy-Zeile, z.B. `game:18`.
  legacyKey String
  label     String
  action    SpielersucheImportAction
  note      String?
  /// Die gelesenen Werte - Grundlage fuer die Uebernahme und die Vorschau.
  payload   Json
  imported  Boolean                  @default(false)
  targetId  String?
  createdAt DateTime                 @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, kind, action])
}

// ---------------------------------------------------------------------------
// Level-System
//
// Der alte Level-Bot fuehrte nur Endstaende (`levels.xp`). Wer wissen wollte,
// woher eine Zahl kommt, musste die Discord-Logs durchsuchen. Hier ist jede
// Aenderung eine Zeile in `XpTransaction`; `LevelProfile.xp` ist die Summe
// daraus und wird in derselben Transaktion fortgeschrieben.
// ---------------------------------------------------------------------------

/// Woher eine XP-Buchung stammt.
enum XpSource {
  MESSAGE
  VOICE
  GAME_WIN
  GAME_LOSS
  /// Einsatz, der beim Start eines Spiels zurueckgelegt wird.
  GAME_STAKE
  /// Rueckgabe des Einsatzes bei Unentschieden, Abbruch oder Zeitablauf.
  GAME_REFUND
  ADMIN
  DECAY
  BOOST
  MIGRATION
  SYSTEM
  /// Einsatz fuer eine XP-Verlosung.
  RAFFLE_ENTRY
  /// Rueckzahlung eines Verlosungs-Einsatzes.
  RAFFLE_REFUND
  /// XP-Gewinn aus einer Verlosung.
  RAFFLE_PRIZE
}

enum XpGameKind {
  XP_BATTLE
  XP_SSP
  XP_TTT
  XP_4GEWINNT
}

enum XpGameStatus {
  /// Herausgefordert, noch nicht angenommen.
  PENDING
  RUNNING
  FINISHED
  DRAW
  DECLINED
  TIMEOUT
  CANCELLED
}

enum LevelImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTED
  FAILED
}

enum LevelImportKind {
  PROFILE
  GAME_STATS
  NO_XP_CHANNEL
  CONFIG
  GUILD_CONFIG
  ENV_SETTING
}

enum LevelImportAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_INVALID
  SKIP_EMPTY
  CONFLICT
}

/// XP-Stand einer Person.
model LevelProfile {
  id               String    @id @default(cuid())
  discordId        String    @unique
  username         String?
  displayName      String?
  avatarHash       String?
  /// Nie negativ - der alte Bot klemmte mit `MAX(0, xp + delta)`.
  xp               Int       @default(0)
  messages         Int       @default(0)
  voiceMinutes     Int       @default(0)
  /// Setzt die Nachlassfrist zurueck (Nachricht oder Voice).
  lastActivityAt   DateTime?
  /// Bis hierhin wurde Inaktivitaets-Abzug bereits verrechnet.
  lastDecayAt      DateTime?
  lastMessageAt    DateTime?
  lastVoiceAt      DateTime?
  /// SHA-256 der `levels.db`, aus der dieser Stand uebernommen wurde.
  /// Verhindert, dass dieselbe Datei zweimal XP setzt.
  legacyImportSha  String?
  legacyImportedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions XpTransaction[]
  gameStats    LevelGameStats[]

  @@index([xp])
  @@index([lastActivityAt])
  @@index([lastDecayAt])
}

/// Eine einzelne XP-Buchung. Fortlaufendes Journal, wird nie geaendert.
model XpTransaction {
  id             String          @id @default(cuid())
  profileId      String
  profile        LevelProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  discordId      String
  source         XpSource
  /// Tatsaechlich verbuchte Aenderung, nachdem auf >= 0 XP geklemmt wurde.
  delta          Int
  /// Angeforderte Aenderung vor der Klemmung. Weicht nur ab, wenn ein Abzug
  /// groesser war als der Punktestand.
  requestedDelta Int
  xpBefore       Int
  xpAfter        Int
  levelBefore    Int
  levelAfter     Int
  reason         String?
  actorDiscordId String?
  channelId      String?
  gameMatchId    String?
  gameMatch      LevelGameMatch? @relation(fields: [gameMatchId], references: [id])
  importId       String?
  import         LevelImport?    @relation(fields: [importId], references: [id])
  /// Schuetzt Wiederholungen vor Doppelbuchungen.
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())

  @@index([discordId, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@index([gameMatchId])
}

/// Eine Partie eines XP-Spiels.
model LevelGameMatch {
  id                  String       @id @default(cuid())
  kind                XpGameKind
  status              XpGameStatus @default(PENDING)
  challengerDiscordId String
  opponentDiscordId   String
  bet                 Int
  /// Auszahlung an den Gewinner: `floor(bet * 2 * 0.95)` wie beim Vorgaenger.
  payout              Int
  /// Einsaetze beider Seiten liegen bereits im Topf.
  potHeld             Boolean      @default(false)
  winnerDiscordId     String?
  guildId             String?
  channelId           String?
  messageId           String?
  createdAt           DateTime     @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  expiresAt           DateTime?
  /// Solange eine Partie laeuft: die Discord-ID der jeweiligen Seite. Der
  /// Vorgaenger merkte sich das nur im Arbeitsspeicher und vergass es beim
  /// Neustart; hier haelt die Datenbank die Sperre.
  activeChallengerKey String?      @unique
  activeOpponentKey   String?      @unique
  /// Spielstand laufender Partien (Spielfeld, Punkte, wer am Zug ist).
  /// Beim Vorgaenger lag er im Arbeitsspeicher und ging bei jedem Neustart
  /// verloren - mitsamt den bereits eingezogenen Einsaetzen.
  state               Json?

  transactions XpTransaction[]

  @@index([kind, status])
  @@index([status, expiresAt])
  @@index([challengerDiscordId, createdAt])
  @@index([opponentDiscordId, createdAt])
}

/// Bilanz einer Person je Spielart.
model LevelGameStats {
  id        String       @id @default(cuid())
  profileId String
  profile   LevelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  discordId String
  kind      XpGameKind
  wins      Int          @default(0)
  losses    Int          @default(0)
  draws     Int          @default(0)
  xpWon     Int          @default(0)
  xpLost    Int          @default(0)
  updatedAt DateTime     @updatedAt

  @@unique([discordId, kind])
  @@index([kind, wins])
}

/// Rolle, die ab einem bestimmten Level vergeben wird.
///
/// Loeste `MILESTONE_ROLES="5:ROLEID,10:ROLEID"` aus der alten `.env` ab.
model LevelMilestoneRole {
  id        String   @id @default(cuid())
  level     Int      @unique
  roleId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, level])
}

/// Ein Uebernahmelauf aus der alten `levels.db`.
model LevelImport {
  id                   String            @id @default(cuid())
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               LevelImportStatus @default(ANALYSED)
  schemaInfo           Json?
  totalRows            Int               @default(0)
  importableRows       Int               @default(0)
  duplicateRows        Int               @default(0)
  invalidRows          Int               @default(0)
  conflictRows         Int               @default(0)
  importedRows         Int               @default(0)
  failedRows           Int               @default(0)
  /// Bestaetigung, dass der alte Bot abgeschaltet ist. Ohne sie wuerden
  /// beide Bots gleichzeitig XP vergeben.
  legacyBotStopped     Boolean           @default(false)
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime          @default(now())
  finishedAt           DateTime?

  items        LevelImportItem[]
  transactions XpTransaction[]

  @@index([status, createdAt])
  @@index([fileSha256])
}

/// Eine bewertete Zeile aus der Altdatenbank.
model LevelImportItem {
  id        String            @id @default(cuid())
  importId  String
  import    LevelImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind      LevelImportKind
  /// Stabiler Schluessel der Legacy-Zeile, z.B. `profile:123456789`.
  legacyKey String
  label     String
  action    LevelImportAction
  note      String?
  payload   Json
  imported  Boolean           @default(false)
  targetId  String?
  createdAt DateTime          @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, kind, action])
}

// ---------------------------------------------------------------------------
// XP-Verlosungen ("XP-Gluecksrad")
//
// Gehoert fachlich zum Level-System: eingesetzt werden dieselben XP, gebucht
// wird ueber dieselbe Engine, das Journal ist dasselbe `XpTransaction`. Es
// gibt bewusst keine zweite Waehrung und keine getrennte Brieftasche.
// ---------------------------------------------------------------------------

enum XpRaffleStatus {
  /// Entwurf. Alle Einstellungen sind noch frei aenderbar.
  DRAFT
  /// Veroeffentlicht, Teilnahme beginnt zum hinterlegten Zeitpunkt.
  SCHEDULED
  ENTRY_OPEN
  ENTRY_CLOSED
  /// Ziehung laeuft. Ab hier kommt niemand mehr dazu.
  DRAWING
  /// Gewinner steht fest, wartet auf Bestaetigung durch die Verwaltung.
  WINNER_PENDING
  COMPLETED
  CANCELLED
}

enum XpRaffleEntryModel {
  /// Alle zahlen denselben Betrag und haben dieselbe Chance.
  FIXED
  /// Anteil der eigenen XP; die Chance folgt dem Einsatz.
  PERCENTAGE
}

enum XpRaffleEntryStatus {
  ACTIVE
  /// Einsatz zurueckgezahlt (Abbruch oder Entfernung durch die Verwaltung).
  REFUNDED
  /// Von der Ziehung ausgeschlossen, Einsatz zurueckgezahlt.
  DISQUALIFIED
  WINNER
}

enum XpRafflePrizeKind {
  /// Sachpreis ausserhalb des Systems - nur Beschreibung und Verwaltung.
  EXTERNAL_PRIZE
  /// XP-Gutschrift an die gewinnende Person.
  XP_PRIZE
  /// Discord-Rolle, die der Bot nach Bestaetigung vergibt.
  ROLE_PRIZE
  /// Reine Ankuendigung ohne hinterlegten Preis.
  TEXT_ONLY
}

enum XpRaffleRefundReason {
  RAFFLE_CANCELLED
  ENTRY_REMOVED
  MINIMUM_NOT_REACHED
}

/// Eine Verlosung.
model XpRaffle {
  id          String  @id @default(cuid())
  title       String
  description String?
  /// Hochgeladenes Banner (Dateiname im Upload-Verzeichnis).
  bannerPath  String?
  /// Banner als Adresse - Alternative zum Hochladen.
  bannerUrl   String?

  prizeKind        XpRafflePrizeKind @default(EXTERNAL_PRIZE)
  prizeDescription String
  /// Nur bei `XP_PRIZE`: Gutschrift an die gewinnende Person.
  prizeXp          Int?
  /// Nur bei `ROLE_PRIZE`.
  prizeRoleId      String?

  status     XpRaffleStatus     @default(DRAFT)
  entryModel XpRaffleEntryModel

  /// Nur bei `FIXED`.
  fixedEntryXp          Int?
  /// Nur bei `PERCENTAGE`: Anteil in Basispunkten (500 = 5,00 %).
  /// Ganzzahlig, damit der Einsatz nicht von Gleitkomma-Rundung abhaengt.
  percentageBasisPoints Int?
  minimumEntryXp        Int?
  maximumEntryXp        Int?

  /// Ohne diese Zahl wird nicht gezogen.
  minimumParticipants Int  @default(2)
  maximumParticipants Int?

  entryStartsAt   DateTime?
  entryEndsAt     DateTime?
  drawScheduledAt DateTime?
  /// Ziehung zum geplanten Zeitpunkt selbst starten.
  autoDraw        Boolean   @default(false)

  /// Teilnehmerliste fuer angemeldete Mitglieder sichtbar machen.
  participantsPublic Boolean @default(true)
  /// Gewinner nach Bestaetigung selbst auf Discord veroeffentlichen.
  autoAnnounceWinner Boolean @default(true)

  discordChannelId      String?
  discordMessageId      String?
  /// Gesetzt, wenn die Ankuendigung auf Discord nicht mehr auffindbar ist.
  discordMessageMissing Boolean @default(false)
  winnerMessageId       String?

  /// Zaehler fuer die Anzeige. Die Wahrheit sind die Zeilen in `entries`;
  /// diese Felder ersparen der Uebersicht nur das Nachzaehlen.
  entryCount Int @default(0)
  potXp      Int @default(0)

  createdByDiscordId String
  publishedAt        DateTime?
  entryOpenedAt      DateTime?
  entryClosedAt      DateTime?
  drawStartedAt      DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  /// Verhindert, dass ein wiederholter Abbruch zweimal auszahlt.
  refundedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries XpRaffleEntry[]
  draws   XpRaffleDraw[]
  refunds XpRaffleRefund[]

  /// Der gueltige Draw, nachdem er bestaetigt wurde.
  confirmedDrawId String?       @unique
  confirmedDraw   XpRaffleDraw? @relation("ConfirmedDraw", fields: [confirmedDrawId], references: [id])

  @@index([status, entryEndsAt])
  @@index([status, drawScheduledAt])
  @@index([createdAt])
}

/// Die Teilnahme einer Person. Wird nach der Abbuchung nie geloescht.
model XpRaffleEntry {
  id        String   @id @default(cuid())
  raffleId  String
  raffle    XpRaffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  discordId String

  /// Namensstand zum Zeitpunkt der Teilnahme - fuer die Nachvollziehbarkeit.
  username    String?
  displayName String?

  /// XP-Stand unmittelbar vor der Abbuchung.
  xpBeforeEntry Int
  /// Tatsaechlich bezahlter Einsatz. Nach der Teilnahme unveraenderlich -
  /// spaetere XP-Gewinne oder -Verluste beruehren ihn nicht.
  entryXp       Int
  /// Gewicht in der Ziehung: bei `FIXED` immer 1, bei `PERCENTAGE` der Einsatz.
  weight        Int

  status        XpRaffleEntryStatus @default(ACTIVE)
  /// Pflichtgrund, wenn die Verwaltung eine Teilnahme entfernt.
  removalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds  XpRaffleRefund[]
  wonDraws XpRaffleDraw[]   @relation("DrawWinner")

  /// Eine Teilnahme pro Person und Verlosung - auf Datenbankebene, nicht nur
  /// im Anwendungscode. Zwei gleichzeitige Anfragen koennen damit nicht
  /// beide durchkommen.
  @@unique([raffleId, discordId])
  @@index([raffleId, status])
  @@index([discordId, createdAt])
}

/// Eine Ziehung. Jeder Versuch - auch eine Neuziehung - ist eine eigene Zeile.
model XpRaffleDraw {
  id       String   @id @default(cuid())
  raffleId String
  raffle   XpRaffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  /// Fortlaufend ab 1. Eine Neuziehung erhoeht die Nummer.
  version Int

  /// Unveraenderlicher Auszug der gueltigen Teilnahmen zum Zeitpunkt der
  /// Ziehung: `[{ entryId, discordId, weight }]`. Ohne ihn liesse sich
  /// spaeter nicht mehr pruefen, worauf die Ziehung beruhte.
  snapshot Json

  participantCount Int
  totalWeight      Int

  winnerEntryId   String
  winnerEntry     XpRaffleEntry @relation("DrawWinner", fields: [winnerEntryId], references: [id])
  winnerDiscordId String

  /// Der gezogene Punkt auf der Gewichtsachse - zusammen mit dem Auszug laesst
  /// sich die Ziehung damit nachrechnen.
  drawnTicket      Int
  /// Zufallswert der Ziehung, hexadezimal. Dient der Nachvollziehbarkeit.
  entropy          String
  /// Damit eine spaetere Aenderung am Verfahren alte Ziehungen nicht
  /// unerklaerbar macht.
  algorithmVersion Int    @default(1)
  /// Steuert die Animation im Browser. Hat keinen Einfluss auf den Gewinner.
  animationSeed    String

  /// Nur gesetzt, wenn diese Ziehung eine fruehere ersetzt.
  redrawReason     String?
  /// Teilnahmen, die in dieser Ziehung nicht mehr antreten durften.
  excludedEntryIds String[]

  startedByDiscordId   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())

  confirmedFor XpRaffle? @relation("ConfirmedDraw")

  @@unique([raffleId, version])
  @@index([raffleId, createdAt])
}

/// Eine Rueckzahlung. Getrennt gefuehrt, damit ein wiederholter Abbruch nicht
/// zweimal auszahlt und jede Zahlung einzeln nachvollziehbar bleibt.
model XpRaffleRefund {
  id       String        @id @default(cuid())
  raffleId String
  raffle   XpRaffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  entryId  String
  entry    XpRaffleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  discordId      String
  amount         Int
  reason         XpRaffleRefundReason
  note           String?
  actorDiscordId String?
  createdAt      DateTime             @default(now())

  /// Eine Teilnahme wird hoechstens einmal zurueckgezahlt.
  @@unique([entryId])
  @@index([raffleId])
}

// ---------------------------------------------------------------------------
// SwissHub Premium
//
// Ein Abonnement hat drei voneinander unabhaengige Zustaende, die bewusst
// getrennt gefuehrt werden:
//
//   status              - was der Zahlungsanbieter sagt
//   discordSyncStatus   - ob Discord den gewuenschten Zustand erreicht hat
//   PremiumDiscordResource.state - was auf Discord tatsaechlich existiert
//
// Diese Trennung ist der Kern: ein Discord-Ausfall darf eine erfolgreiche
// Zahlung niemals rueckgaengig machen. Er hinterlaesst nur einen fehlerhaften
// Sync, den die Reconciliation spaeter nachholt.
// ---------------------------------------------------------------------------

enum PremiumEntitlement {
  PREMIUM_ROLE
  PREMIUM_STUEBLI_ROLE
  PRIVATE_VOICE
}

enum PremiumSubscriptionStatus {
  /// Checkout begonnen, Zahlung noch nicht bestaetigt.
  PENDING
  /// Bezahlt und laufend.
  ACTIVE
  /// Folgezahlung offen, Schonfrist laeuft.
  PAST_DUE
  /// Zahlung endgueltig fehlgeschlagen, Schonfrist laeuft.
  PAYMENT_FAILED
  /// Gekuendigt, laeuft bis zum Ende der bezahlten Periode.
  CANCEL_AT_PERIOD_END
  /// Vom Mitglied oder der Verwaltung beendet.
  CANCELLED
  /// Periode und Schonfrist abgelaufen - keine Anspruecke mehr.
  EXPIRED
}

enum PremiumPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Hat Discord den gewuenschten Zustand erreicht?
enum PremiumSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PremiumResourceType {
  PREMIUM_STUEBLI_VOICE
}

enum PremiumResourceState {
  PENDING
  ACTIVE
  FAILED
  REMOVING
  REMOVED
}

enum PremiumEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

/// Ein buchbares Angebot. Bewusst in der Datenbank statt im Code: Preise und
/// Texte aendern sich, ohne dass dafuer ein Deployment noetig sein soll.
model PremiumProduct {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  description     String
  /// Preis in Rappen. Niemals Gleitkomma - CHF 5.00 sind 500.
  priceMinor      Int
  currency        String               @default("CHF")
  /// Aufzaehlung fuer die Produktkarte.
  features        Json                 @default("[]")
  /// Welche Anspruechen das Angebot gewaehrt.
  entitlements    PremiumEntitlement[]
  active          Boolean              @default(true)
  sortOrder       Int                  @default(0)
  /// Preis-ID beim Zahlungsanbieter (z.B. Stripe Price). Erst nach der
  /// Einrichtung des Anbieters gesetzt.
  providerPriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions PremiumSubscription[]

  @@index([active, sortOrder])
}

/// Das Abonnement eines Mitglieds. Hoechstens eines davon ist gleichzeitig
/// offen - erzwungen durch `activeUserKey`.
model PremiumSubscription {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Redundant zur Relation, aber der Bot arbeitet ausschliesslich mit
  /// Discord-IDs und soll dafuer nicht jedes Mal joinen muessen.
  discordId String

  productId String
  product   PremiumProduct @relation(fields: [productId], references: [id])

  status PremiumSubscriptionStatus @default(PENDING)

  /// Genau ein offenes Abonnement je Mitglied.
  ///
  /// Traegt die Benutzer-ID, solange das Abonnement offen ist, und `null`,
  /// sobald es beendet ist. Ein Teilindex auf eine nullbare Spalte ist der
  /// einzige Weg, "hoechstens eines" in der Datenbank selbst zu erzwingen -
  /// eine Pruefung in der Anwendung verliert gegen zwei gleichzeitige
  /// Anfragen. Dasselbe Muster nutzt bereits die Spielersuche.
  activeUserKey String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  /// Zeitpunkt der Kuendigung. Die Anspruechen bleiben bis zum Periodenende.
  cancelledAt        DateTime?
  /// Ende der Schonfrist nach einer fehlgeschlagenen Folgezahlung.
  graceUntil         DateTime?
  endedAt            DateTime?

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?

  discordSyncStatus PremiumSyncStatus @default(PENDING)
  lastSyncAt        DateTime?
  lastSyncError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  PremiumPayment[]
  resources PremiumDiscordResource[]

  @@unique([activeUserKey])
  @@unique([providerSubscriptionId])
  @@index([userId, createdAt])
  @@index([status])
  @@index([discordSyncStatus])
}

model PremiumPayment {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  subscription   PremiumSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  provider          String
  providerPaymentId String?
  amountMinor       Int
  currency          String               @default("CHF")
  status            PremiumPaymentStatus @default(PENDING)

  createdAt     DateTime  @default(now())
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  /// Ein Anbieter liefert dieselbe Zahlung mehrfach - einmal je Zustellversuch.
  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
  @@index([status])
}

/// Jede Zustellung des Anbieters, dauerhaft. Grundlage fuer Idempotenz und
/// dafuer, einen fehlgeschlagenen Verarbeitungsversuch spaeter nachzuvollziehen.
model PremiumPaymentEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String

  processingStatus PremiumEventStatus @default(RECEIVED)
  payload          Json               @default("{}")

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  error       String?

  /// Der Kern der Idempotenz: eine zweite Zustellung desselben Ereignisses
  /// laeuft in diesen Schluessel und wird verworfen.
  @@unique([provider, providerEventId])
  @@index([processingStatus, createdAt])
}

/// Was auf Discord fuer ein Mitglied tatsaechlich angelegt wurde.
model PremiumDiscordResource {
  id             String               @id @default(cuid())
  userId         String
  discordId      String
  subscriptionId String?
  subscription   PremiumSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  guildId      String
  resourceType PremiumResourceType

  discordResourceId String?
  discordCategoryId String?
  /// Name des Kanals, damit die Verwaltung ihn auch nach dem Loeschen kennt.
  name              String?

  state PremiumResourceState @default(PENDING)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  removedAt     DateTime?
  lastSyncAt    DateTime?
  lastSyncError String?

  /// Ein Mitglied hat hoechstens ein Stuebli. Doppelklick, Webhook-Wiederholung
  /// und paralleler Sync laufen alle in diesen Schluessel.
  @@unique([userId, resourceType])
  @@index([state])
  @@index([discordResourceId])
}

// ===========================================================================
// SwissHub Music
//
// Der Legacy-Bot hielt seinen gesamten Zustand im Arbeitsspeicher eines
// einzigen Python-Prozesses: `active_session[(guild_id, channel_id)]` als
// Zuordnung, `asyncio.Queue` als Warteschlange. Das funktioniert, solange
// genau ein Prozess existiert und nie neu startet - beides trifft hier nicht
// mehr zu. WebApp und Voice-Runtime sind getrennte Prozesse, und die WebApp
// laeuft potenziell mehrfach.
//
// Deshalb liegt der *steuernde* Zustand in der Datenbank: wer welchem Kanal
// zugewiesen ist, was in der Warteschlange steht, welcher Befehl noch offen
// ist. Der *fluechtige* Zustand - der laufende FFmpeg-Prozess, die
// Voice-Verbindung selbst - bleibt bewusst in der Runtime. Er ueberlebt
// keinen Neustart, und so zu tun, als waere das anders, waere gelogen.
// ===========================================================================

/// Controller oder Worker? Der Unterschied ist reine Zuweisungspolitik:
/// technisch spielt beides identisch ab.
enum MusicBotType {
  CONTROLLER
  WORKER
}

enum MusicBotStatus {
  OFFLINE
  FREE
  BUSY
  CONNECTING
  DEGRADED
  DRAINING
  DISABLED
}

enum MusicSessionStatus {
  STARTING
  ACTIVE
  DEGRADED
  ENDED
}

enum MusicLoopMode {
  OFF
  TRACK
  QUEUE
}

/// Warum eine Session endete - fuer den Verlauf und die Fehlersuche.
enum MusicSessionEndReason {
  MANUAL
  IDLE_TIMEOUT
  ALONE_TIMEOUT
  WORKER_OFFLINE
  ADMIN_FORCED
  MODULE_DISABLED
  STALE_RECONCILED
}

enum MusicCommandKind {
  PLAY
  PAUSE
  RESUME
  SKIP
  STOP
  LEAVE
  JOIN
  SET_VOLUME
  SET_LOOP
  QUEUE_ADD
  QUEUE_REMOVE
  QUEUE_MOVE
  QUEUE_SHUFFLE
}

enum MusicCommandStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  TIMEOUT
}

/// Ein Bot des Pools.
///
/// Bewusst OHNE Token-Spalte. Die Tokens sind Infrastruktur-Geheimnisse und
/// kommen aus der Umgebung der Voice-Runtime; die Datenbank kennt nur die
/// Identitaet und den Zustand. Ein Klartext-Token in einer normalen Tabelle
/// waere genau der Fehler, den die Legacy-config.json bereits gemacht hat.
model MusicBotInstance {
  id   String       @id @default(cuid())
  type MusicBotType

  /// Stabiler interner Schluessel: CONTROLLER, WORKER_1, WORKER_2 ...
  /// Nicht die Position in einem Array - die verschiebt sich.
  key  String
  /// Anzeigename aus Discord, sobald der Bot sich einmal gemeldet hat.
  name String?

  discordUserId String?
  avatarHash    String?

  /// Vom Betrieb abschaltbar. Ein abgeschalteter Bot bekommt keine neuen
  /// Sessions, behaelt eine laufende aber, bis sie normal endet.
  enabled Boolean        @default(true)
  status  MusicBotStatus @default(OFFLINE)

  lastHeartbeatAt DateTime?
  lastError       String?
  startedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions MusicSession[]

  @@unique([key])
  @@unique([discordUserId])
  @@index([status, enabled])
}

/// Eine Musik-Session in genau einem Voice-Kanal.
model MusicSession {
  id      String @id @default(cuid())
  guildId String

  voiceChannelId   String
  voiceChannelName String?

  botInstanceId String?
  botInstance   MusicBotInstance? @relation(fields: [botInstanceId], references: [id], onDelete: SetNull)

  status MusicSessionStatus @default(STARTING)

  /// Genau eine offene Session je Voice-Kanal.
  ///
  /// Traegt "<guildId>:<voiceChannelId>", solange die Session laeuft, und
  /// `null`, sobald sie beendet ist. Derselbe Teilindex-Trick wie bei
  /// Premium: zwei gleichzeitige /join duerfen nicht zwei Sessions erzeugen,
  /// und das entscheidet die Datenbank, nicht die Anwendung.
  activeChannelKey String?

  /// Genau eine offene Session je Bot.
  ///
  /// Traegt die Bot-ID, solange die Session laeuft. Verhindert, dass zwei
  /// gleichzeitige Zuweisungen denselben Worker in zwei Kanaele schicken -
  /// die Race Condition, gegen die eine In-Memory-Map machtlos ist.
  activeBotKey String?

  loopMode MusicLoopMode @default(OFF)
  /// Lautstaerke in Prozent, 0-150 wie im Legacy-System. Ganzzahlig.
  volume   Int           @default(50)

  /// Der laufende Titel. Zeigt auf das Warteschlangenelement, damit Titel,
  /// Dauer und Besteller nicht doppelt gefuehrt werden.
  currentItemId  String?
  /// Beginn des laufenden Titels - Grundlage der Fortschrittsberechnung im
  /// Browser. Ohne diesen Wert muesste die Oberflaeche sekuendlich fragen.
  trackStartedAt DateTime?
  pausedAt       DateTime?
  /// Aufsummierte Pausendauer in Millisekunden.
  pausedMs       Int       @default(0)

  /// Letzte echte Aktivitaet - Grundlage des Leerlauf-Disconnects.
  lastActivityAt DateTime  @default(now())
  /// Seit wann der Bot allein im Kanal ist; `null`, sobald jemand zuhoert.
  aloneSince     DateTime?
  listenerCount  Int       @default(0)

  startedByDiscordUserId String?

  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  endedAt   DateTime?
  endReason MusicSessionEndReason?

  queue    MusicQueueItem[]
  history  MusicPlaybackHistory[]
  commands MusicCommand[]

  @@unique([activeChannelKey])
  @@unique([activeBotKey])
  @@index([guildId, status])
  @@index([status, lastActivityAt])
}

/// Ein Element der Warteschlange.
model MusicQueueItem {
  id        String       @id @default(cuid())
  sessionId String
  session   MusicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Luecken erlaubt: Verschieben und Entfernen sollen nicht die halbe
  /// Warteschlange neu schreiben muessen.
  position Int

  provider        String
  providerTrackId String?
  title           String
  artist          String?
  /// Die Seiten-URL, NICHT die Stream-URL.
  ///
  /// YouTube-Stream-URLs tragen eine ablaufende Signatur. Der Legacy-Bot holt
  /// deshalb unmittelbar vor dem Abspielen eine frische URL - dieses
  /// Verhalten bleibt, und deshalb wird hier nur die dauerhafte Seiten-URL
  /// gespeichert.
  webpageUrl      String
  durationSeconds Int     @default(0)
  thumbnailUrl    String?

  requestedByDiscordUserId String?
  requestedByUsername      String?

  /// Nicht mehr abspielbar (Video geloescht, gesperrt). Bleibt sichtbar,
  /// damit erklaerbar ist, warum uebersprungen wurde.
  unavailable      Boolean @default(false)
  unavailableError String?

  createdAt DateTime @default(now())

  @@index([sessionId, position])
}

/// Was tatsaechlich gelaufen ist.
///
/// Bewusst sitzungs- und kanalbezogen, nicht personenbezogen: es soll
/// nachvollziehbar sein, was in einem Kanal lief, nicht wer was hoert.
model MusicPlaybackHistory {
  id        String        @id @default(cuid())
  sessionId String?
  session   MusicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  guildId        String
  voiceChannelId String

  title           String
  artist          String?
  webpageUrl      String
  durationSeconds Int     @default(0)
  thumbnailUrl    String?

  requestedByDiscordUserId String?
  requestedByUsername      String?

  playedAt        DateTime @default(now())
  /// Tatsaechlich gehoerte Dauer - kann unter `durationSeconds` liegen.
  playedSeconds   Int      @default(0)
  skipped         Boolean  @default(false)

  @@index([guildId, playedAt])
  @@index([sessionId])
}

/// Ein Befehl an die Voice-Runtime.
///
/// Es gibt kein Redis im Projekt und keine offene HTTP-Schnittstelle zu den
/// Workern - beides waere neue Infrastruktur beziehungsweise ein offenes Tor.
/// Der Bus laeuft deshalb ueber die Datenbank, die ohnehin beide Seiten
/// verbindet: die WebApp schreibt, der zustaendige Bot holt ab und meldet
/// zurueck. Dadurch gibt es eine echte Rueckmeldung statt der Annahme, ein
/// Klick sei schon angekommen.
model MusicCommand {
  id        String       @id @default(cuid())
  sessionId String
  session   MusicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Wer ausfuehren soll. Ein Worker holt ausschliesslich seine eigenen.
  botInstanceId String

  kind    MusicCommandKind
  /// Zusatzangaben je Befehl (Lautstaerke, Element-ID, Zielposition).
  payload Json               @default("{}")
  status  MusicCommandStatus @default(PENDING)

  requestedByDiscordUserId String?
  /// Woher der Befehl kam - "web" oder "discord". Nur fuer die Fehlersuche.
  origin                   String @default("web")

  claimedAt  DateTime?
  finishedAt DateTime?
  error      String?

  createdAt DateTime @default(now())

  @@index([botInstanceId, status, createdAt])
  @@index([sessionId, createdAt])
}

/// Wer sitzt gerade in welchem Sprachkanal?
///
/// Discord liefert Voice-Zustaende ueber das Gateway, nicht ueber REST - nur
/// der Bot kennt sie. Die WebApp braucht sie aber, um den Player auf den
/// Kanal des Aufrufenden zu richten, statt ihn eine Session aus einer Liste
/// waehlen zu lassen. Der Bot schreibt deshalb mit, was er ohnehin sieht.
///
/// Bewusst nur der aktuelle Zustand und keine Historie: es soll den Player
/// steuern, nicht nachvollziehbar machen, wer wann wo war.
model VoicePresence {
  discordId String @id
  guildId   String

  channelId   String
  channelName String?
  /// Andere Bots zaehlen nicht als Zuhoerer - das entscheidet der Schreiber.
  isBot       Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([guildId, channelId])
}

// ===========================================================================
// SwissHub Tickets
//
// Ein Ticket lebt an zwei Orten gleichzeitig: als Discord-Kanal und als
// Datensatz. Der Kanal ist verletzlich - jemand loescht ihn, Discord ist
// kurz weg, die Kategorie ist voll. Deshalb ist der Datensatz die Wahrheit:
// Verlauf, Nachrichten und Archiv ueberleben es, wenn der Kanal verschwindet.
//
// Umgekehrt gilt: was auf Discord passiert, wird hier mitgeschrieben, statt
// beim Schliessen aus dem Kanal rekonstruiert zu werden. Ein geloeschter
// Kanal duerfte sonst das halbe Archiv mitnehmen.
// ===========================================================================

enum TicketStatus {
  /// Angelegt, aber der Discord-Kanal fehlt noch.
  PENDING
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  WAITING_FOR_STAFF
  RESOLVED
  CLOSED
  ARCHIVED
  /// Die Kanalerstellung ist gescheitert - die Verwaltung kann es erneut
  /// versuchen, statt eine halb angelegte Zeile vorzufinden.
  CREATION_FAILED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Woher die Erstellung kam - fuer die Fehlersuche und die Statistik.
enum TicketSource {
  DISCORD_PANEL
  DISCORD_COMMAND
  WEBAPP
  ADMIN
}

enum TicketMessageSource {
  DISCORD
  WEBAPP
  BOT
  SYSTEM
  /// Interne Notiz - erscheint nie auf Discord und nie im Benutzer-Transcript.
  INTERNAL_NOTE
}

enum TicketEventKind {
  CREATED
  CLAIMED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  TAG_ADDED
  TAG_REMOVED
  USER_ADDED
  USER_REMOVED
  CLOSED
  REOPENED
  ARCHIVED
  CHANNEL_RECREATED
  CHANNEL_MISSING
  ESCALATED
}

/// Wer eine Aktion ausgeloest hat.
enum TicketActorSource {
  WEBAPP
  DISCORD
  SYSTEM
}

enum TicketFormFieldKind {
  SHORT_TEXT
  LONG_TEXT
}

/// Was nach dem Schliessen mit dem Discord-Kanal geschieht.
enum TicketCloseBehaviour {
  DELETE_IMMEDIATELY
  KEEP_24H
  KEEP_7D
  KEEP_FOREVER
}

enum TicketTranscriptAudience {
  /// Ohne interne Notizen.
  USER
  /// Vollstaendig.
  STAFF
}

/// Eine Ticket-Kategorie - Support, Moderation, Bewerbung und so weiter.
///
/// Bewusst vollstaendig ueber das Dashboard verwaltbar: fest verdrahtete
/// Kategorien liessen sich nur mit einer Auslieferung aendern.
model TicketCategory {
  id      String @id @default(cuid())
  guildId String

  name        String
  description String?
  emoji       String?
  /// Farbe des Discord-Embeds, als Ganzzahl wie von Discord erwartet.
  color       Int?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Discord-Kategorie, in der die Kanaele entstehen. Fehlt sie, greift die
  /// Vorgabe aus den Moduleinstellungen.
  discordCategoryId String?
  /// Ausweichkategorie, wenn die erste voll ist - Discord erlaubt 50 Kanaele.
  overflowCategoryId String?

  /// Rollen, die Tickets dieser Kategorie sehen und bearbeiten duerfen.
  supportRoleIds String[] @default([])
  /// Beim Erstellen erwaehnen?
  pingSupport    Boolean  @default(false)

  defaultPriority TicketPriority @default(NORMAL)

  /// Vorlage des Kanalnamens. `{number}`, `{username}` werden ersetzt.
  channelNameTemplate String @default("ticket-{number}-{username}")
  welcomeMessage      String?
  closeMessage        String?

  /// 0 = keine eigene Grenze, dann gilt die globale.
  maxOpenPerUser Int @default(0)

  /// Darf der Ersteller selbst schliessen?
  userCanClose Boolean @default(true)

  /// Erinnerung und automatisches Schliessen, in Tagen. 0 = aus.
  reminderAfterDays  Int @default(0)
  autoCloseAfterDays Int @default(0)

  /// Antwort- und Loesungsziel in Stunden, rein intern. 0 = kein Ziel.
  responseTargetHours   Int @default(0)
  resolutionTargetHours Int @default(0)

  /// Heikle Kategorie - Meldungen, Moderation. Strengere Sichtbarkeit.
  sensitive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets    Ticket[]
  formFields TicketFormField[]
  panels     TicketPanelCategory[]
  templates  TicketTemplate[]

  @@index([guildId, active, sortOrder])
}

/// Ein Feld im Erstellungsformular einer Kategorie.
model TicketFormField {
  id         String         @id @default(cuid())
  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  kind        TicketFormFieldKind @default(SHORT_TEXT)
  label       String
  placeholder String?
  required    Boolean             @default(false)
  minLength   Int?
  maxLength   Int?
  sortOrder   Int                 @default(0)

  createdAt DateTime @default(now())

  @@index([categoryId, sortOrder])
}

/// Ein Ticket-Erstell-Panel in einem Discord-Kanal.
model TicketPanel {
  id      String @id @default(cuid())
  guildId String

  name        String
  title       String
  description String
  bannerUrl   String?
  thumbnailUrl String?
  footerText  String?
  color       Int?

  discordChannelId String
  /// Die gesendete Nachricht. `null`, solange nie veroeffentlicht - oder
  /// wenn sie auf Discord geloescht wurde.
  discordMessageId String?

  buttonLabel String @default("Ticket erstellen")
  buttonEmoji String? @default("🎫")

  active Boolean @default(true)

  /// Wann zuletzt festgestellt wurde, dass die Nachricht fehlt.
  missingSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories TicketPanelCategory[]

  @@unique([discordMessageId])
  @@index([guildId, active])
}

/// Welche Kategorien ein Panel anbietet, in welcher Reihenfolge.
model TicketPanelCategory {
  id         String         @id @default(cuid())
  panelId    String
  panel      TicketPanel    @relation(fields: [panelId], references: [id], onDelete: Cascade)
  categoryId String
  category   TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([panelId, categoryId])
  @@index([panelId, sortOrder])
}

/// Ein Ticket.
model Ticket {
  id      String @id @default(cuid())
  guildId String

  /// Fortlaufend je Guild. Die Eindeutigkeit unten ist der einzige
  /// verlaessliche Schutz gegen zwei gleichzeitige Erstellungen - eine
  /// Zaehlung in der Anwendung verliert dieses Rennen.
  ticketNumber Int

  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  subject String

  status   TicketStatus   @default(PENDING)
  priority TicketPriority @default(NORMAL)
  source   TicketSource   @default(DISCORD_PANEL)

  creatorDiscordId String
  creatorUsername  String

  assignedToDiscordId String?
  assignedToUsername  String?
  assignedAt          DateTime?

  /// Der Discord-Kanal. `null`, wenn er nie entstand oder geloescht wurde -
  /// das Ticket bleibt trotzdem vollstaendig erhalten.
  discordChannelId String?
  /// Die angepinnte Startnachricht mit den Knoepfen.
  discordMessageId String?
  /// Der Kanal fehlt auf Discord. Vom Abgleich gesetzt.
  channelMissing   Boolean @default(false)

  /// Antworten aus dem Erstellungsformular, als Feld-ID zu Antwort.
  formAnswers Json @default("{}")

  /// Zeitpunkte fuer die Kennzahlen. Bewusst hier und nicht errechnet:
  /// spaeter geloeschte Nachrichten wuerden die Rechnung sonst verfaelschen.
  firstStaffResponseAt DateTime?
  lastMessageAt        DateTime?
  /// Wer zuletzt geschrieben hat - danach sortiert die Warteschlange.
  lastMessageByStaff   Boolean?

  closedAt          DateTime?
  closedByDiscordId String?
  closeReason       String?

  reopenedAt DateTime?
  archivedAt DateTime?

  /// Wann der Kanal geloescht werden darf. Vom Aufraeumer gelesen.
  channelPurgeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants TicketParticipant[]
  messages     TicketMessage[]
  events       TicketEvent[]
  tags         TicketTagAssignment[]
  transcripts  TicketTranscript[]
  feedback     TicketFeedback?

  @@unique([guildId, ticketNumber])
  @@unique([discordChannelId])
  @@index([guildId, status, priority])
  @@index([guildId, categoryId, status])
  @@index([creatorDiscordId, createdAt])
  @@index([assignedToDiscordId, status])
  @@index([status, lastMessageAt])
  @@index([guildId, closedAt])
}

/// Wer ausser dem Ersteller Zugriff auf ein Ticket hat.
model TicketParticipant {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  discordId String
  username  String

  addedByDiscordId String?
  addedAt          DateTime  @default(now())
  removedAt        DateTime?

  @@unique([ticketId, discordId])
  @@index([discordId])
}

/// Eine Nachricht im Ticket - aus Discord, aus der WebApp oder vom System.
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  source TicketMessageSource

  /// Die Discord-Nachricht, sofern es eine gibt. Interne Notizen haben keine.
  discordMessageId String?

  authorDiscordId String?
  authorUsername  String?
  authorAvatarHash String?
  /// Hat Support geschrieben? Grundlage der Antwortzeiten und der Sortierung.
  fromStaff       Boolean @default(false)

  content String @db.Text

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  /// Auf Discord geloescht - der Eintrag bleibt, damit der Verlauf stimmt.
  deletedAt DateTime?

  attachments TicketAttachment[]

  @@unique([discordMessageId])
  @@index([ticketId, createdAt])
  @@index([ticketId, source])
}

/// Ein Anhang einer Ticket-Nachricht.
model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName    String
  contentType String?
  sizeBytes   Int      @default(0)
  /// Discord-CDN-Adresse oder der Name im eigenen Speicher.
  url         String   @db.Text
  /// Im eigenen Speicher abgelegt? Discord-Adressen laufen ab.
  stored      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([messageId])
}

/// Ein Schlagwort - reine Ticket-Metadaten, keine Discord-Rolle.
model TicketTag {
  id      String @id @default(cuid())
  guildId String

  name  String
  color String?

  createdAt DateTime @default(now())

  assignments TicketTagAssignment[]

  @@unique([guildId, name])
}

model TicketTagAssignment {
  id       String    @id @default(cuid())
  ticketId String
  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  addedByDiscordId String?
  addedAt          DateTime @default(now())

  @@unique([ticketId, tagId])
  @@index([tagId])
}

/// Was mit einem Ticket geschehen ist.
///
/// Nur den aktuellen Status zu speichern hiesse, den Weg dorthin zu
/// verlieren - und genau der ist es, den Support und Verwaltung brauchen.
model TicketEvent {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  kind   TicketEventKind
  actorDiscordId String?
  actorUsername  String?
  actorSource    TicketActorSource @default(SYSTEM)

  /// Was sich geaendert hat - alter und neuer Wert, Rollenname, und so weiter.
  detail Json @default("{}")

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Ein erzeugtes Transcript.
model TicketTranscript {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  audience TicketTranscriptAudience

  /// Dateiname im Speicher - nicht der Pfad. Der Zugriff laeuft immer ueber
  /// eine autorisierte Route, nie ueber eine offene Adresse.
  fileName    String
  sizeBytes   Int    @default(0)
  messageCount Int   @default(0)

  createdAt DateTime @default(now())

  @@unique([ticketId, audience])
  @@index([ticketId])
}

/// Rueckmeldung nach dem Schliessen.
model TicketFeedback {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// 1 bis 5.
  rating  Int
  comment String?

  givenByDiscordId String
  createdAt        DateTime @default(now())

  @@unique([ticketId])
  @@index([createdAt])
}

/// Wer keine Tickets mehr eroeffnen darf.
model TicketBlockEntry {
  id      String @id @default(cuid())
  guildId String

  discordId String
  username  String?
  reason    String

  blockedByDiscordId String
  createdAt          DateTime  @default(now())
  /// `null` = unbefristet.
  expiresAt          DateTime?
  liftedAt           DateTime?

  @@index([guildId, discordId, liftedAt])
}

/// Antwortvorlagen fuer den Support.
model TicketTemplate {
  id      String @id @default(cuid())
  guildId String

  title   String
  content String @db.Text

  /// Nur fuer diese Kategorie, oder fuer alle wenn leer.
  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, categoryId])
}

/// Der Zaehler fuer die Ticketnummern.
///
/// Eine eigene Zeile je Guild statt `MAX(ticketNumber) + 1`: die Rechnung
/// ueber alle Tickets liefert zwei gleichzeitigen Erstellungen dieselbe
/// Nummer. Ein `UPDATE ... RETURNING` auf diese Zeile nicht.
model TicketCounter {
  guildId String @id
  /// Zuletzt vergebene Nummer.
  lastNumber Int @default(0)

  updatedAt DateTime @updatedAt
}
