// SwissHub Bot WebApp - Datenbankschema
//
// Grundsätze:
//  * Die Datenbank ist Source of Truth für alles, was einen Neustart von Bot
//    oder WebApp überleben muss (Jails, Audit Logs, Einstellungen).
//  * Datensparsamkeit: Discord-Mitgliederdaten werden nur zwischengespeichert,
//    wo sie für Sicherheitsentscheide oder Nachvollziehbarkeit nötig sind.
//  * Alle Zeitstempel werden in UTC gespeichert und erst im UI in Europe/Zurich
//    dargestellt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Grobe Anwendungsgruppe. Sie ist bewusst NICHT die Quelle der Wahrheit für
/// Berechtigungen - massgebend sind Discord-Rollen + Permission Engine.
enum AppRole {
  USER
  TEAM
  MODERATOR
  ADMIN
  OWNER
}

/// Zustand einer Aktion, die Discord und Datenbank umfasst.
enum ActionStatus {
  PENDING
  EXECUTING
  COMPLETED
  PARTIAL
  FAILED
}

/// Zeitlich begrenzt oder unbefristet. Unbefristete Jails haben kein `endsAt`
/// und werden vom automatischen Release-Worker bewusst nicht angefasst.
enum JailType {
  TEMPORARY
  PERMANENT
}

enum VoteJailStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Woher ein Jail stammt. Dashboard und Slash Command nutzen denselben
/// Service - die Quelle ist reine Herkunftsinformation, kein zweiter Weg.
enum JailSource {
  DASHBOARD
  SLASH_COMMAND
  VOTE_JAIL
  IMPORT
  AUTO_RESTORE
}

/// Fachlicher Zustand eines Jails.
///
/// Bewusst getrennt von `ActionStatus`: dort steht, ob die *Discord-Aktion*
/// durchgelaufen ist, hier steht, in welchem Zustand die *Strafe* ist.
/// PENDING_REJOIN bedeutet: Mitglied hat den Server verlassen, die Strafe
/// laeuft weiter und wird beim erneuten Beitritt wieder angewendet.
enum JailLifecycle {
  PENDING
  ACTIVE
  RELEASED
  EXPIRED
  RESTORE_FAILED
  PENDING_REJOIN
  FAILED
}

enum JailImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Entscheidung des Import-Assistenten pro Legacy-Zeile.
enum JailImportRowAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_RELEASED
  SKIP_INVALID
  CONFLICT
}

/// Zustand einer Spielersuche.
enum SpielersucheStatus {
  OPEN
  COMPLETE
  CLOSED
  EXPIRED
}

/// Woher eine Suche stammt. Dashboard und Slash Command durchlaufen denselben
/// Service - die Quelle ist reine Herkunftsinformation.
enum SpielersucheSource {
  DASHBOARD
  SLASH_COMMAND
  LEGACY_IMPORT
}

enum SpielersucheImportStatus {
  ANALYSED
  CONFIRMED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

/// Datenart einer Zeile aus der alten Spielersuche-Datenbank.
enum SpielersucheImportKind {
  SETTINGS
  GAME
  MATCH
  PARTICIPANT
  USAGE
  VOICE_SESSION
  ROLE_PING
}

enum SpielersucheImportAction {
  IMPORT
  SKIP_DUPLICATE
  SKIP_INVALID
  SKIP_OTHER_GUILD
  CONFLICT
}

enum CommunicationType {
  NEWS
  EVENT
  POLL
}

enum JailReleaseType {
  AUTOMATIC
  MANUAL
  RECONCILED
}

enum ModerationActionType {
  JAIL_CREATE
  JAIL_RELEASE
  JAIL_EXTEND
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum ReconciliationMode {
  AUTOMATIC
  MANUAL
}

/// Anwendungskonto, das an eine Discord-Identität gebunden ist.
model User {
  id           String   @id @default(cuid())
  discordId    String   @unique
  username     String
  globalName   String?
  avatarHash   String?
  appRole      AppRole  @default(USER)
  /// Anwendungsseitige Sperre (unabhängig von Discord).
  isBlocked    Boolean  @default(false)
  firstLoginAt DateTime @default(now())
  lastLoginAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  identityCache DiscordIdentityCache?

  @@index([username])
}

/// Serverseitige Session. Im Browser liegt ausschliesslich ein zufälliges
/// Token; gespeichert wird nur dessen SHA-256 Hash.
model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  rotatedAt     DateTime  @default(now())
  /// Absolutes Ablaufdatum - unabhängig von Aktivität.
  expiresAt     DateTime
  /// Ablauf bei Inaktivität; wird bei jedem Request verlängert.
  idleExpiresAt DateTime
  revokedAt     DateTime?
  revokedReason String?
  ipHash        String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

/// Zwischenspeicher für Guild-Mitgliedschaft und Discord-Rollen.
/// Wird nach Ablauf der TTL und vor sicherheitskritischen Aktionen erneuert.
model DiscordIdentityCache {
  discordId     String    @id
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMember      Boolean   @default(false)
  roleIds       String[]  @default([])
  nickname      String?
  joinedGuildAt DateTime?
  fetchedAt     DateTime  @default(now())

  @@index([fetchedAt])
}

/// Discord-Rolle, die von SwissHub verwaltet/bewertet wird.
model ManagedRole {
  id              String   @id @default(cuid())
  discordRoleId   String   @unique
  label           String
  /// Geschützte Rollen können nicht moderiert werden.
  isProtected     Boolean  @default(false)
  /// Rollen, die beim Jail erhalten bleiben (z.B. Booster).
  keepOnJail      Boolean  @default(false)
  /// Interne Moderationsstufe für die Hierarchieprüfung (höher = stärker).
  moderationLevel Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permissions RolePermission[]
}

/// Zuordnung Discord-Rolle -> Permission der Permission Engine.
model RolePermission {
  id            String      @id @default(cuid())
  discordRoleId String
  permission    String
  createdAt     DateTime    @default(now())
  createdBy     String?
  role          ManagedRole @relation(fields: [discordRoleId], references: [discordRoleId], onDelete: Cascade)

  @@unique([discordRoleId, permission])
  @@index([permission])
}

/// Generischer, typisiert gelesener Konfigurationsspeicher.
model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Konfiguration des SwissHub Discord-Servers.
/// Nach dem Setup ist dies - nicht mehr die .env - die Quelle der Wahrheit.
model GuildConfig {
  id               String    @id @default("singleton")
  guildId          String    @unique
  name             String?
  iconHash         String?
  ownerId          String?
  memberCount      Int?
  presenceCount    Int?
  /// Zeitpunkt der letzten erfolgreichen Discord-Synchronisation.
  lastSyncedAt     DateTime?
  /// Gesetzt, sobald der Setup-Assistent abgeschlossen wurde.
  setupCompletedAt DateTime?
  setupCompletedBy String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Zwischenspeicher der Discord-Rollen (fuer Auswahllisten, Hierarchie und
/// Anzeige bei Discord-Ausfall). Wird vom Sync-Service gepflegt.
model DiscordRoleCache {
  roleId      String    @id
  name        String
  color       Int       @default(0)
  position    Int       @default(0)
  managed     Boolean   @default(false)
  hoist       Boolean   @default(false)
  /// Discord Permission Bits als String (BigInt-sicher).
  permissions String    @default("0")
  syncedAt    DateTime  @default(now())
  /// Gesetzt, wenn die Rolle auf Discord nicht mehr existiert.
  deletedAt   DateTime?

  @@index([position])
  @@index([deletedAt])
}

/// Zwischenspeicher der Discord-Channels.
model DiscordChannelCache {
  channelId String    @id
  name      String
  /// Discord Channel Type (0 = Text, 2 = Voice, 4 = Kategorie, 15 = Forum, ...).
  type      Int
  parentId  String?
  position  Int       @default(0)
  nsfw      Boolean   @default(false)
  syncedAt  DateTime  @default(now())
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
}

/// Zaehler, der bei jeder Konfigurationsaenderung erhoeht wird.
/// Bot und WebApp erkennen daran, dass ihre Caches veraltet sind - dadurch
/// wirken Aenderungen ohne Neustart.
model ConfigRevision {
  id        String   @id @default("singleton")
  revision  BigInt   @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
  reason    String?
}

/// Protokoll der Discord-Synchronisationen.
model SyncRun {
  id              String    @id @default(cuid())
  trigger         String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  roles           Int       @default(0)
  channels        Int       @default(0)
  removedRoles    Int       @default(0)
  removedChannels Int       @default(0)
  success         Boolean   @default(true)
  error           String?
  triggeredBy     String?

  @@index([startedAt])
}

/// Aktivierungszustand und Einstellungen eines Moduls.
model ModuleState {
  moduleId      String   @id
  enabled       Boolean  @default(true)
  settings      Json     @default("{}")
  /// Schema-Version der gespeicherten Einstellungen (fuer Migrationen).
  configVersion Int      @default(1)
  updatedAt     DateTime @updatedAt
  updatedBy     String?
}

/// Jail-Vorgang. Die Datenbank ist Source of Truth - der Bot leitet daraus
/// automatische Freilassungen und Reconciliation ab.
model JailEntry {
  id                  String           @id @default(cuid())
  targetDiscordId     String
  targetUsername      String
  targetDisplayName   String?
  /// Avatar-Hashes zum Zeitpunkt der Aktion - halten die Historie lesbar,
  /// auch wenn ein Mitglied den Server spaeter verlaesst.
  targetAvatarHash    String?
  moderatorAvatarHash String?
  moderatorDiscordId  String
  moderatorUsername   String
  reason              String
  /// Art des Jails. Bestehende Einträge wurden bei der Migration als
  /// TEMPORARY übernommen.
  type                JailType         @default(TEMPORARY)
  /// Geplante Dauer. NULL bei einem permanenten Jail.
  durationSeconds     Int?
  startedAt           DateTime         @default(now())
  /// Geplantes Ende. NULL bei einem permanenten Jail - bewusst kein
  /// künstliches Datum wie 31.12.9999, damit Abfragen ehrlich bleiben.
  endsAt              DateTime?
  releasedAt          DateTime?
  releaseType         JailReleaseType?
  releasedByDiscordId String?
  releasedByUsername  String?
  /// Rollen vor dem Jail als flache ID-Liste.
  ///
  /// Bleibt als schneller Lesepfad erhalten (Rollen setzen braucht nur IDs);
  /// die sprechende Fassung mit Name und Position steht in `roleSnapshotEntries`.
  roleSnapshot        String[]         @default([])
  /// Rollen, die während des Jails erhalten blieben.
  keptRoleIds         String[]         @default([])
  /// Beim Release erfolgreich wiederhergestellte Rollen.
  restoredRoleIds     String[]         @default([])
  /// Rollen, die nicht wiederhergestellt werden konnten (gelöscht, zu hoch, ...).
  failedRoleIds       String[]         @default([])
  status              ActionStatus     @default(PENDING)
  releaseStatus       ActionStatus?
  errorCode           String?
  errorMessage        String?
  /// Gesetzt solange der Jail aktiv ist (= targetDiscordId). NULL nach dem
  /// Release. Der Unique-Index verhindert dadurch zwei gleichzeitig aktive
  /// Jails für dasselbe Mitglied (Race Condition Schutz).
  activeKey           String?          @unique
  /// Verhindert doppelte Ausführung bei Doppelklick/Retry.
  idempotencyKey      String?          @unique
  /// Herkunft des Jails - Dashboard, Slash Command, Abstimmung oder Import.
  source              JailSource       @default(DASHBOARD)
  /// Fachlicher Zustand (siehe `JailLifecycle`).
  lifecycle           JailLifecycle    @default(PENDING)
  /// Stille Strafe: keine öffentliche Ankündigung, kein Ping.
  silent              Boolean          @default(false)
  /// Mitglied wurde beim Jail aus dem Sprachkanal getrennt.
  voiceDisconnected   Boolean          @default(false)
  /// Zeitpunkt, an dem das Mitglied den Server während des Jails verlassen hat.
  leftGuildAt         DateTime?
  /// Anzahl erneuter Anwendungen nach einem Rejoin.
  reappliedCount      Int              @default(0)
  /// Legacy-Schlüssel aus dem alten Bot (`userId:startEpoch`) - macht den
  /// Import wiederholbar, ohne Duplikate anzulegen.
  legacyKey           String?          @unique
  importId            String?
  import              JailImport?      @relation(fields: [importId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  /// Vote Jail, aus dem dieser Jail entstanden ist (falls zutreffend).
  voteJail            VoteJail?
  /// Rollen-Snapshot mit Name und Position zum Zeitpunkt des Jails.
  roleSnapshotEntries JailRoleSnapshot[]

  @@index([targetDiscordId, startedAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
  @@index([moderatorDiscordId])
  @@index([lifecycle])
  @@index([source])
  @@index([importId])
}

/// Eine Rolle im Rollen-Snapshot eines Jails.
///
/// Der alte Bot speicherte die Rollen als kommaseparierten Text. Hier steht
/// jede Rolle als eigene Zeile - inklusive Name und Position zum Zeitpunkt des
/// Jails. Dadurch bleibt die Historie auch dann lesbar, wenn eine Rolle
/// zwischenzeitlich umbenannt oder gelöscht wurde.
model JailRoleSnapshot {
  id                 String    @id @default(cuid())
  jailId             String
  jail               JailEntry @relation(fields: [jailId], references: [id], onDelete: Cascade)
  roleId             String
  /// Name zum Zeitpunkt des Jails. NULL, wenn die Rolle damals nicht
  /// aufgelöst werden konnte (z.B. beim Import einer Altdatenbank).
  roleNameAtTime     String?
  rolePositionAtTime Int?
  /// Von Discord verwaltete Rolle (Booster, Integration).
  managedAtTime      Boolean   @default(false)
  /// Rolle blieb während des Jails bewusst erhalten.
  kept               Boolean   @default(false)
  /// Beim Release erfolgreich zurückgegeben.
  restoredAt         DateTime?
  /// Grund, weshalb die Rolle nicht zurückgegeben werden konnte.
  restoreFailedCode  String?
  createdAt          DateTime  @default(now())

  @@unique([jailId, roleId])
  @@index([jailId])
  @@index([roleId])
}

/// Sperrfrist für Initiatoren einer erfolgreichen Abstimmung.
///
/// Eigene Tabelle statt eines Feldes am Mitglied: die Sperre überlebt einen
/// Neustart und lässt sich unabhängig von Discord-Daten aufräumen.
model VoteJailCooldown {
  id             String   @id @default(cuid())
  discordId      String   @unique
  username       String?
  lastVoteJailId String?
  startedAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

/// Ein Durchlauf des Legacy-Imports.
///
/// Die hochgeladene SQLite-Datei wird ausschliesslich gelesen und nach der
/// Analyse gelöscht; hier bleibt nur das Ergebnis stehen.
model JailImport {
  id                   String           @id @default(cuid())
  /// Ursprünglicher Dateiname - nur zur Anzeige, nie als Pfad verwendet.
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               JailImportStatus @default(ANALYSED)
  /// Gefundene Tabellen und Spalten der Legacy-Datei.
  schemaInfo           Json?
  totalRows            Int              @default(0)
  importableRows       Int              @default(0)
  duplicateRows        Int              @default(0)
  releasedRows         Int              @default(0)
  invalidRows          Int              @default(0)
  conflictRows         Int              @default(0)
  importedRows         Int              @default(0)
  failedRows           Int              @default(0)
  /// Bestätigung, dass der alte Bot gestoppt wurde.
  legacyBotStopped     Boolean          @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  finishedAt           DateTime?
  rows                 JailImportRow[]
  jails                JailEntry[]

  @@index([status, createdAt])
}

/// Eine Zeile der Legacy-Datenbank mit der Entscheidung des Assistenten.
model JailImportRow {
  id                 String              @id @default(cuid())
  importId           String
  import             JailImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Stabiler Schlüssel aus der Legacy-Zeile (`userId:startEpoch`).
  legacyKey          String
  targetDiscordId    String
  roleIds            String[]            @default([])
  moderatorDiscordId String?
  reason             String?
  startedAt          DateTime?
  endsAt             DateTime?
  permanent          Boolean             @default(false)
  /// Optionales Geschlechterfeld des alten Bots (nur für die Anrede).
  gender             String?
  legacyStatus       String?
  action             JailImportRowAction
  /// Erklärung für die Auswahl - erscheint in der Vorschau.
  note               String?
  jailId             String?
  imported           Boolean             @default(false)
  createdAt          DateTime            @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, action])
}

/// Community-Abstimmung, die bei Erfolg einen regulären Jail auslöst.
/// Die eigentliche Jail-Ausführung übernimmt der bestehende Jail-Service -
/// hier wird ausschliesslich die Abstimmung verwaltet.
model VoteJail {
  id                   String         @id @default(cuid())
  targetDiscordId      String
  targetUsername       String
  targetDisplayName    String?
  targetAvatarHash     String?
  startedByDiscordId   String
  startedByUsername    String
  startedByAvatarHash  String?
  reason               String?
  status               VoteJailStatus @default(ACTIVE)
  requiredVotes        Int
  /// Zwischenstand, damit Listen ohne Aggregat auskommen. Wird ausschliesslich
  /// innerhalb der Vote-Transaktion fortgeschrieben.
  voteCount            Int            @default(0)
  /// Jail-Dauer in Minuten bei erfolgreicher Abstimmung.
  resultingJailMinutes Int
  discordChannelId     String?
  discordMessageId     String?
  /// Verhindert, dass zwei gleichzeitige Klicks zwei Jails auslösen.
  resultingJailId      String?        @unique
  resultingJail        JailEntry?     @relation(fields: [resultingJailId], references: [id])
  /// Gesetzt solange die Abstimmung läuft (= targetDiscordId). Der
  /// Unique-Index verhindert zwei gleichzeitige Abstimmungen gegen dieselbe
  /// Person.
  activeKey            String?        @unique
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  finishedAt           DateTime?
  votes                VoteJailVote[]

  @@index([status, expiresAt])
  @@index([targetDiscordId, createdAt])
}

/// Einzelne Stimme. Normale Mitglieder haben genau einen Eintrag
/// (Unique-Index), Berechtigte mit `jail.vote.multivote` mehrere - deshalb
/// zählt `voteNumber` mit.
model VoteJailVote {
  id             String   @id @default(cuid())
  voteJailId     String
  voteJail       VoteJail @relation(fields: [voteJailId], references: [id], onDelete: Cascade)
  voterDiscordId String
  voterUsername  String?
  /// Laufende Nummer der Stimme dieses Mitglieds in dieser Abstimmung.
  voteNumber     Int      @default(1)
  isAdminVote    Boolean  @default(false)
  createdAt      DateTime @default(now())

  /// Eine Stimme pro Mitglied und Nummer: normale Mitglieder kommen nie über
  /// Nummer 1 hinaus, Mehrfachstimmen erhalten aufsteigende Nummern.
  @@unique([voteJailId, voterDiscordId, voteNumber])
  @@index([voteJailId])
}

/// Über die WebApp im Namen des Bots gesendete Discord-Nachrichten.
model CommunicationMessage {
  id                 String            @id @default(cuid())
  type               CommunicationType
  title              String
  content            String
  bannerUrl          String?
  discordChannelId   String
  discordChannelName String?
  discordMessageId   String?
  sentByDiscordId    String
  sentByUsername     String
  sentByAvatarHash   String?
  sentAt             DateTime          @default(now())
  /// Auf Discord gelöscht - der Verlaufseintrag bleibt für die Nachvollziehbarkeit.
  deletedAt          DateTime?
  deletedByDiscordId String?
  /// Typspezifische Zusatzdaten (Event-Datum, Verantwortlicher, Mentions, ...).
  metadata           Json              @default("{}")
  /// Verhindert doppeltes Senden bei Doppelklick oder Retry.
  idempotencyKey     String?           @unique

  @@index([sentAt])
  @@index([type, sentAt])
  @@index([discordChannelId])
}

/// Modulunabhängige Moderationshistorie (Basis für Statistiken).
model ModerationAction {
  id              String               @id @default(cuid())
  type            ModerationActionType
  module          String
  actorDiscordId  String
  actorUsername   String
  targetDiscordId String
  targetUsername  String
  reason          String?
  status          ActionStatus         @default(COMPLETED)
  referenceId     String?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())

  @@index([targetDiscordId, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([createdAt])
}

/// Manipulationsgeschütztes Audit Log (Hash-Chain).
model AuditLog {
  id              String   @id @default(cuid())
  sequence        BigInt   @unique @default(autoincrement())
  createdAt       DateTime @default(now())
  action          String
  module          String?
  actorDiscordId  String?
  actorUsername   String?
  targetDiscordId String?
  targetLabel     String?
  success         Boolean  @default(true)
  errorCode       String?
  errorMessage    String?
  metadata        Json     @default("{}")
  ipHash          String?
  userAgent       String?
  /// Hash des vorherigen Eintrags - erlaubt das Erkennen von Manipulationen.
  previousHash    String?
  hash            String

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([actorDiscordId, createdAt])
  @@index([targetDiscordId, createdAt])
  @@index([success, createdAt])
}

/// Sicherheitsrelevante Ereignisse (fehlende Berechtigungen, CSRF, ...).
model SecurityEvent {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  type      String
  severity  SecuritySeverity @default(LOW)
  discordId String?
  ipHash    String?
  userAgent String?
  path      String?
  metadata  Json             @default("{}")

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([discordId, createdAt])
}

/// Serverseitiges Rate Limiting (Fixed Window).
model RateLimitCounter {
  bucket      String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([bucket, windowStart])
  @@index([expiresAt])
}

/// Idempotenzschlüssel für kritische Aktionen.
model IdempotencyRecord {
  key            String       @id
  scope          String
  actorDiscordId String
  status         ActionStatus @default(PENDING)
  resultRef      String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([scope, actorDiscordId])
}

/// Laufzeitstatus des Discord-Bots (vom Bot geschrieben, von der WebApp gelesen).
model BotStatus {
  id               String    @id @default("singleton")
  online           Boolean   @default(false)
  wsPingMs         Int?
  guildMemberCount Int?
  botUserId        String?
  botUsername      String?
  version          String?
  lastHeartbeatAt  DateTime  @default(now())
  lastConnectedAt  DateTime?
  lastError        String?
  updatedAt        DateTime  @updatedAt
}

/// Abgleich zwischen Datenbank- und Discord-Zustand.
model ReconciliationRun {
  id          String             @id @default(cuid())
  module      String
  mode        ReconciliationMode @default(AUTOMATIC)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  checked     Int                @default(0)
  drift       Int                @default(0)
  repaired    Int                @default(0)
  failed      Int                @default(0)
  triggeredBy String?
  details     Json               @default("{}")

  @@index([module, startedAt])
}

/// Ein im Dashboard gepflegtes Spiel.
///
/// Der alte Bot kannte Spiele nur pro Guild; diese Anwendung ist auf genau
/// einen Server konfiguriert, deshalb genuegt der Name als Schluessel.
model SpielersucheGame {
  id            String                 @id @default(cuid())
  name          String
  /// Kleingeschriebener Name - macht die Eindeutigkeit unabhaengig von
  /// Gross-/Kleinschreibung (der alte Bot nutzte dafuer COLLATE NOCASE).
  nameKey       String                 @unique
  /// Rolle, die beim Start einer Suche erwaehnt wird.
  roleId        String
  bannerUrl     String?
  /// Maximale Gruppengroesse. NULL = unbegrenzt.
  maxSquadSize  Int?
  enabled       Boolean                @default(true)
  sortOrder     Int                    @default(0)
  /// `games.id` aus der Altdatenbank - macht den Import wiederholbar.
  legacyId      Int?                   @unique
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdByDiscordId String?
  matches       SpielersucheMatch[]
  rolePing      SpielersucheRolePing?

  @@index([enabled, name])
}

/// Eine Spielersuche.
model SpielersucheMatch {
  id                 String                     @id @default(cuid())
  creatorDiscordId   String
  creatorUsername    String
  creatorDisplayName String?
  creatorAvatarHash  String?
  gameId             String?
  game               SpielersucheGame?          @relation(fields: [gameId], references: [id])
  /// Name zum Zeitpunkt der Suche - bleibt lesbar, auch wenn das Spiel
  /// spaeter umbenannt oder geloescht wird.
  gameName           String
  pingRoleId         String?
  /// Wurde die Spielrolle bei dieser Suche tatsaechlich erwaehnt?
  rolePinged         Boolean                    @default(false)
  bannerUrl          String?
  /// Zusaetzlich gesuchte Spieler. Der Ersteller zaehlt bereits als Teilnehmer.
  requestedPlayers   Int
  comment            String?
  status             SpielersucheStatus         @default(OPEN)
  source             SpielersucheSource         @default(SLASH_COMMAND)
  channelId          String?
  messageId          String?                    @unique
  voiceChannelId     String?
  voiceChannelName   String?
  /// Squad-Groesse des Spiels zum Zeitpunkt der Suche (NULL = unbegrenzt).
  maxSquadSize       Int?
  createdAt          DateTime                   @default(now())
  expiresAt          DateTime
  closedAt           DateTime?
  closedByDiscordId  String?
  closeReason        String?
  /// Gesetzt, solange die Suche laeuft: `<creatorDiscordId>#<Platznummer>`.
  /// Der Unique-Index begrenzt dadurch die Zahl gleichzeitiger Suchen pro
  /// Person auf Datenbankebene - nicht nur im Anwendungscode.
  activeCreatorKey   String?                    @unique
  idempotencyKey     String?                    @unique
  /// `matches.id` aus der Altdatenbank.
  legacyId           Int?                       @unique
  importId           String?
  import             SpielersucheImport?        @relation(fields: [importId], references: [id])
  participants       SpielersucheParticipant[]
  voiceSessions      SpielersucheVoiceSession[]

  @@index([status, expiresAt])
  @@index([creatorDiscordId, createdAt])
  @@index([gameId])
  @@index([voiceChannelId])
  @@index([createdAt])
}

/// Teilnahme an einer Suche.
///
/// Ein Austritt loescht die Zeile nicht, sondern setzt `leftAt`. Dadurch
/// bleibt die Teilnahmehistorie erhalten und der Unique-Index verhindert
/// trotzdem zuverlaessig doppelte Teilnahmen.
model SpielersucheParticipant {
  id          String            @id @default(cuid())
  matchId     String
  match       SpielersucheMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  discordId   String
  username    String?
  displayName String?
  avatarHash  String?
  isCreator   Boolean           @default(false)
  joinedAt    DateTime          @default(now())
  leftAt      DateTime?

  @@unique([matchId, discordId])
  @@index([discordId, joinedAt])
  @@index([matchId, leftAt])
}

/// Letzter Rollen-Ping je Spiel - Grundlage des Ping-Cooldowns.
model SpielersucheRolePing {
  id       String           @id @default(cuid())
  gameId   String           @unique
  game     SpielersucheGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roleId   String
  pingedAt DateTime

  @@index([pingedAt])
}

/// Nutzung der Spielersuche - Grundlage der Statistik und der Rangliste.
model SpielersucheUsage {
  id        String             @id @default(cuid())
  discordId String
  /// Immer `spielersuche`; das Feld bleibt fuer spaetere Befehle offen.
  command   String             @default("spielersuche")
  source    SpielersucheSource @default(SLASH_COMMAND)
  usedAt    DateTime           @default(now())
  legacyId  Int?               @unique

  @@index([discordId, usedAt])
  @@index([usedAt])
}

/// Zeit in einem von der Spielersuche erstellten Sprachkanal.
model SpielersucheVoiceSession {
  id              String             @id @default(cuid())
  discordId       String
  matchId         String?
  match           SpielersucheMatch? @relation(fields: [matchId], references: [id])
  voiceChannelId  String
  joinedAt        DateTime
  leftAt          DateTime?
  durationSeconds Int                @default(0)
  legacyId        Int?               @unique

  @@index([discordId, joinedAt])
  @@index([voiceChannelId, leftAt])
  @@index([matchId])
}

/// Ein Durchlauf der Uebernahme aus `matchmaking.db`.
model SpielersucheImport {
  id                   String                   @id @default(cuid())
  fileName             String
  fileBytes            Int
  fileSha256           String
  status               SpielersucheImportStatus @default(ANALYSED)
  schemaInfo           Json?
  /// Guild, deren Daten uebernommen werden. Die Altdatenbank kann mehrere
  /// Server enthalten (Test- und Produktivserver).
  sourceGuildId        String?
  totalRows            Int                      @default(0)
  importableRows       Int                      @default(0)
  duplicateRows        Int                      @default(0)
  invalidRows          Int                      @default(0)
  otherGuildRows       Int                      @default(0)
  conflictRows         Int                      @default(0)
  importedRows         Int                      @default(0)
  failedRows           Int                      @default(0)
  legacyBotStopped     Boolean                  @default(false)
  reconciledAt         DateTime?
  reconcileSummary     Json?
  uploadedByDiscordId  String
  uploadedByUsername   String
  confirmedByDiscordId String?
  confirmedAt          DateTime?
  errorMessage         String?
  createdAt            DateTime                 @default(now())
  finishedAt           DateTime?
  items                SpielersucheImportItem[]
  matches              SpielersucheMatch[]

  @@index([status, createdAt])
}

/// Eine bewertete Zeile aus der Altdatenbank.
model SpielersucheImportItem {
  id         String                   @id @default(cuid())
  importId   String
  import     SpielersucheImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind       SpielersucheImportKind
  /// Stabiler Schluessel der Legacy-Zeile, z.B. `game:18`.
  legacyKey  String
  label      String
  action     SpielersucheImportAction
  note       String?
  /// Die gelesenen Werte - Grundlage fuer die Uebernahme und die Vorschau.
  payload    Json
  imported   Boolean                  @default(false)
  targetId   String?
  createdAt  DateTime                 @default(now())

  @@unique([importId, legacyKey])
  @@index([importId, kind, action])
}
