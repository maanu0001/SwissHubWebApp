{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Damit Tests die Server-Helfer der WebApp unter demselben Kuerzel
    // ansprechen wie die WebApp selbst. Vitest kennt dieselbe Zuordnung.
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/bot/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
